---
import { AD_CONFIG } from '../config/ads';

interface Props {
  slot: 'leaderboard' | 'rectangle' | 'in-game' | 'footer-banner';
  className?: string;
}

const { slot, className = '' } = Astro.props;
const { enabled, provider, adsenseClientId, refreshIntervalSeconds } = AD_CONFIG;
---

<div
  class={`ad-container relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-brand-border/60 bg-brand-card/40 p-2 text-center text-xs text-gray-400 transition-all hover:border-brand-border ${className}`}
  data-ad-slot={slot}
>
  <div class="absolute top-1 right-2 font-mono text-[9px] tracking-wider text-gray-500 uppercase">Sponsor</div>

  <!-- Leaderboard (728x90 desktop / 320x50 mobile) -->
  {slot === 'leaderboard' && (
    <div class="ad-unit-inner flex h-[90px] w-full max-w-[728px] items-center justify-center rounded-xl border border-dashed border-gray-700/50 bg-brand-dark/50 px-4">
      {enabled && provider === 'adsense' && adsenseClientId ? (
        <ins
          class="adsbygoogle block w-full h-[90px]"
          data-ad-client={adsenseClientId}
          data-ad-slot="1234567890"
          data-ad-format="horizontal"
          data-full-width-responsive="true"
        ></ins>
      ) : (
        <div class="flex flex-col items-center gap-1">
          <span class="font-medium text-gray-300">🎮 High-RPM Ad Space (728x90)</span>
          <span class="text-[11px] text-gray-400">Auto-refreshes every {refreshIntervalSeconds}s for 10x Session Impressions</span>
        </div>
      )}
    </div>
  )}

  <!-- Sidebar Rectangle (300x250) -->
  {slot === 'rectangle' && (
    <div class="ad-unit-inner flex h-[250px] w-full max-w-[300px] items-center justify-center rounded-xl border border-dashed border-gray-700/50 bg-brand-dark/50 p-4">
      {enabled && provider === 'adsense' && adsenseClientId ? (
        <ins
          class="adsbygoogle block w-[300px] h-[250px]"
          data-ad-client={adsenseClientId}
          data-ad-slot="9876543210"
        ></ins>
      ) : (
        <div class="flex flex-col items-center gap-2">
          <div class="rounded-lg bg-brand-accent/20 px-2 py-0.5 text-[10px] font-semibold text-brand-accent">300x250 Display</div>
          <span class="font-medium text-gray-300">Sidebar High-eCPM Unit</span>
          <span class="text-[10px] text-gray-400 leading-relaxed">Monetizes average session duration (&gt;12 min)</span>
        </div>
      )}
    </div>
  )}

  <!-- In-Game / Interstitial Break Container -->
  {slot === 'in-game' && (
    <div class="ad-unit-inner flex h-full min-h-[160px] w-full items-center justify-center rounded-xl border border-dashed border-gray-700/50 bg-brand-dark/80 p-3">
      <div class="flex flex-col items-center gap-1.5">
        <span class="text-sm font-semibold text-brand-gold">⚡ Rewarded / Interstitial Ad Break</span>
        <span class="text-[11px] text-gray-400">Triggers on Level Complete &amp; Game Over</span>
      </div>
    </div>
  )}

  <!-- Footer Banner (970x90) -->
  {slot === 'footer-banner' && (
    <div class="ad-unit-inner flex h-[60px] md:h-[90px] w-full max-w-[970px] items-center justify-center rounded-xl border border-dashed border-gray-700/50 bg-brand-dark/50 px-4">
      <div class="flex items-center gap-3">
        <span class="text-base">💎</span>
        <span class="text-xs text-gray-400 font-mono">Pokoly Network Ad Placement — Maximize Session eCPM</span>
      </div>
    </div>
  )}
</div>

<script>
  import { AD_CONFIG } from '../config/ads';

  // Compliant Viewability-Based Ad Auto-Refresh
  // Only triggers if tab is active and document is visible
  if (AD_CONFIG.enabled && AD_CONFIG.refreshIntervalSeconds > 0) {
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        const adSlots = document.querySelectorAll('.adsbygoogle');
        adSlots.forEach(() => {
          try {
            // @ts-ignore
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        });
      }
    }, AD_CONFIG.refreshIntervalSeconds * 1000);
  }
</script>
