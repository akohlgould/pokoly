---
import { AD_CONFIG } from '../config/ads';

interface Props {
  slot: 'leaderboard' | 'rectangle' | 'in-game' | 'footer-banner';
  className?: string;
}

const { slot, className = '' } = Astro.props;
const { enabled, provider, adsenseClientId, refreshIntervalSeconds } = AD_CONFIG;
---

{enabled && (
  <div
    class={`ad-container relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-brand-border/60 bg-brand-card/40 p-2 text-center text-xs text-gray-400 transition-all hover:border-brand-border ${className}`}
    data-ad-slot={slot}
  >
    <div class="absolute top-1 right-2 font-mono text-[9px] tracking-wider text-gray-500 uppercase">Sponsor</div>

    {slot === 'leaderboard' && (
      <div class="ad-unit-inner flex h-[90px] w-full max-w-[728px] items-center justify-center rounded-xl bg-brand-dark/50 px-4">
        {provider === 'adsense' && adsenseClientId ? (
          <ins
            class="adsbygoogle block w-full h-[90px]"
            data-ad-client={adsenseClientId}
            data-ad-slot="1234567890"
            data-ad-format="horizontal"
            data-full-width-responsive="true"
          ></ins>
        ) : null}
      </div>
    )}

    {slot === 'rectangle' && (
      <div class="ad-unit-inner flex h-[250px] w-full max-w-[300px] items-center justify-center rounded-xl bg-brand-dark/50 p-4">
        {provider === 'adsense' && adsenseClientId ? (
          <ins
            class="adsbygoogle block w-[300px] h-[250px]"
            data-ad-client={adsenseClientId}
            data-ad-slot="9876543210"
          ></ins>
        ) : null}
      </div>
    )}

    {slot === 'in-game' && (
      <div class="ad-unit-inner flex h-full min-h-[160px] w-full items-center justify-center rounded-xl bg-brand-dark/80 p-3">
        {provider === 'adsense' && adsenseClientId ? (
          <ins
            class="adsbygoogle block w-full h-full"
            data-ad-client={adsenseClientId}
            data-ad-slot="5555555555"
          ></ins>
        ) : null}
      </div>
    )}

    {slot === 'footer-banner' && (
      <div class="ad-unit-inner flex h-[60px] md:h-[90px] w-full max-w-[970px] items-center justify-center rounded-xl bg-brand-dark/50 px-4">
        {provider === 'adsense' && adsenseClientId ? (
          <ins
            class="adsbygoogle block w-full h-full"
            data-ad-client={adsenseClientId}
            data-ad-slot="7777777777"
          ></ins>
        ) : null}
      </div>
    )}
  </div>
)}

<script>
  import { AD_CONFIG } from '../config/ads';

  // Compliant Viewability-Based Ad Auto-Refresh
  // Only triggers if tab is active and document is visible
  if (AD_CONFIG.enabled && AD_CONFIG.refreshIntervalSeconds > 0) {
    setInterval(() => {
      if (document.visibilityState === 'visible') {
        const adSlots = document.querySelectorAll('.adsbygoogle');
        adSlots.forEach(() => {
          try {
            // @ts-ignore
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        });
      }
    }, AD_CONFIG.refreshIntervalSeconds * 1000);
  }
</script>
