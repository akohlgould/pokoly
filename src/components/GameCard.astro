---
import type { GameMeta } from '../data/games';

interface Props {
  game: GameMeta;
}

const { game } = Astro.props;
---

<div
  class="group relative flex h-full flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-brand-card/90 to-brand-dark/95 p-3.5 sm:p-4 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:border-brand-neon/60 hover:shadow-[0_12px_40px_-10px_rgba(6,182,212,0.25)]"
  data-game-slug={game.slug}
>
  <!-- Card Header: Badges & Favorite Button -->
  <div class="relative z-10 flex items-center justify-between gap-2">
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="rounded-full bg-white/10 backdrop-blur-md px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-gray-200 border border-white/10">
        {game.category}
      </span>
      {game.badge && (
        <span
          class="rounded-full px-2 py-0.5 text-[9px] font-black uppercase tracking-wide border shadow-sm"
          style={`background: ${game.color}22; color: ${game.color}; border-color: ${game.color}55;`}
        >
          {game.badge}
        </span>
      )}
    </div>

    <button
      class="card-fav-btn flex h-7 w-7 items-center justify-center rounded-full bg-white/5 border border-white/10 text-xs text-gray-400 transition-all hover:scale-115 hover:bg-white/10 hover:text-pink-400 active:scale-90"
      data-slug={game.slug}
      title="Save to favorites"
      aria-label="Save to favorites"
    >
      🤍
    </button>
  </div>

  <!-- Visual Artwork / Logo Banner -->
  <a
    href={`/games/${game.slug}/`}
    class="relative my-3 flex h-36 sm:h-40 w-full items-center justify-center overflow-hidden rounded-2xl p-4 transition-all duration-500 group-hover:scale-[1.02]"
    style={`background: radial-gradient(circle at center, ${game.color}25 0%, #0d111d 85%);`}
    aria-label={`Play ${game.title} online`}
  >
    <!-- Ambient Radial Aura -->
    <div
      class="absolute inset-0 opacity-30 blur-2xl transition-opacity duration-300 group-hover:opacity-70 pointer-events-none"
      style={`background: radial-gradient(circle at center, ${game.color} 0%, transparent 70%);`}
    ></div>

    <!-- Tech/Arcade Subtle Grid Pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none"></div>

    <!-- Logo with Floating Drop Shadow -->
    <img
      src={`/logos/${game.slug}.svg`}
      alt={`${game.title} - Free Online Browser Game Icon`}
      class="relative z-10 h-24 w-24 sm:h-28 sm:w-28 object-contain drop-shadow-[0_10px_20px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover:scale-110"
      loading="lazy"
    />

    <!-- Hover Overlay Play Button -->
    <div class="absolute inset-0 z-20 flex items-center justify-center bg-brand-dark/60 backdrop-blur-[2px] opacity-0 transition-all duration-300 group-hover:opacity-100">
      <div class="flex items-center gap-2 rounded-2xl bg-gradient-to-r from-brand-neon to-brand-accent px-4 py-2 font-display text-xs font-black text-white shadow-xl shadow-cyan-500/30 transform scale-90 group-hover:scale-100 transition-transform">
        <span>PLAY</span>
        <span class="text-sm">▶</span>
      </div>
    </div>

    <!-- 60 FPS Badge -->
    <div class="absolute bottom-2 left-2 z-10 flex items-center gap-1 rounded-md bg-black/60 backdrop-blur-md px-1.5 py-0.5 font-mono text-[9px] font-semibold text-emerald-400 border border-emerald-500/30">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>60 FPS</span>
    </div>
  </a>

  <!-- Content & Metadata -->
  <div class="flex-1 flex flex-col justify-between">
    <div>
      <a href={`/games/${game.slug}/`} class="block">
        <h3 class="font-display text-base font-bold text-white transition-colors duration-200 group-hover:text-brand-neon">
          {game.title}
        </h3>
      </a>
      <p class="mt-1 line-clamp-2 text-xs text-gray-400 leading-relaxed">
        {game.tagline}
      </p>
    </div>

    <!-- Card Footer: Rating, Plays & Direct Launch -->
    <div class="mt-3.5 flex items-center justify-between border-t border-white/5 pt-3 text-[11px]">
      <div class="flex items-center gap-2.5">
        <div class="flex items-center gap-1 text-amber-400 font-semibold">
          <span>★</span>
          <span class="text-gray-200">{game.rating.toFixed(1)}</span>
        </div>
        <div class="font-mono text-gray-400 text-[10px]">
          {game.playCount}
        </div>
      </div>

      <a
        href={`/games/${game.slug}/`}
        aria-label={`Play ${game.title} free online`}
        class="inline-flex items-center gap-1 rounded-xl bg-white/5 px-2.5 py-1 font-display text-xs font-bold text-gray-200 border border-white/10 transition-all duration-200 hover:bg-brand-neon hover:text-brand-dark hover:border-brand-neon hover:shadow-lg hover:shadow-brand-neon/25"
      >
        <span>Play</span>
        <span class="text-[10px]">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  import { player } from '../utils/player';
  import { sound } from '../utils/audio';

  document.querySelectorAll('.card-fav-btn').forEach(btn => {
    const slug = btn.getAttribute('data-slug');
    if (!slug) return;

    if (player.isFavorite(slug)) {
      btn.textContent = '❤️';
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isFav = player.toggleFavorite(slug);
      btn.textContent = isFav ? '❤️' : '🤍';
      sound.blip();
    });
  });
</script>
