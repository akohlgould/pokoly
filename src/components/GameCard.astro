---
import type { GameMeta } from '../data/games';
import fs from 'fs';
import path from 'path';

interface Props {
  game: GameMeta;
}

const { game } = Astro.props;

// Check if screenshot exists in public/screenshots/
const screenshotRelative = `public/screenshots/${game.slug}.webp`;
const hasScreenshot = fs.existsSync(path.resolve(screenshotRelative));
const screenshotUrl = `/screenshots/${game.slug}.webp`;
---

<div
  class="group relative flex h-full flex-col justify-between rounded-lg border border-zinc-800 bg-[#0d0f17] p-3 transition-colors duration-150 hover:border-zinc-600 hover:bg-[#111420]"
  data-game-slug={game.slug}
>
  <!-- Card Header: Badges & Favorite Button -->
  <div class="relative z-10 flex items-center justify-between gap-2">
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="rounded border border-zinc-800 bg-zinc-900 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-zinc-400">
        {game.category}
      </span>
      {game.badge && (
        <span
          class="rounded border border-zinc-700/60 bg-zinc-900 px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wider text-zinc-300"
        >
          {game.badge}
        </span>
      )}
    </div>

    <button
      class="card-fav-btn flex h-6 w-6 items-center justify-center rounded border border-zinc-800 bg-zinc-900 text-[11px] text-zinc-400 transition-colors hover:border-zinc-600 hover:text-zinc-200 active:scale-95 cursor-pointer"
      data-slug={game.slug}
      title="Save to favorites"
      aria-label="Save to favorites"
    >
      🤍
    </button>
  </div>

  <!-- Visual Artwork: Real Gameplay Screenshot with Logo Corner Badge -->
  <a
    href={`/games/${game.slug}/`}
    class="relative my-2.5 flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded border border-zinc-800 bg-black"
    aria-label={`Play ${game.title} online`}
  >
    {hasScreenshot ? (
      <>
        <img
          src={screenshotUrl}
          alt={`${game.title} Gameplay Screenshot`}
          class="h-full w-full object-cover object-center"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>

        <div class="absolute top-1.5 left-1.5 z-10 flex items-center rounded border border-zinc-800 bg-black/90 p-1">
          <img
            src={`/logos/${game.slug}.svg`}
            alt=""
            class="h-4 w-4 object-contain"
            loading="lazy"
          />
        </div>
      </>
    ) : (
      <div
        class="absolute inset-0 flex items-center justify-center p-4 bg-zinc-950"
      >
        <img
          src={`/logos/${game.slug}.svg`}
          alt=""
          class="relative z-10 h-16 w-16 object-contain"
          loading="lazy"
        />
      </div>
    )}

    <!-- Hover Overlay Play Action -->
    <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/65 opacity-0 transition-opacity duration-150 group-hover:opacity-100">
      <div class="flex items-center gap-1.5 rounded border border-zinc-500 bg-zinc-900 px-3 py-1 font-mono text-xs font-semibold text-zinc-100">
        <span>LAUNCH</span>
        <span class="text-[10px]">▶</span>
      </div>
    </div>

    <!-- 60 FPS Engine Indicator -->
    <div class="absolute bottom-1.5 left-1.5 z-10 flex items-center gap-1 rounded border border-zinc-800 bg-black/90 px-1.5 py-0.5 font-mono text-[9px] text-zinc-300">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
      <span>60 FPS</span>
    </div>
  </a>

  <!-- Content & Metadata -->
  <div class="flex-1 flex flex-col justify-between">
    <div>
      <a href={`/games/${game.slug}/`} class="block">
        <h3 class="font-sans text-sm font-semibold text-zinc-100 transition-colors group-hover:text-white truncate">
          {game.title}
        </h3>
      </a>
      <p class="mt-1 line-clamp-2 text-xs text-zinc-400 leading-relaxed">
        {game.tagline}
      </p>
    </div>

    <!-- Card Footer: Rating, Plays & Direct Launch -->
    <div class="mt-3 flex items-center justify-between border-t border-zinc-800/80 pt-2.5 text-[11px]">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1 font-mono text-[10px] text-zinc-300">
          <span class="text-amber-400">★</span>
          <span>{game.rating.toFixed(1)}</span>
        </div>
        <span class="text-zinc-600">•</span>
        <div class="font-mono text-zinc-500 text-[10px]">
          {game.playCount}
        </div>
      </div>

      <a
        href={`/games/${game.slug}/`}
        aria-label={`Play ${game.title} free online`}
        class="inline-flex items-center gap-1 rounded border border-zinc-700 bg-zinc-800/80 px-2 py-0.5 font-mono text-[11px] font-medium text-zinc-200 transition-colors hover:border-zinc-500 hover:bg-zinc-700 hover:text-white"
      >
        <span>Play</span>
        <span class="text-[10px]">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  import { player } from '../utils/player';
  import { sound } from '../utils/audio';

  document.querySelectorAll('.card-fav-btn').forEach(btn => {
    const slug = btn.getAttribute('data-slug');
    if (!slug) return;

    if (player.isFavorite(slug)) {
      btn.textContent = '❤️';
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isFav = player.toggleFavorite(slug);
      btn.textContent = isFav ? '❤️' : '🤍';
      sound.blip();
    });
  });
</script>