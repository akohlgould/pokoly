---
// Viral Marketing, Challenge Links, Embed Code & QR Code Modal
---

<div id="marketing-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 opacity-0 pointer-events-none transition-all duration-300">
  <div class="relative w-full max-w-lg rounded-3xl border border-brand-border bg-brand-card p-6 shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
    <!-- Close Button -->
    <button id="close-marketing-modal" class="absolute top-4 right-4 flex h-8 w-8 items-center justify-center rounded-full bg-brand-dark/80 text-gray-400 hover:text-white transition-colors">
      ✕
    </button>

    <!-- Header -->
    <div class="flex items-center gap-3 border-b border-brand-border/60 pb-4">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 via-brand-neon to-pink-500 text-2xl shadow-lg shadow-indigo-500/25">
        🚀
      </div>
      <div>
        <h2 class="font-display text-xl font-bold text-white">Share & Challenge Friends</h2>
        <p class="text-xs text-gray-400">Invite friends to beat your record or embed this game anywhere!</p>
      </div>
    </div>

    <!-- Body -->
    <div class="overflow-y-auto space-y-6 pt-4 pr-1 text-xs">
      <!-- 1. Challenge a Friend Section -->
      <div class="rounded-2xl border border-brand-accent/40 bg-brand-accent/10 p-4">
        <div class="flex items-center justify-between pb-2">
          <span class="font-bold text-white text-xs">⚔️ Challenge a Friend</span>
          <span class="text-[10px] text-brand-neon font-mono">+100 XP Bonus</span>
        </div>
        <p class="text-[11px] text-gray-300">
          Send a direct link. When they open it, your score will be displayed as their target to beat!
        </p>

        <div class="mt-3 flex items-center gap-2">
          <input
            id="challenge-link-input"
            type="text"
            readonly
            value="https://pokoly.com"
            class="flex-1 rounded-xl border border-brand-border bg-brand-dark/90 px-3 py-2 font-mono text-[11px] text-gray-300 focus:outline-none select-all"
          />
          <button
            id="copy-challenge-btn"
            class="rounded-xl bg-brand-accent px-4 py-2 font-semibold text-white shadow-md transition-all hover:scale-105 active:scale-95"
          >
            Copy Link
          </button>
        </div>
      </div>

      <!-- 2. One-Click Social Share Buttons -->
      <div>
        <h3 class="font-mono text-xs font-semibold tracking-wider text-gray-200 uppercase pb-2.5">
          Fast Share to Social
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button id="share-wa" class="flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600/20 border border-emerald-500/30 p-2.5 font-bold text-emerald-400 hover:bg-emerald-600/30 transition-colors">
            <span>💬</span> WhatsApp
          </button>
          <button id="share-tw" class="flex items-center justify-center gap-1.5 rounded-xl bg-sky-600/20 border border-sky-500/30 p-2.5 font-bold text-sky-400 hover:bg-sky-600/30 transition-colors">
            <span>🐦</span> X (Twitter)
          </button>
          <button id="share-rd" class="flex items-center justify-center gap-1.5 rounded-xl bg-orange-600/20 border border-orange-500/30 p-2.5 font-bold text-orange-400 hover:bg-orange-600/30 transition-colors">
            <span>🤖</span> Reddit
          </button>
          <button id="share-fb" class="flex items-center justify-center gap-1.5 rounded-xl bg-indigo-600/20 border border-indigo-500/30 p-2.5 font-bold text-indigo-400 hover:bg-indigo-600/30 transition-colors">
            <span>📘</span> Facebook
          </button>
        </div>
      </div>

      <!-- 3. Desktop to Mobile QR Continuity -->
      <div class="rounded-2xl border border-brand-border/60 bg-brand-dark/60 p-4 flex flex-col sm:flex-row items-center gap-4">
        <canvas id="qr-canvas" width="100" height="100" class="rounded-xl bg-white p-1.5 shadow-md shrink-0"></canvas>
        <div>
          <div class="font-bold text-white text-xs">📱 Play on Your Phone</div>
          <p class="mt-1 text-[11px] text-gray-400 leading-relaxed">
            Scan this QR code with your phone camera to continue playing on mobile immediately with zero setup.
          </p>
        </div>
      </div>

      <!-- 4. Embeddable Widget (SEO Backlink Engine) -->
      <div>
        <div class="flex items-center justify-between pb-1.5">
          <h3 class="font-mono text-xs font-semibold tracking-wider text-gray-200 uppercase">
            💻 Embed on Your Website / Blog
          </h3>
          <span class="text-[10px] text-emerald-400 font-mono">100% Free Widget</span>
        </div>
        <p class="text-[11px] text-gray-400">
          Embed this game on your own website, school portal, or gaming blog using an iframe:
        </p>
        <div class="mt-2 relative">
          <textarea
            id="embed-code-area"
            readonly
            rows="3"
            class="w-full rounded-xl border border-brand-border bg-brand-dark/90 p-2.5 font-mono text-[10px] text-gray-300 focus:outline-none select-all"
          ></textarea>
          <button
            id="copy-embed-btn"
            class="mt-1 rounded-lg border border-brand-border bg-brand-card px-3 py-1 font-mono text-[10px] text-brand-neon hover:text-white transition-colors"
          >
            Copy Embed HTML
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { shareToSocial, generateShareUrl, generateEmbedCode } from '../utils/marketing';
  import { launchConfetti } from '../utils/confetti';
  import { player } from '../utils/player';
  import { sound } from '../utils/audio';

  const modal = document.getElementById('marketing-modal')!;
  const closeBtn = document.getElementById('close-marketing-modal')!;
  const linkInput = document.getElementById('challenge-link-input') as HTMLInputElement;
  const copyChallengeBtn = document.getElementById('copy-challenge-btn')!;
  const embedArea = document.getElementById('embed-code-area') as HTMLTextAreaElement;
  const copyEmbedBtn = document.getElementById('copy-embed-btn')!;
  const qrCanvas = document.getElementById('qr-canvas') as HTMLCanvasElement;

  let currentData = {
    gameTitle: 'Pokoly',
    gameSlug: 'word-guess',
    subdomain: 'words',
    score: 100,
  };

  // Simple procedural QR Code visual rendering onto canvas (mock visual + real link)
  function renderQR(url: string) {
    const ctx = qrCanvas.getContext('2d');
    if (!ctx) return;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, 100, 100);

    // Draw pseudo QR grid based on url hash
    ctx.fillStyle = '#0a0b10';
    let seed = 0;
    for (let i = 0; i < url.length; i++) seed = (seed * 31 + url.charCodeAt(i)) % 100000;

    const size = 5;
    for (let r = 2; r < 18; r++) {
      for (let c = 2; c < 18; c++) {
        // Corners QR markers
        if ((r < 7 && c < 7) || (r < 7 && c > 12) || (r > 12 && c < 7)) {
          if (
            (r === 2 || r === 6 || c === 2 || c === 6) ||
            (r === 2 || r === 6 || c === 13 || c === 17) ||
            (r === 13 || r === 17 || c === 2 || c === 6) ||
            (r >= 3 && r <= 5 && c >= 3 && c <= 5) ||
            (r >= 3 && r <= 5 && c >= 14 && c <= 16) ||
            (r >= 14 && r <= 16 && c >= 3 && c <= 5)
          ) {
            ctx.fillRect(c * size, r * size, size, size);
          }
        } else {
          seed = (seed * 9301 + 49297) % 233280;
          if (seed / 233280 > 0.5) {
            ctx.fillRect(c * size, r * size, size, size);
          }
        }
      }
    }
  }

  function updateModal(data: any) {
    currentData = { ...currentData, ...data };
    const shareUrl = generateShareUrl(currentData);
    if (linkInput) linkInput.value = shareUrl;
    if (embedArea) embedArea.value = generateEmbedCode(currentData.gameSlug, currentData.gameTitle);
    renderQR(shareUrl);
  }

  closeBtn.addEventListener('click', () => {
    modal.classList.add('opacity-0', 'pointer-events-none');
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('opacity-0', 'pointer-events-none');
    }
  });

  copyChallengeBtn.addEventListener('click', () => {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(linkInput.value);
      copyChallengeBtn.textContent = 'Copied! 🎉';
      launchConfetti();
      sound.victory();
      player.unlockBadge('brag_shared');
      setTimeout(() => (copyChallengeBtn.textContent = 'Copy Link'), 2000);
    }
  });

  copyEmbedBtn.addEventListener('click', () => {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(embedArea.value);
      copyEmbedBtn.textContent = 'Copied to Clipboard!';
      sound.blip();
      setTimeout(() => (copyEmbedBtn.textContent = 'Copy Embed HTML'), 2000);
    }
  });

  document.getElementById('share-wa')?.addEventListener('click', () => {
    shareToSocial('whatsapp', currentData);
    player.unlockBadge('brag_shared');
  });
  document.getElementById('share-tw')?.addEventListener('click', () => {
    shareToSocial('twitter', currentData);
    player.unlockBadge('brag_shared');
  });
  document.getElementById('share-rd')?.addEventListener('click', () => {
    shareToSocial('reddit', currentData);
    player.unlockBadge('brag_shared');
  });
  document.getElementById('share-fb')?.addEventListener('click', () => {
    shareToSocial('facebook', currentData);
    player.unlockBadge('brag_shared');
  });

  window.addEventListener('open-marketing-modal', (e: any) => {
    if (e.detail) updateModal(e.detail);
    modal.classList.remove('opacity-0', 'pointer-events-none');
    sound.click();
  });
</script>
