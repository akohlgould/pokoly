---
import { CATEGORIES } from '../data/games';
import PlayerBar from './PlayerBar.astro';
---

<header class="sticky top-0 z-40 border-b border-zinc-800 bg-[#090a0f]">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2 sm:px-6">
    <div class="flex items-center gap-5">
      <a href="/" class="group flex items-center gap-2" aria-label="Pokoly Home">
        <img
          src="/logos/pokoly-icon.svg"
          alt="Pokoly Logo"
          class="h-7 w-7 rounded border border-zinc-800"
          width="28"
          height="28"
        />
        <div class="flex items-baseline gap-1.5">
          <span class="font-sans text-sm font-bold tracking-tight text-white group-hover:text-zinc-300 transition-colors">
            Pokoly
          </span>
          <span class="font-mono text-[9px] tracking-wider text-zinc-500 uppercase">Arcade</span>
        </div>
      </a>

      <!-- Desktop Nav categories -->
      <nav class="hidden lg:flex items-center gap-1">
        {CATEGORIES.slice(1).map(cat => (
          <a
            href={`/categories/${cat.id}/`}
            class="flex items-center gap-1 rounded border border-transparent px-2 py-1 font-mono text-[11px] text-zinc-400 transition-colors hover:border-zinc-800 hover:bg-zinc-900/60 hover:text-zinc-200"
          >
            <span>{cat.name}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- Center/Right: Gamification Streak + Level + Sound + Random -->
    <div class="flex items-center gap-2">
      <!-- Player Streak & Level Progress -->
      <PlayerBar />

      <!-- Random Game Quick Button -->
      <button
        id="random-game-btn"
        class="hidden sm:inline-flex items-center gap-1 rounded border border-zinc-800 bg-[#0d0f17] px-2 py-1 font-mono text-[11px] text-zinc-300 transition-colors hover:border-zinc-700 hover:text-white cursor-pointer"
        title="Play a surprise random game"
      >
        <span>🎲 Random</span>
      </button>

      <!-- Sound Toggle -->
      <button
        id="global-audio-toggle"
        title="Toggle Sound Effects"
        class="flex h-7 w-7 items-center justify-center rounded border border-zinc-800 bg-[#0d0f17] text-xs text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200 cursor-pointer"
      >
        <span id="audio-icon">🔊</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { sound } from '../utils/audio';
  import { GAMES } from '../data/games';

  const audioBtn = document.getElementById('global-audio-toggle');
  const audioIcon = document.getElementById('audio-icon');

  if (audioBtn && audioIcon) {
    audioBtn.addEventListener('click', () => {
      sound.enabled = !sound.enabled;
      audioIcon.textContent = sound.enabled ? '🔊' : '🔇';
      if (sound.enabled) {
        sound.click();
      }
    });
  }

  const randomBtn = document.getElementById('random-game-btn');
  if (randomBtn) {
    randomBtn.addEventListener('click', () => {
      const chosen = GAMES[Math.floor(Math.random() * GAMES.length)];
      if (chosen) {
        window.location.href = `/games/${chosen.slug}/`;
      }
    });
  }
</script>