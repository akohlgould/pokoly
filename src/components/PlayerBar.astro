---
// Player Profile Bar: High-contrast, minimal streak & level status
---

<div class="flex items-center gap-1.5">
  <!-- Daily Streak Badge -->
  <button
    id="nav-streak-btn"
    class="flex items-center gap-1 rounded border border-zinc-800 bg-[#0d0f17] px-2 py-1 font-mono text-[11px] text-amber-400 transition-colors hover:border-zinc-700 cursor-pointer"
    title="Daily Streak"
  >
    <span>🔥</span>
    <span id="nav-streak-text">1d</span>
  </button>

  <!-- Quests & Level Pill -->
  <button
    id="nav-quests-btn"
    class="flex items-center gap-1.5 rounded border border-zinc-800 bg-[#0d0f17] px-2 py-1 font-mono text-[11px] text-zinc-300 transition-colors hover:border-zinc-700 hover:text-white cursor-pointer"
    title="Quests & Achievements"
  >
    <span>🏆</span>
    <span id="nav-level-badge" class="font-bold text-zinc-200">L1</span>
  </button>
</div>

<script>
  import { player } from '../utils/player';

  const streakText = document.getElementById('nav-streak-text');
  const levelBadge = document.getElementById('nav-level-badge');

  function updateNav() {
    const profile = player.getProfile();
    if (streakText) streakText.textContent = `${profile.streak}d`;
    if (levelBadge) levelBadge.textContent = `L${profile.level}`;
  }

  document.getElementById('nav-streak-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  document.getElementById('nav-quests-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  player.subscribe(updateNav);
  updateNav();
</script>