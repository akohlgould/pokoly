---
// Player Profile Bar: Clean, minimal streak & trophies trigger
---

<div class="flex items-center gap-1.5 text-xs">
  <!-- Daily Streak Badge -->
  <button
    id="nav-streak-btn"
    class="flex items-center gap-1 rounded-xl border border-amber-500/25 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-300 transition-all hover:bg-amber-500/20 active:scale-95 cursor-pointer"
    title="Daily Streak"
  >
    <span>🔥</span>
    <span id="nav-streak-text" class="font-mono text-[11px]">1d</span>
  </button>

  <!-- Quests & Level Pill -->
  <button
    id="nav-quests-btn"
    class="flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-gray-300 transition-all hover:border-brand-neon/60 hover:text-white active:scale-95 cursor-pointer"
    title="Quests & Achievements"
  >
    <span>🏆</span>
    <span id="nav-level-badge" class="font-mono text-[11px] text-brand-neon font-bold">L1</span>
  </button>
</div>

<script>
  import { player } from '../utils/player';

  const streakText = document.getElementById('nav-streak-text');
  const levelBadge = document.getElementById('nav-level-badge');

  function updateNav() {
    const profile = player.getProfile();
    if (streakText) streakText.textContent = `${profile.streak}d`;
    if (levelBadge) levelBadge.textContent = `L${profile.level}`;
  }

  document.getElementById('nav-streak-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  document.getElementById('nav-quests-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  player.subscribe(updateNav);
  updateNav();
</script>
