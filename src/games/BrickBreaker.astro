---
// Neon Brick Breaker (Breakout)
---

<div id="breakout-app" class="flex flex-col items-center justify-center p-3 select-none">
  <!-- Stats Header -->
  <div class="mb-3 flex w-full max-w-[380px] items-center justify-between rounded-xl border border-brand-border/60 bg-brand-dark/95 px-4 py-2 text-xs">
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Score:</span>
      <span id="bb-score" class="font-mono text-base font-bold text-brand-neon">0</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Level:</span>
      <span id="bb-level" class="font-mono text-base font-bold text-amber-400">1</span>
    </div>
    <div class="flex items-center gap-1">
      <span class="text-gray-400">Lives:</span>
      <span id="bb-lives" class="text-sm">❤️❤️❤️</span>
    </div>
  </div>

  <!-- Game Canvas -->
  <div class="relative overflow-hidden rounded-2xl border-2 border-brand-border bg-brand-dark shadow-2xl">
    <canvas id="bb-canvas" width="380" height="460" class="block cursor-none touch-none"></canvas>

    <!-- Overlay -->
    <div id="bb-overlay" class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-brand-dark/90 backdrop-blur-sm p-6 text-center opacity-0 pointer-events-none transition-opacity">
      <span class="text-4xl" id="bb-overlay-icon">💀</span>
      <h3 id="bb-overlay-title" class="font-display text-2xl font-bold text-white mt-1">Game Over</h3>
      <p class="mt-1 text-xs text-gray-300">Final Score: <span id="bb-final-score" class="font-mono font-bold text-brand-gold">0</span></p>
      <button id="bb-restart-btn" class="mt-4 rounded-xl bg-brand-accent px-6 py-2 text-xs font-bold text-white shadow-lg hover:scale-105 active:scale-95 transition-transform">
        Play Again
      </button>
    </div>
  </div>

  <div class="mt-2 text-[11px] text-gray-400">
    Move mouse / touch horizontally to steer paddle
  </div>
</div>

<script>
  import { sound } from '../utils/audio';

  const canvas = document.getElementById('bb-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = document.getElementById('bb-score')!;
  const levelEl = document.getElementById('bb-level')!;
  const livesEl = document.getElementById('bb-lives')!;
  const overlay = document.getElementById('bb-overlay')!;
  const overlayTitle = document.getElementById('bb-overlay-title')!;
  const overlayIcon = document.getElementById('bb-overlay-icon')!;
  const finalScoreEl = document.getElementById('bb-final-score')!;
  const restartBtn = document.getElementById('bb-restart-btn')!;

  const width = canvas.width;
  const height = canvas.height;

  interface Brick {
    x: number;
    y: number;
    w: number;
    h: number;
    color: string;
    hp: number;
    points: number;
  }

  let paddleWidth = 80;
  const paddleHeight = 12;
  let paddleX = (width - paddleWidth) / 2;

  let ballX = width / 2;
  let ballY = height - 40;
  let ballRadius = 6;
  let ballSpeed = 5;
  let ballDx = 3.5;
  let ballDy = -3.5;
  let ballInPlay = false;

  let bricks: Brick[] = [];
  let score = 0;
  let level = 1;
  let lives = 3;
  let isGameOver = false;

  const ROW_COLORS = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#06b6d4', '#8b5cf6'];

  function buildLevel() {
    bricks = [];
    const rows = 5 + Math.min(2, level);
    const cols = 7;
    const brickW = (width - 40) / cols;
    const brickH = 16;

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        bricks.push({
          x: 20 + c * brickW,
          y: 40 + r * (brickH + 6),
          w: brickW - 4,
          h: brickH,
          color: ROW_COLORS[r % ROW_COLORS.length],
          hp: r === 0 && level > 1 ? 2 : 1,
          points: (rows - r) * 10
        });
      }
    }
  }

  function resetBall() {
    ballX = paddleX + paddleWidth / 2;
    ballY = height - 30;
    ballDx = (Math.random() > 0.5 ? 1 : -1) * 3.5;
    ballDy = -3.5;
    ballInPlay = false;
  }

  function update() {
    if (isGameOver) return;

    if (!ballInPlay) {
      ballX = paddleX + paddleWidth / 2;
      ballY = height - 25;
      return;
    }

    ballX += ballDx;
    ballY += ballDy;

    // Wall bounce
    if (ballX - ballRadius < 0) {
      ballX = ballRadius;
      ballDx = -ballDx;
      sound.blip();
    } else if (ballX + ballRadius > width) {
      ballX = width - ballRadius;
      ballDx = -ballDx;
      sound.blip();
    }

    // Ceiling bounce
    if (ballY - ballRadius < 0) {
      ballY = ballRadius;
      ballDy = -ballDy;
      sound.blip();
    }

    // Paddle collision
    if (
      ballY + ballRadius >= height - 20 &&
      ballY - ballRadius <= height - 8 &&
      ballX >= paddleX &&
      ballX <= paddleX + paddleWidth
    ) {
      // Calculate bounce angle based on where it hit the paddle
      const hitPoint = (ballX - (paddleX + paddleWidth / 2)) / (paddleWidth / 2);
      const maxAngle = Math.PI / 3; // 60 deg
      const angle = hitPoint * maxAngle;
      const speed = Math.sqrt(ballDx * ballDx + ballDy * ballDy);

      ballDx = speed * Math.sin(angle);
      ballDy = -speed * Math.cos(angle);
      ballY = height - 21;
      sound.score();
    }

    // Bottom out
    if (ballY - ballRadius > height) {
      lives--;
      livesEl.textContent = '❤️'.repeat(lives);
      sound.explosion();
      if (lives <= 0) {
        handleGameOver(false);
      } else {
        resetBall();
      }
      return;
    }

    // Brick collisions
    for (let i = bricks.length - 1; i >= 0; i--) {
      const b = bricks[i];
      if (
        ballX + ballRadius > b.x &&
        ballX - ballRadius < b.x + b.w &&
        ballY + ballRadius > b.y &&
        ballY - ballRadius < b.y + b.h
      ) {
        ballDy = -ballDy;
        b.hp--;
        sound.blip();

        if (b.hp <= 0) {
          score += b.points;
          scoreEl.textContent = score.toString();
          bricks.splice(i, 1);
        }

        // Level clear check
        if (bricks.length === 0) {
          sound.victory();
          level++;
          levelEl.textContent = level.toString();
          buildLevel();
          resetBall();
        }
        break;
      }
    }
  }

  function draw() {
    ctx.fillStyle = '#0a0b10';
    ctx.fillRect(0, 0, width, height);

    // Draw Bricks
    for (const b of bricks) {
      ctx.fillStyle = b.color;
      ctx.shadowColor = b.color;
      ctx.shadowBlur = 6;
      ctx.fillRect(b.x, b.y, b.w, b.h);
      ctx.shadowBlur = 0;
    }

    // Draw Paddle
    ctx.fillStyle = '#06b6d4';
    ctx.shadowColor = '#06b6d4';
    ctx.shadowBlur = 10;
    ctx.fillRect(paddleX, height - 20, paddleWidth, paddleHeight);
    ctx.shadowBlur = 0;

    // Draw Ball
    ctx.fillStyle = '#ffffff';
    ctx.shadowColor = '#ffffff';
    ctx.shadowBlur = 8;
    ctx.beginPath();
    ctx.arc(ballX, ballY, ballRadius, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;

    requestAnimationFrame(() => {
      update();
      draw();
    });
  }

  function handleGameOver(won: boolean) {
    isGameOver = true;
    sound.gameOver();
    overlayTitle.textContent = won ? 'Victory! All Levels Beaten' : 'Game Over';
    overlayIcon.textContent = won ? '🏆' : '💀';
    finalScoreEl.textContent = score.toString();
    overlay.classList.remove('opacity-0', 'pointer-events-none');
  }

  function initGame() {
    score = 0;
    level = 1;
    lives = 3;
    isGameOver = false;
    scoreEl.textContent = '0';
    levelEl.textContent = '1';
    livesEl.textContent = '❤️❤️❤️';
    overlay.classList.add('opacity-0', 'pointer-events-none');
    buildLevel();
    resetBall();
  }

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * width;
    paddleX = Math.max(0, Math.min(width - paddleWidth, x - paddleWidth / 2));
  });

  canvas.addEventListener('click', () => {
    if (!ballInPlay && !isGameOver) {
      ballInPlay = true;
      sound.blip();
    }
  });

  canvas.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (e.touches[0]) {
      const rect = canvas.getBoundingClientRect();
      const x = ((e.touches[0].clientX - rect.left) / rect.width) * width;
      paddleX = Math.max(0, Math.min(width - paddleWidth, x - paddleWidth / 2));
    }
  }, { passive: false });

  canvas.addEventListener('touchstart', () => {
    if (!ballInPlay && !isGameOver) {
      ballInPlay = true;
      sound.blip();
    }
  });

  restartBtn.addEventListener('click', initGame);
  document.getElementById('btn-restart-game')?.addEventListener('click', initGame);

  initGame();
  draw();
</script>
