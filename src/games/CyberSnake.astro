---
// Cyber Snake: Neon Arcade
---

<div id="snake-app" class="flex flex-col items-center justify-center p-3 select-none">
  <!-- Stats Header -->
  <div class="mb-3 flex w-full max-w-[380px] items-center justify-between rounded-xl border border-brand-border/60 bg-brand-dark/90 px-4 py-2 text-xs">
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Score:</span>
      <span id="snake-score" class="font-mono text-base font-bold text-brand-neon">0</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Best:</span>
      <span id="snake-best" class="font-mono text-base font-bold text-white">0</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Length:</span>
      <span id="snake-length" class="font-mono text-xs text-brand-gold">3</span>
    </div>
  </div>

  <!-- Canvas Container -->
  <div class="relative overflow-hidden rounded-2xl border-2 border-brand-border bg-brand-dark shadow-2xl">
    <canvas id="snake-canvas" width="360" height="360" class="block"></canvas>

    <!-- Game Over Overlay -->
    <div id="snake-overlay" class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-brand-dark/90 backdrop-blur-sm p-6 text-center opacity-0 pointer-events-none transition-opacity">
      <span class="text-4xl">⚡</span>
      <h3 class="font-display text-2xl font-bold text-white mt-1">Trail Collision!</h3>
      <p class="mt-1 text-xs text-gray-300">Final Score: <span id="snake-final" class="font-mono font-bold text-brand-neon">0</span></p>
      <button id="snake-restart-btn" class="mt-4 rounded-xl bg-brand-accent px-6 py-2 text-xs font-bold text-white shadow-lg hover:scale-105 active:scale-95 transition-transform">
        Play Again
      </button>
    </div>
  </div>

  <!-- Mobile D-Pad Controls -->
  <div class="mt-4 sm:hidden flex flex-col items-center gap-1">
    <button id="pad-up" class="h-10 w-12 rounded-lg bg-brand-card border border-brand-border font-bold text-brand-neon active:bg-brand-neon active:text-brand-dark">▲</button>
    <div class="flex items-center gap-3">
      <button id="pad-left" class="h-10 w-12 rounded-lg bg-brand-card border border-brand-border font-bold text-brand-neon active:bg-brand-neon active:text-brand-dark">◀</button>
      <button id="pad-down" class="h-10 w-12 rounded-lg bg-brand-card border border-brand-border font-bold text-brand-neon active:bg-brand-neon active:text-brand-dark">▼</button>
      <button id="pad-right" class="h-10 w-12 rounded-lg bg-brand-card border border-brand-border font-bold text-brand-neon active:bg-brand-neon active:text-brand-dark">▶</button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';

  const canvas = document.getElementById('snake-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = document.getElementById('snake-score')!;
  const bestEl = document.getElementById('snake-best')!;
  const lengthEl = document.getElementById('snake-length')!;
  const overlay = document.getElementById('snake-overlay')!;
  const finalEl = document.getElementById('snake-final')!;
  const restartBtn = document.getElementById('snake-restart-btn')!;

  const gridSize = 18;
  const tileCount = canvas.width / gridSize; // 20x20

  interface Point { x: number; y: number }
  interface Particle { x: number; y: number; vx: number; vy: number; color: string; life: number }

  let snake: Point[] = [{ x: 10, y: 10 }, { x: 10, y: 11 }, { x: 10, y: 12 }];
  let dx = 0;
  let dy = -1;
  let nextDx = 0;
  let nextDy = -1;
  let food: Point = { x: 15, y: 8 };
  let particles: Particle[] = [];

  let score = 0;
  let best = parseInt(localStorage.getItem('pokoly_snake_best') || '0', 10);
  let isGameOver = false;
  let gameInterval: any = null;
  let speedMs = 110;

  bestEl.textContent = best.toString();

  function spawnFood() {
    let valid = false;
    while (!valid) {
      food = {
        x: Math.floor(Math.random() * tileCount),
        y: Math.floor(Math.random() * tileCount),
      };
      valid = !snake.some(s => s.x === food.x && s.y === food.y);
    }
  }

  function spawnParticles(x: number, y: number) {
    const px = x * gridSize + gridSize / 2;
    const py = y * gridSize + gridSize / 2;
    for (let i = 0; i < 12; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 3 + 1;
      particles.push({
        x: px,
        y: py,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        color: Math.random() > 0.5 ? '#06b6d4' : '#ec4899',
        life: 20
      });
    }
  }

  function step() {
    if (isGameOver) return;

    dx = nextDx;
    dy = nextDy;

    const head = { x: snake[0].x + dx, y: snake[0].y + dy };

    // Wall collision
    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
      handleGameOver();
      return;
    }

    // Tail collision
    if (snake.some(s => s.x === head.x && s.y === head.y)) {
      handleGameOver();
      return;
    }

    snake.unshift(head);

    // Food collision
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      scoreEl.textContent = score.toString();
      lengthEl.textContent = snake.length.toString();
      if (score > best) {
        best = score;
        bestEl.textContent = best.toString();
        localStorage.setItem('pokoly_snake_best', best.toString());
      }
      sound.blip();
      spawnParticles(food.x, food.y);
      spawnFood();

      if (speedMs > 60) {
        speedMs -= 2;
        clearInterval(gameInterval);
        gameInterval = setInterval(step, speedMs);
      }
    } else {
      snake.pop();
    }

    draw();
  }

  function draw() {
    ctx.fillStyle = '#0a0b10';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Grid lines (subtle cyber grid)
    ctx.strokeStyle = 'rgba(31, 36, 56, 0.4)';
    ctx.lineWidth = 1;
    for (let i = 0; i < tileCount; i++) {
      ctx.beginPath();
      ctx.moveTo(i * gridSize, 0);
      ctx.lineTo(i * gridSize, canvas.height);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(0, i * gridSize);
      ctx.lineTo(canvas.width, i * gridSize);
      ctx.stroke();
    }

    // Draw Particles
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.life--;
      ctx.fillStyle = p.color;
      ctx.fillRect(p.x, p.y, 2.5, 2.5);
      if (p.life <= 0) particles.splice(i, 1);
    }

    // Draw Food
    ctx.fillStyle = '#ec4899';
    ctx.shadowColor = '#ec4899';
    ctx.shadowBlur = 12;
    ctx.beginPath();
    ctx.arc(food.x * gridSize + gridSize / 2, food.y * gridSize + gridSize / 2, gridSize / 2.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;

    // Draw Snake
    snake.forEach((seg, idx) => {
      ctx.fillStyle = idx === 0 ? '#06b6d4' : '#0284c7';
      if (idx === 0) {
        ctx.shadowColor = '#06b6d4';
        ctx.shadowBlur = 10;
      }
      ctx.fillRect(seg.x * gridSize + 1, seg.y * gridSize + 1, gridSize - 2, gridSize - 2);
      ctx.shadowBlur = 0;
    });
  }

  function handleGameOver() {
    isGameOver = true;
    sound.gameOver();
    finalEl.textContent = score.toString();
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    clearInterval(gameInterval);
  }

  function resetGame() {
    snake = [{ x: 10, y: 10 }, { x: 10, y: 11 }, { x: 10, y: 12 }];
    dx = 0; dy = -1;
    nextDx = 0; nextDy = -1;
    score = 0;
    speedMs = 110;
    isGameOver = false;
    scoreEl.textContent = '0';
    lengthEl.textContent = '3';
    overlay.classList.add('opacity-0', 'pointer-events-none');
    spawnFood();
    clearInterval(gameInterval);
    gameInterval = setInterval(step, speedMs);
    draw();
  }

  function setDirection(newDx: number, newDy: number) {
    if (newDx !== 0 && dx !== 0) return; // Prevent 180 reverse
    if (newDy !== 0 && dy !== 0) return;
    nextDx = newDx;
    nextDy = newDy;
    sound.click();
  }

  window.addEventListener('keydown', (e) => {
    if (['ArrowUp', 'KeyW'].includes(e.code)) { e.preventDefault(); setDirection(0, -1); }
    if (['ArrowDown', 'KeyS'].includes(e.code)) { e.preventDefault(); setDirection(0, 1); }
    if (['ArrowLeft', 'KeyA'].includes(e.code)) { e.preventDefault(); setDirection(-1, 0); }
    if (['ArrowRight', 'KeyD'].includes(e.code)) { e.preventDefault(); setDirection(1, 0); }
  });

  // Mobile D-Pad buttons
  document.getElementById('pad-up')?.addEventListener('click', () => setDirection(0, -1));
  document.getElementById('pad-down')?.addEventListener('click', () => setDirection(0, 1));
  document.getElementById('pad-left')?.addEventListener('click', () => setDirection(-1, 0));
  document.getElementById('pad-right')?.addEventListener('click', () => setDirection(1, 0));

  restartBtn.addEventListener('click', resetGame);
  document.getElementById('btn-restart-game')?.addEventListener('click', resetGame);

  resetGame();
</script>
