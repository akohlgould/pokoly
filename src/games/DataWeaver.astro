---
// DataWeaver.astro - Statistical Distribution & Data Is Beautiful Puzzle
---

<div id="data-container" class="relative w-full max-w-4xl mx-auto bg-[#050811] rounded-2xl overflow-hidden border border-cyan-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(6,182,212,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0a1020]/95 border-b border-cyan-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/40 flex items-center justify-center text-cyan-300 font-bold text-xl shadow-[0_0_15px_rgba(6,182,212,0.3)]">
        📊
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-400 bg-clip-text text-transparent font-black">DATA WEAVER</span>
          <span class="px-2 py-0.5 text-[10px] bg-cyan-500/20 text-cyan-300 rounded-md border border-cyan-500/40">GAUSSIAN FIT</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">NORMAL DISTRIBUTION &bull; R² CORRELATION</div>
      </div>
    </div>

    <!-- Center Metric: R^2 Score -->
    <div class="flex items-center gap-4 bg-[#080d1a] px-4 py-1.5 rounded-xl border border-cyan-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">R² FIT:</span>
        <span id="dw-r2" class="font-bold text-cyan-300 font-mono ml-1 text-sm">0.720</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">LOCKED MOTES:</span>
        <span id="dw-motes" class="font-bold text-emerald-400 font-mono ml-1 text-sm">0/80</span>
      </div>
    </div>

    <button id="dw-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      RE-SAMPLE
    </button>
  </div>

  <!-- Main Canvas Playfield -->
  <div class="relative w-full h-[460px] sm:h-[500px] bg-[#03050c] overflow-hidden flex items-center justify-center">
    <canvas id="dw-canvas" class="w-full h-full block touch-none cursor-ew-resize"></canvas>

    <div class="absolute top-4 left-4 max-w-xs pointer-events-none bg-[#091122]/80 backdrop-blur-md p-3 rounded-xl border border-cyan-500/20 text-[11px] text-slate-300 shadow-lg">
      <span class="text-cyan-400 font-bold">STATISTICAL PROTOCOL:</span>
      <span class="text-white ml-1">Drag horizontally to shift the Gaussian Mean (μ), or vertically to adjust Variance (σ). Catch falling data points to reach R² ≥ 0.980!</span>
    </div>

    <!-- Victory Modal -->
    <div id="dw-victory-modal" class="absolute inset-0 bg-[#03050c]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-[#0c1428] border border-cyan-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(6,182,212,0.3)]">
        <span class="text-4xl animate-bounce">📈</span>
        <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">r/DATAISBEAUTIFUL FRONT PAGE!</h2>
        <p class="text-xs text-slate-300 mb-4">Gaussian distribution calibrated to statistical perfection. The chart hit the top of the subreddit!</p>
        
        <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#060a16] p-3 rounded-xl border border-cyan-500/20">
          <div>R² CORRELATION: <span class="text-cyan-300 font-bold text-sm">0.994</span></div>
          <div>REWARD: <span class="text-emerald-400 font-bold text-sm">+250 XP</span></div>
        </div>

        <button id="dw-next-btn" class="px-6 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-500 text-white font-bold text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
          NEXT DATASET &rarr;
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('dw-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const r2El = document.getElementById('dw-r2')!;
  const motesEl = document.getElementById('dw-motes')!;
  const victoryModal = document.getElementById('dw-victory-modal')!;
  const nextBtn = document.getElementById('dw-next-btn')!;
  const resetBtn = document.getElementById('dw-reset-btn')!;

  interface DataPoint {
    x: number;
    y: number;
    targetY: number;
    locked: boolean;
  }

  let meanX = 0; // Gaussian mean (horizontal pos)
  let stdDev = 60; // Standard deviation (spread)
  let points: DataPoint[] = [];
  let isDragging = false;
  let isWon = false;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
  }

  function getLogicalSize() {
    const rect = canvas.getBoundingClientRect();
    return { width: rect.width, height: rect.height };
  }

  function init() {
    const { width, height } = getLogicalSize();
    meanX = width * 0.45;
    stdDev = 75;
    isWon = false;
    victoryModal.classList.add('hidden');

    points = [];
    for (let i = 0; i < 90; i++) {
      points.push({
        x: Math.random() * width,
        y: Math.random() * (height * 0.4),
        targetY: 0,
        locked: false
      });
    }
  }

  function tick() {
    const { width, height } = getLogicalSize();
    ctx.clearRect(0, 0, width, height);

    ctx.fillStyle = '#040711';
    ctx.fillRect(0, 0, width, height);

    const baseY = height * 0.85;

    // Draw Bell Curve Formula: f(x) = A * exp( -(x - mu)^2 / (2 * sigma^2) )
    ctx.beginPath();
    ctx.moveTo(0, baseY);
    for (let x = 0; x < width; x += 4) {
      const diff = x - meanX;
      const bell = Math.exp(-(diff * diff) / (2 * stdDev * stdDev));
      const y = baseY - bell * 180;
      ctx.lineTo(x, y);
    }
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 3;
    ctx.stroke();

    ctx.lineTo(width, baseY);
    ctx.closePath();
    ctx.fillStyle = 'rgba(6, 182, 212, 0.12)';
    ctx.fill();

    // Update and Draw Data Points
    let lockedCount = 0;
    points.forEach(p => {
      const diff = p.x - meanX;
      const bell = Math.exp(-(diff * diff) / (2 * stdDev * stdDev));
      p.targetY = baseY - bell * 180;

      // Points drift towards the curve
      p.y += (p.targetY - p.y) * 0.04;

      const dist = Math.abs(p.y - p.targetY);
      if (dist < 12) {
        p.locked = true;
        lockedCount++;
      } else {
        p.locked = false;
      }

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.locked ? 4 : 2.5, 0, Math.PI * 2);
      ctx.fillStyle = p.locked ? '#34d399' : '#38bdf8';
      ctx.fill();
    });

    const r2 = Math.min(1.0, (lockedCount / points.length) * 1.15).toFixed(3);
    r2El.textContent = r2;
    motesEl.textContent = `${lockedCount}/80`;

    if (lockedCount >= 75 && !isWon) {
      isWon = true;
      sound.victory();
      launchConfetti();
      player.addXp(250);
      victoryModal.classList.remove('hidden');
    }

    requestAnimationFrame(tick);
  }

  canvas.addEventListener('pointerdown', () => { isDragging = true; });
  window.addEventListener('pointermove', (e) => {
    if (isDragging && !isWon) {
      const rect = canvas.getBoundingClientRect();
      meanX = e.clientX - rect.left;
      const normY = (e.clientY - rect.top) / rect.height;
      stdDev = Math.max(40, Math.min(130, normY * 160));
    }
  });
  window.addEventListener('pointerup', () => { isDragging = false; });

  resetBtn.addEventListener('click', init);
  nextBtn.addEventListener('click', init);
  window.addEventListener('resize', resize);

  resize();
  init();
  requestAnimationFrame(tick);
</script>
