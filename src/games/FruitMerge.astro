---
// Cosmic Fruit Merge (Suika style 2D physics merge)
---

<div id="suika-wrapper" class="flex flex-col items-center justify-center p-3 select-none">
  <!-- Score Bar -->
  <div class="mb-3 flex w-full max-w-[380px] items-center justify-between rounded-xl bg-brand-dark/90 px-4 py-2 border border-brand-border/60 text-xs">
    <div class="flex items-center gap-2">
      <span class="text-gray-400">Score:</span>
      <span id="suika-score" class="font-mono text-base font-bold text-amber-400">0</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-gray-400">Best:</span>
      <span id="suika-best" class="font-mono text-base font-bold text-white">0</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Next:</span>
      <span id="suika-next-fruit" class="text-xl">🍒</span>
    </div>
  </div>

  <!-- Physics Canvas -->
  <div class="relative overflow-hidden rounded-2xl border-2 border-brand-border bg-gradient-to-b from-brand-card to-brand-dark shadow-2xl">
    <canvas id="suika-canvas" width="360" height="520" class="block cursor-crosshair touch-none"></canvas>

    <!-- Game Over Overlay -->
    <div id="suika-gameover" class="absolute inset-0 flex flex-col items-center justify-center bg-brand-dark/90 backdrop-blur-sm p-6 text-center transition-all opacity-0 pointer-events-none">
      <span class="text-4xl">💥</span>
      <h3 class="mt-2 font-display text-2xl font-bold text-white">Container Overflow!</h3>
      <p class="mt-1 text-xs text-gray-300">Final Score: <span id="suika-final-score" class="font-mono font-bold text-brand-gold">0</span></p>
      <button id="suika-play-again" class="mt-4 rounded-xl bg-brand-accent px-6 py-2.5 font-semibold text-white shadow-lg transition-transform hover:scale-105 active:scale-95">
        Play Again
      </button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  interface FruitDef {
    radius: number;
    color: string;
    emoji: string;
    score: number;
  }

  const FRUIT_TIERS: FruitDef[] = [
    { radius: 14, color: '#f43f5e', emoji: '🍒', score: 2 },
    { radius: 20, color: '#ef4444', emoji: '🍓', score: 4 },
    { radius: 26, color: '#8b5cf6', emoji: '🍇', score: 8 },
    { radius: 32, color: '#f97316', emoji: '🍊', score: 16 },
    { radius: 40, color: '#eab308', emoji: '🍋', score: 32 },
    { radius: 48, color: '#22c55e', emoji: '🍏', score: 64 },
    { radius: 56, color: '#06b6d4', emoji: '🍑', score: 128 },
    { radius: 66, color: '#ec4899', emoji: '🍍', score: 256 },
    { radius: 76, color: '#10b981', emoji: '🍉', score: 512 },
  ];

  class CircleBody {
    x: number;
    y: number;
    vx: number = 0;
    vy: number = 0;
    tier: number;
    radius: number;
    color: string;
    emoji: string;
    settledTime: number = 0;

    constructor(x: number, y: number, tier: number) {
      this.x = x;
      this.y = y;
      this.tier = tier;
      const def = FRUIT_TIERS[tier];
      this.radius = def.radius;
      this.color = def.color;
      this.emoji = def.emoji;
    }
  }

  const canvas = document.getElementById('suika-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = document.getElementById('suika-score')!;
  const bestEl = document.getElementById('suika-best')!;
  const nextEl = document.getElementById('suika-next-fruit')!;
  const gameOverModal = document.getElementById('suika-gameover')!;
  const finalScoreEl = document.getElementById('suika-final-score')!;
  const playAgainBtn = document.getElementById('suika-play-again')!;

  const width = canvas.width;
  const height = canvas.height;
  const gravity = 0.28;
  const friction = 0.985;
  const bounce = 0.25;
  const dangerY = 60;

  let fruits: CircleBody[] = [];
  let score = 0;
  let best = parseInt(localStorage.getItem('pokoly_suika_best') || '0', 10);
  bestEl.textContent = best.toString();

  let nextTier = Math.floor(Math.random() * 3);
  let dropX = width / 2;
  let canDrop = true;
  let isGameOver = false;

  function updateNextDisplay() {
    nextEl.textContent = FRUIT_TIERS[nextTier].emoji;
  }
  updateNextDisplay();

  function spawnFruit(x: number) {
    if (!canDrop || isGameOver) return;
    canDrop = false;

    const clampedX = Math.max(FRUIT_TIERS[nextTier].radius + 5, Math.min(width - FRUIT_TIERS[nextTier].radius - 5, x));
    const fruit = new CircleBody(clampedX, 35, nextTier);
    fruits.push(fruit);
    sound.blip();

    nextTier = Math.floor(Math.random() * 3);
    updateNextDisplay();

    setTimeout(() => {
      canDrop = true;
    }, 550);
  }

  function handleCollisions() {
    for (let i = 0; i < fruits.length; i++) {
      for (let j = i + 1; j < fruits.length; j++) {
        const a = fruits[i];
        const b = fruits[j];
        if (!a || !b) continue;

        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const minDist = a.radius + b.radius;

        if (dist < minDist) {
          // Check merge condition
          if (a.tier === b.tier && a.tier < FRUIT_TIERS.length - 1) {
            // Merge into next tier!
            const nextT = a.tier + 1;
            const midX = (a.x + b.x) / 2;
            const midY = (a.y + b.y) / 2;

            fruits.splice(j, 1);
            fruits.splice(i, 1);

            const merged = new CircleBody(midX, midY, nextT);
            merged.vy = -1.5;
            fruits.push(merged);

            if (nextT >= FRUIT_TIERS.length - 1) {
              player.unlockBadge('melon_made');
              launchConfetti();
            }

            score += FRUIT_TIERS[nextT].score;
            scoreEl.textContent = score.toString();
            player.progressQuest('get_score', FRUIT_TIERS[nextT].score);
            if (score > best) {
              best = score;
              bestEl.textContent = best.toString();
              localStorage.setItem('pokoly_suika_best', best.toString());
            }

            sound.merge();
            return;
          }

          // Elastic collision response
          const overlap = minDist - dist;
          const nx = dx / (dist || 1);
          const ny = dy / (dist || 1);

          a.x -= nx * overlap * 0.5;
          a.y -= ny * overlap * 0.5;
          b.x += nx * overlap * 0.5;
          b.y += ny * overlap * 0.5;

          const kx = a.vx - b.vx;
          const ky = a.vy - b.vy;
          const p = 2 * (nx * kx + ny * ky) / 2;

          a.vx -= p * nx * 0.5;
          a.vy -= p * ny * 0.5;
          b.vx += p * nx * 0.5;
          b.vy += p * ny * 0.5;
        }
      }
    }
  }

  function update() {
    if (isGameOver) return;

    for (const f of fruits) {
      f.vy += gravity;
      f.vx *= friction;
      f.vy *= friction;

      f.x += f.vx;
      f.y += f.vy;

      // Floor boundary
      if (f.y + f.radius > height - 10) {
        f.y = height - 10 - f.radius;
        f.vy = -f.vy * bounce;
        f.vx *= 0.9;
      }

      // Walls
      if (f.x - f.radius < 10) {
        f.x = 10 + f.radius;
        f.vx = -f.vx * bounce;
      } else if (f.x + f.radius > width - 10) {
        f.x = width - 10 - f.radius;
        f.vx = -f.vx * bounce;
      }

      // Overflow check (only if stationary near top)
      if (f.y - f.radius < dangerY && Math.abs(f.vy) < 0.2 && f.y > 60) {
        f.settledTime++;
        if (f.settledTime > 90) {
          triggerGameOver();
        }
      } else {
        f.settledTime = 0;
      }
    }

    handleCollisions();
  }

  function draw() {
    ctx.clearRect(0, 0, width, height);

    // Draw container borders
    ctx.strokeStyle = '#374151';
    ctx.lineWidth = 4;
    ctx.strokeRect(8, 8, width - 16, height - 16);

    // Draw danger line
    ctx.setLineDash([6, 6]);
    ctx.strokeStyle = '#ef4444';
    ctx.beginPath();
    ctx.moveTo(10, dangerY);
    ctx.lineTo(width - 10, dangerY);
    ctx.stroke();
    ctx.setLineDash([]);

    // Draw drop guide pointer
    if (canDrop && !isGameOver) {
      const curRadius = FRUIT_TIERS[nextTier].radius;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(dropX, 40);
      ctx.lineTo(dropX, height - 15);
      ctx.stroke();

      // Ghost preview
      ctx.font = `${curRadius * 1.5}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(FRUIT_TIERS[nextTier].emoji, dropX, 35);
    }

    // Draw all fruits
    for (const f of fruits) {
      ctx.save();
      ctx.beginPath();
      ctx.arc(f.x, f.y, f.radius, 0, Math.PI * 2);
      ctx.fillStyle = f.color;
      ctx.shadowColor = f.color;
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.restore();

      // Emoji overlay
      ctx.font = `${Math.floor(f.radius * 1.3)}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(f.emoji, f.x, f.y + 2);
    }

    requestAnimationFrame(() => {
      update();
      draw();
    });
  }

  function triggerGameOver() {
    isGameOver = true;
    sound.gameOver();
    finalScoreEl.textContent = score.toString();
    gameOverModal.classList.remove('opacity-0', 'pointer-events-none');
  }

  function resetGame() {
    fruits = [];
    score = 0;
    scoreEl.textContent = '0';
    isGameOver = false;
    canDrop = true;
    gameOverModal.classList.add('opacity-0', 'pointer-events-none');
  }

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    dropX = ((e.clientX - rect.left) / rect.width) * width;
  });

  canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * width;
    spawnFruit(x);
  });

  canvas.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (e.touches[0]) {
      const rect = canvas.getBoundingClientRect();
      dropX = ((e.touches[0].clientX - rect.left) / rect.width) * width;
    }
  }, { passive: false });

  canvas.addEventListener('touchend', (e) => {
    spawnFruit(dropX);
  });

  playAgainBtn.addEventListener('click', resetGame);

  const resetBtn = document.getElementById('btn-restart-game');
  if (resetBtn) {
    resetBtn.addEventListener('click', resetGame);
  }

  draw();
</script>
