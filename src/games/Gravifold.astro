  // --- Geometric Reflection Helper Functions ---

  function updateCreaseNormal() {
    const dx = crease.p2.x - crease.p1.x;
    const dy = crease.p2.y - crease.p1.y;
    const len = Math.hypot(dx, dy) || 1;
    // Unit vector along crease
    const ux = dx / len;
    const uy = dy / len;
    // Normal perpendicular (rotated 90 deg clockwise)
    crease.normal = {
      x: -uy * crease.side,
      y: ux * crease.side
    };
  }

  // Signed distance from point P to crease line
  function distToCrease(p: Point): number {
    const vx = p.x - crease.p1.x;
    const vy = p.y - crease.p1.y;
    return vx * crease.normal.x + vy * crease.normal.y;
  }

  // Reflect point across crease line
  function reflectPoint(p: Point): Point {
    const d = distToCrease(p);
    return {
      x: p.x - 2 * d * crease.normal.x,
      y: p.y - 2 * d * crease.normal.y
    };
  }

  // Get current physical coordinate of a point based on foldProgress
  function getFoldedPoint(p: Point): Point {
    const d = distToCrease(p);
    if (d <= 0 || foldProgress === 0) {
      return { x: p.x, y: p.y };
    }
    const ref = reflectPoint(p);
    return {
      x: p.x * (1 - foldProgress) + ref.x * foldProgress,
      y: p.y * (1 - foldProgress) + ref.y * foldProgress
    };
  }

  // --- Canvas Resizing & Transform Mapping ---
  let canvasScale = 1;
  let canvasOffsetX = 0;
  let canvasOffsetY = 0;

  function resizeCanvas() {
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    canvasScale = Math.min(rect.width / VIEW_W, rect.height / VIEW_H);
    canvasOffsetX = (rect.width - VIEW_W * canvasScale) / 2;
    canvasOffsetY = (rect.height - VIEW_H * canvasScale) / 2;
  }

  function screenToView(clientX: number, clientY: number): Point {
    const rect = canvas.getBoundingClientRect();
    return {
      x: (clientX - rect.left - canvasOffsetX) / canvasScale,
      y: (clientY - rect.top - canvasOffsetY) / canvasScale
    };
  }

  // --- Chamber Initialization ---
  function loadChamber(index: number) {
    currentChamberIdx = index;
    const ch = CHAMBERS[index % CHAMBERS.length];

    levelBadge.textContent = `CHAMBER ${ch.id}`;
    levelTitle.innerHTML = `${ch.title} &bull; ${ch.subtitle}`;
    hintText.textContent = ch.hint;

    // Reset Crease
    crease.p1 = { ...ch.initialCrease.p1 };
    crease.p2 = { ...ch.initialCrease.p2 };
    crease.side = ch.initialCrease.side || 1;
    updateCreaseNormal();

    // Reset Fold
    foldProgress = 0.0;
    isFolded = false;
    updateFoldUI();

    // Reset Cores
    activeCores = ch.cores.map(c => ({
      x: c.x,
      y: c.y,
      origX: c.x,
      origY: c.y,
      collected: false
    }));
    updateCoresUI();

    // Reset Orb
    resetOrb();

    // Track play
    player.trackGamePlay('gravifold');
    isGameOver = false;
    foldsUsedThisChamber = 0;
  }

  function resetOrb() {
    const ch = CHAMBERS[currentChamberIdx % CHAMBERS.length];
    orb.x = ch.startPos.x;
    orb.y = ch.startPos.y;
    orb.vx = 0;
    orb.vy = 0;
    orb.active = false;
    orb.trail = [];
    launchLabel.textContent = "LAUNCH ORB";
  }

  function launchOrb() {
    if (orb.active) {
      resetOrb();
      return;
    }
    const ch = CHAMBERS[currentChamberIdx % CHAMBERS.length];
    orb.x = ch.startPos.x;
    orb.y = ch.startPos.y;
    orb.vx = ch.startVel.x;
    orb.vy = ch.startVel.y;
    orb.active = true;
    orb.trail = [];
    launchLabel.textContent = "RESET ORB";
    sound.score();
  }

  function toggleFold() {
    isFolded = !isFolded;
    foldsUsedThisChamber++;
    gfAudio.foldWhoosh(isFolded);

    // If unfolding while ball is on folded flap, apply kinetic slingshot impulse!
    if (!isFolded && orb.active) {
      const d = distToCrease(orb);
      if (d > -30) {
        // Boost opposite to normal direction
        orb.vx -= crease.normal.x * 9.5;
        orb.vy -= crease.normal.y * 9.5;
        gfAudio.slingshot();
