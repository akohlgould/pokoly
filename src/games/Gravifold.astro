  function spawnParticles(x: number, y: number, color: string, count = 12) {
    for (let i = 0; i < count; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 4 + 1;
      particles.push({
        x,
        y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        life: 1.0,
        maxLife: Math.random() * 20 + 20,
        color,
        size: Math.random() * 3 + 1.5
      });
    }
  }

  // --- Physics & Collision Engine ---
  function distanceToSegment(p: Point, p1: Point, p2: Point): { dist: number; closest: Point } {
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const l2 = dx * dx + dy * dy;
    if (l2 === 0) return { dist: Math.hypot(p.x - p1.x, p.y - p1.y), closest: p1 };

    let t = ((p.x - p1.x) * dx + (p.y - p1.y) * dy) / l2;
    t = Math.max(0, Math.min(1, t));
    const closest = { x: p1.x + t * dx, y: p1.y + t * dy };
    return { dist: Math.hypot(p.x - closest.x, p.y - closest.y), closest };
  }

  function stepPhysics() {
    // Fold animation easing
    const targetFold = isFolded ? 1.0 : 0.0;
    if (Math.abs(foldProgress - targetFold) > 0.001) {
      foldProgress += (targetFold - foldProgress) * 0.22;
      if (Math.abs(foldProgress - targetFold) < 0.005) foldProgress = targetFold;
    }

    if (!orb.active || isGameOver) return;

    const ch = CHAMBERS[currentChamberIdx % CHAMBERS.length];

    // Gravity calculation
    let g = 0.28;
    if (ch.invertedGravity) {
      // Invert gravity if on folded side
      const d = distToCrease(orb);
      if (d > 0 && foldProgress > 0.5) g = -0.28;
    }

    orb.vy += g;
    orb.vx *= 0.998;
    orb.vy *= 0.998;

    // Predicted new position
    const nextX = orb.x + orb.vx;
    const nextY = orb.y + orb.vy;

    // Check collision with all active platforms (both native and reflected)
    const activeSegments: Segment[] = [];
    for (const plat of ch.platforms) {
      // Check native segment
      activeSegments.push({
        p1: getFoldedPoint(plat.p1),
        p2: getFoldedPoint(plat.p2),
        type: plat.type,
        color: plat.color
      });

      // If folded, also add the reflected platform directly into collision map!
      if (foldProgress > 0.8) {
        const d1 = distToCrease(plat.p1);
        const d2 = distToCrease(plat.p2);
        if (d1 > 0 || d2 > 0) {
          activeSegments.push({
            p1: reflectPoint(plat.p1),
            p2: reflectPoint(plat.p2),
            type: plat.type,
            color: plat.color
          });
        }
      }
    }

    // Platform collisions
    for (const seg of activeSegments) {
      const { dist, closest } = distanceToSegment({ x: nextX, y: nextY }, seg.p1, seg.p2);
      if (dist < orb.radius) {
        // Laser collision: Lethal reset!
        if (seg.type === 'laser') {
          gfAudio.hazardHit();
          spawnParticles(orb.x, orb.y, '#ef4444', 20);
          resetOrb();
          return;
        }

        // Solid platform bounce
        const nx = (nextX - closest.x) / (dist || 1);
        const ny = (nextY - closest.y) / (dist || 1);

        // Separate
        orb.x = closest.x + nx * (orb.radius + 0.5);
        orb.y = closest.y + ny * (orb.radius + 0.5);

        // Reflect velocity with restitution
        const dot = orb.vx * nx + orb.vy * ny;
        if (dot < 0) {
          const restitution = seg.type === 'trampoline' ? 1.2 : 0.62;
          orb.vx -= (1 + restitution) * dot * nx;
          orb.vy -= (1 + restitution) * dot * ny;

          // Tangential friction
          orb.vx *= 0.94;

          gfAudio.bounce(Math.hypot(orb.vx, orb.vy));
          spawnParticles(closest.x, closest.y, '#38bdf8', 4);
        }
        return;
      }
    }

    orb.x = nextX;
    orb.y = nextY;

    // Trail history
    orb.trail.push({ x: orb.x, y: orb.y });
    if (orb.trail.length > 22) orb.trail.shift();

    // Check Quantum Core pickups
    activeCores.forEach((core, i) => {
      if (core.collected) return;
      // Core can be collected at native position or reflected folded position!
      const currPos = getFoldedPoint({ x: core.origX, y: core.origY });
      const d1 = Math.hypot(orb.x - currPos.x, orb.y - currPos.y);

      let d2 = 999;
      if (foldProgress > 0.8) {
        const refPos = reflectPoint({ x: core.origX, y: core.origY });
        d2 = Math.hypot(orb.x - refPos.x, orb.y - refPos.y);
      }

      if (d1 < orb.radius + 14 || d2 < orb.radius + 14) {
        core.collected = true;
        gfAudio.pickupCore(i);
        spawnParticles(orb.x, orb.y, '#f59e0b', 16);
        updateCoresUI();
        player.addXP(25, 'Secured Quantum Core');
      }
    });

    // Check Goal Singularity
    const activeGoal = getFoldedPoint(ch.goalPos);
    let distGoal = Math.hypot(orb.x - activeGoal.x, orb.y - activeGoal.y);
    if (foldProgress > 0.8) {
      const refGoal = reflectPoint(ch.goalPos);
      distGoal = Math.min(distGoal, Math.hypot(orb.x - refGoal.x, orb.y - refGoal.y));
    }

    // Gravitational suction into goal vortex
    if (distGoal < 45) {
      orb.vx += (activeGoal.x - orb.x) * 0.08;
      orb.vy += (activeGoal.y - orb.y) * 0.08;
      orb.vx *= 0.85;
      orb.vy *= 0.85;
    }

    // Victory Trigger!
    if (distGoal < 14) {
      completeChamber();
    }

    // Out of bounds reset
    if (orb.y > VIEW_H + 80 || orb.y < -120 || orb.x < -80 || orb.x > VIEW_W + 80) {
      gfAudio.hazardHit();
      resetOrb();
    }
  }

  function completeChamber() {
    isGameOver = true;
    orb.active = false;
    completedChambers.add(currentChamberIdx);

    gfAudio.victoryFanfare();
    launchConfetti();

    player.addXP(150, `Collapsed Chamber ${currentChamberIdx + 1}`);
    player.progressQuest('get_score', 100);

    const coresCount = activeCores.filter(c => c.collected).length;
    statFolds.textContent = String(foldsUsedThisChamber);
    statCores.textContent = `${coresCount}/${activeCores.length}`;
    victoryModal.classList.remove('hidden');
  }

  // --- Rendering Loop (60 FPS Canvas) ---
  let time = 0;

  function render() {
    time += 0.03;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.save();
    ctx.translate(canvasOffsetX, canvasOffsetY);
    ctx.scale(canvasScale, canvasScale);

    // 1. Blueprint Grid Background
    renderBackground();

    // 2. Crease Line & Visual Paper Fold Flap
    renderFoldLayers();

    // 3. Platforms & Lasers
    renderPlatforms();

    // 4. Quantum Cores & Goal Singularity
    renderCollectiblesAndGoal();

    // 5. The Kinetic Orb & Trails
    renderOrb();

    // 6. Particle Bursts
    renderParticles();

    ctx.restore();

    stepPhysics();
    requestAnimationFrame(render);
  }

  function renderBackground() {
    // Deep starry cosmic gradient
    const grad = ctx.createLinearGradient(0, 0, VIEW_W, VIEW_H);
    grad.addColorStop(0, '#060a16');
    grad.addColorStop(1, '#090f24');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, VIEW_W, VIEW_H);

    // Subtle isometric/orthogonal blueprint grid
    ctx.strokeStyle = 'rgba(6, 182, 212, 0.04)';
    ctx.lineWidth = 1;
    const step = 40;
    for (let x = 0; x <= VIEW_W; x += step) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, VIEW_H);
      ctx.stroke();
    }
    for (let y = 0; y <= VIEW_H; y += step) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(VIEW_W, y);
      ctx.stroke();
    }

    // Border glowing frame
    ctx.strokeStyle = 'rgba(6, 182, 212, 0.25)';
    ctx.lineWidth = 2;
    ctx.strokeRect(2, 2, VIEW_W - 4, VIEW_H - 4);
  }

  function renderFoldLayers() {
    // Extend crease line to screen boundaries
    const dx = crease.p2.x - crease.p1.x;
    const dy = crease.p2.y - crease.p1.y;
    const len = Math.hypot(dx, dy) || 1;
    const ux = dx / len;
    const uy = dy / len;

    const farA = { x: crease.p1.x - ux * 1000, y: crease.p1.y - uy * 1000 };
    const farB = { x: crease.p2.x + ux * 1000, y: crease.p2.y + uy * 1000 };

    // If folded, draw realistic paper shading and drop shadow along crease
    if (foldProgress > 0) {
      ctx.save();
      // Drop shadow along the crease onto the underlying sheet
      const shadowDist = 24 * foldProgress;
      const shadowGrad = ctx.createLinearGradient(
        crease.p1.x, crease.p1.y,
        crease.p1.x - crease.normal.x * shadowDist,
        crease.p1.y - crease.normal.y * shadowDist
      );
      shadowGrad.addColorStop(0, `rgba(0, 0, 0, ${0.75 * foldProgress})`);
      shadowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = shadowGrad;
      ctx.beginPath();
      ctx.moveTo(farA.x, farA.y);
      ctx.lineTo(farB.x, farB.y);
      ctx.lineTo(farB.x - crease.normal.x * shadowDist, farB.y - crease.normal.y * shadowDist);
      ctx.lineTo(farA.x - crease.normal.x * shadowDist, farA.y - crease.normal.y * shadowDist);
      ctx.closePath();
      ctx.fill();

      // Folded flap translucent holographic sheen
      ctx.fillStyle = `rgba(14, 165, 233, ${0.08 * foldProgress})`;
      ctx.beginPath();
      ctx.moveTo(farA.x, farA.y);
      ctx.lineTo(farB.x, farB.y);
      ctx.lineTo(farB.x + crease.normal.x * 1200, farB.y + crease.normal.y * 1200);
      ctx.lineTo(farA.x + crease.normal.x * 1200, farA.y + crease.normal.y * 1200);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    // Glowing Crease Line
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(farA.x, farA.y);
    ctx.lineTo(farB.x, farB.y);
    ctx.setLineDash([8, 6]);
    ctx.strokeStyle = isFolded ? '#fbbf24' : '#22d3ee';
    ctx.lineWidth = 2.5;
    ctx.shadowColor = isFolded ? '#f59e0b' : '#06b6d4';
    ctx.shadowBlur = 12;
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.restore();

    // Crease drag handles
    renderHandle(crease.p1);
    renderHandle(crease.p2);

    // Normal arrow indicator showing which side folds
    const midX = (crease.p1.x + crease.p2.x) / 2;
    const midY = (crease.p1.y + crease.p2.y) / 2;
    const arrowLen = 32;
    const arrowTipX = midX + crease.normal.x * arrowLen;
    const arrowTipY = midY + crease.normal.y * arrowLen;

    ctx.save();
    ctx.strokeStyle = isFolded ? '#fbbf24' : '#38bdf8';
    ctx.fillStyle = isFolded ? '#fbbf24' : '#38bdf8';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(midX, midY);
    ctx.lineTo(arrowTipX, arrowTipY);
    ctx.stroke();

    // Arrowhead
    const angle = Math.atan2(crease.normal.y, crease.normal.x);
    ctx.beginPath();
    ctx.moveTo(arrowTipX, arrowTipY);
    ctx.lineTo(arrowTipX - 8 * Math.cos(angle - 0.5), arrowTipY - 8 * Math.sin(angle - 0.5));
    ctx.lineTo(arrowTipX - 8 * Math.cos(angle + 0.5), arrowTipY - 8 * Math.sin(angle + 0.5));
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  function renderHandle(p: Point) {
    ctx.save();
    ctx.beginPath();
    ctx.arc(p.x, p.y, 8, 0, Math.PI * 2);
    ctx.fillStyle = '#0f172a';
    ctx.fill();
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = '#38bdf8';
    ctx.shadowColor = '#06b6d4';
    ctx.shadowBlur = 8;
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#ffffff';
    ctx.fill();
    ctx.restore();
  }

  function renderPlatforms() {
    const ch = CHAMBERS[currentChamberIdx % CHAMBERS.length];

    for (const plat of ch.platforms) {
      const p1 = getFoldedPoint(plat.p1);
      const p2 = getFoldedPoint(plat.p2);

      if (plat.type === 'laser') {
        // Lethal Pulsing Laser Beam
        ctx.save();
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 4 + Math.sin(time * 8) * 1.5;
        ctx.shadowColor = '#dc2626';
        ctx.shadowBlur = 18;
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.stroke();

        // Laser core white beam
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.restore();
      } else {
        // High-tech Solid Platform
        ctx.save();
        ctx.strokeStyle = '#0284c7';
        ctx.lineWidth = 7;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.stroke();

        // Platform neon ridge
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 2;
        ctx.shadowColor = '#0284c7';
        ctx.shadowBlur = 8;
        ctx.stroke();
        ctx.restore();
      }
    }
  }

  function renderCollectiblesAndGoal() {
    const ch = CHAMBERS[currentChamberIdx % CHAMBERS.length];

    // Singularity Goal Vortex
    const goal = getFoldedPoint(ch.goalPos);
    ctx.save();
    ctx.translate(goal.x, goal.y);

    // Spinning event horizon rings
    for (let r = 24; r >= 8; r -= 8) {
      ctx.beginPath();
      ctx.arc(0, 0, r, time * (r % 16 === 0 ? 2 : -2), time * (r % 16 === 0 ? 2 : -2) + Math.PI * 1.6);
      ctx.strokeStyle = r === 24 ? '#38bdf8' : '#818cf8';
      ctx.lineWidth = 2.5;
      ctx.shadowColor = '#06b6d4';
      ctx.shadowBlur = 12;
      ctx.stroke();
    }

    // Vortex center eye
    ctx.beginPath();
    ctx.arc(0, 0, 6, 0, Math.PI * 2);
    ctx.fillStyle = '#ffffff';
    ctx.shadowColor = '#ffffff';
    ctx.shadowBlur = 15;
    ctx.fill();
    ctx.restore();

    // Quantum Cores
    activeCores.forEach((core, i) => {
      if (core.collected) return;
      const pos = getFoldedPoint({ x: core.origX, y: core.origY });

      ctx.save();
      ctx.translate(pos.x, pos.y);
      ctx.rotate(time * 1.5 + i);

      // Rotating diamond crystal
      ctx.beginPath();
      ctx.moveTo(0, -11);
      ctx.lineTo(8, 0);
      ctx.lineTo(0, 11);
      ctx.lineTo(-8, 0);
      ctx.closePath();

      ctx.fillStyle = '#fbbf24';
      ctx.shadowColor = '#f59e0b';
      ctx.shadowBlur = 14;
      ctx.fill();

      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.restore();
    });
  }

  function renderOrb() {
    const ch = CHAMBERS[currentChamberIdx % CHAMBERS.length];

    // Start Dispenser chute
    ctx.save();
    ctx.fillStyle = 'rgba(6, 182, 212, 0.15)';
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(ch.startPos.x, ch.startPos.y, orb.radius + 6, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fill();
    ctx.restore();

    // Orb motion trail
    if (orb.trail.length > 1) {
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(orb.trail[0].x, orb.trail[0].y);
      for (let i = 1; i < orb.trail.length; i++) {
        ctx.lineTo(orb.trail[i].x, orb.trail[i].y);
      }
      ctx.strokeStyle = 'rgba(34, 211, 238, 0.4)';
      ctx.lineWidth = 4;
      ctx.lineCap = 'round';
      ctx.stroke();
      ctx.restore();
    }

    // The Quantum Orb itself
    ctx.save();
    ctx.translate(orb.x, orb.y);

    // Glowing corona
    const corona = ctx.createRadialGradient(0, 0, 2, 0, 0, orb.radius + 6);
    corona.addColorStop(0, '#ffffff');
    corona.addColorStop(0.4, '#38bdf8');
    corona.addColorStop(1, 'rgba(6, 182, 212, 0)');
    ctx.fillStyle = corona;
    ctx.beginPath();
    ctx.arc(0, 0, orb.radius + 6, 0, Math.PI * 2);
    ctx.fill();

    // Core sphere
    ctx.beginPath();
    ctx.arc(0, 0, orb.radius, 0, Math.PI * 2);
    ctx.fillStyle = '#0284c7';
    ctx.fill();
    ctx.strokeStyle = '#e0f2fe';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Specular highlight
    ctx.beginPath();
    ctx.arc(-3, -3, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#ffffff';
    ctx.fill();
    ctx.restore();
  }

  function renderParticles() {
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.life -= 1 / p.maxLife;

      if (p.life <= 0) {
        particles.splice(i, 1);
        continue;
      }

      ctx.save();
      ctx.globalAlpha = p.life;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }

  // --- Input Handling: Touch & Mouse ---

  function getHandleUnderMouse(p: Point): 'p1' | 'p2' | null {
    if (Math.hypot(p.x - crease.p1.x, p.y - crease.p1.y) < 18) return 'p1';
    if (Math.hypot(p.x - crease.p2.x, p.y - crease.p2.y) < 18) return 'p2';
    return null;
  }

  canvas.addEventListener('mousedown', (e) => {
    const pt = screenToView(e.clientX, e.clientY);
    const handle = getHandleUnderMouse(pt);
    if (handle) {
      dragHandle = handle;
      isDraggingCrease = true;
    } else {
      // Start freehand crease draw
      dragHandle = 'new';
      dragStart = pt;
      isDraggingCrease = true;
      crease.p1 = { ...pt };
      crease.p2 = { ...pt };
    }
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDraggingCrease) return;
    const pt = screenToView(e.clientX, e.clientY);

    if (dragHandle === 'p1') {
      crease.p1 = pt;
      updateCreaseNormal();
    } else if (dragHandle === 'p2') {
      crease.p2 = pt;
      updateCreaseNormal();
    } else if (dragHandle === 'new') {
      crease.p2 = pt;
      updateCreaseNormal();
    }
  });

  window.addEventListener('mouseup', () => {
    if (isDraggingCrease) {
      isDraggingCrease = false;
      // Ensure crease has minimum length
      if (Math.hypot(crease.p2.x - crease.p1.x, crease.p2.y - crease.p1.y) < 30) {
        // Fallback default
        crease.p1 = { x: 400, y: 40 };
        crease.p2 = { x: 400, y: 460 };
      }
      updateCreaseNormal();
      sound.click();
    }
  });

  // Touch support for mobile devices
  canvas.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
      e.preventDefault();
      const t = e.touches[0];
      const pt = screenToView(t.clientX, t.clientY);
      const handle = getHandleUnderMouse(pt);
      if (handle) {
        dragHandle = handle;
      } else {
        dragHandle = 'new';
        dragStart = pt;
        crease.p1 = { ...pt };
        crease.p2 = { ...pt };
      }
      isDraggingCrease = true;
    }
  }, { passive: false });

  canvas.addEventListener('touchmove', (e) => {
    if (isDraggingCrease && e.touches.length === 1) {
      e.preventDefault();
      const t = e.touches[0];
      const pt = screenToView(t.clientX, t.clientY);
      if (dragHandle === 'p1') crease.p1 = pt;
      else if (dragHandle === 'p2') crease.p2 = pt;
      else if (dragHandle === 'new') crease.p2 = pt;
      updateCreaseNormal();
    }
  }, { passive: false });

  canvas.addEventListener('touchend', () => {
    if (isDraggingCrease) {
      isDraggingCrease = false;
      if (Math.hypot(crease.p2.x - crease.p1.x, crease.p2.y - crease.p1.y) < 30) {
        crease.p1 = { x: 400, y: 40 };
        crease.p2 = { x: 400, y: 460 };
      }
      updateCreaseNormal();
      sound.click();
    }
  });

  // --- Keyboard Shortcuts ---
  window.addEventListener('keydown', (e) => {
    if (e.key === ' ' || e.code === 'Space') {
      e.preventDefault();
      toggleFold();
    } else if (e.key === 'l' || e.key === 'L') {
      launchOrb();
    } else if (e.key === 'r' || e.key === 'R') {
      resetOrb();
    } else if (e.key === 'v' || e.key === 'V') {
      setPresetVert();
    } else if (e.key === 'h' || e.key === 'H') {
      setPresetHoriz();
    }
  });

  // --- Presets & UI Controls ---
  function setPresetVert() {
    crease.p1 = { x: 400, y: 40 };
    crease.p2 = { x: 400, y: 460 };
    updateCreaseNormal();
    sound.click();
  }

  function setPresetHoriz() {
    crease.p1 = { x: 60, y: 250 };
    crease.p2 = { x: 740, y: 250 };
    updateCreaseNormal();
    sound.click();
  }

  function setPresetDiag() {
    crease.p1 = { x: 620, y: 60 };
    crease.p2 = { x: 180, y: 440 };
    updateCreaseNormal();
    sound.click();
  }

  function flipSide() {
    crease.side = (crease.side === 1 ? -1 : 1) as 1 | -1;
    updateCreaseNormal();
    sound.blip();
  }

  presetVert.addEventListener('click', setPresetVert);
  presetHoriz.addEventListener('click', setPresetHoriz);
  presetDiag.addEventListener('click', setPresetDiag);
  flipSideBtn.addEventListener('click', flipSide);

  foldToggleBtn.addEventListener('click', toggleFold);
  launchBtn.addEventListener('click', launchOrb);
  resetBtn.addEventListener('click', resetOrb);

  // Chambers Modal
  chambersBtn.addEventListener('click', () => {
    renderChambersGrid();
    chambersModal.classList.remove('hidden');
    sound.click();
  });

  closeChambersBtn.addEventListener('click', () => {
    chambersModal.classList.add('hidden');
  });

  function renderChambersGrid() {
    completedCountEl.textContent = String(completedChambers.size);
    chambersGrid.innerHTML = '';
    CHAMBERS.forEach((ch, idx) => {
      const btn = document.createElement('button');
      const isDone = completedChambers.has(idx);
      const isCurrent = currentChamberIdx === idx;
      btn.className = `p-3 rounded-xl border text-xs font-bold transition-all flex flex-col items-center gap-1 ${
        isCurrent
          ? 'bg-cyan-500/20 border-cyan-400 text-white shadow-[0_0_12px_rgba(6,182,212,0.4)]'
          : isDone
          ? 'bg-emerald-950/40 border-emerald-500/40 text-emerald-300 hover:bg-emerald-900/50'
          : 'bg-slate-900/80 border-slate-700/80 text-slate-400 hover:bg-slate-800 hover:text-white'
      }`;
      btn.innerHTML = `
        <span class="text-sm">${isDone ? '✓' : idx + 1}</span>
        <span class="text-[10px] truncate max-w-full">${ch.title}</span>
      `;
      btn.addEventListener('click', () => {
        loadChamber(idx);
        chambersModal.classList.add('hidden');
      });
      chambersGrid.appendChild(btn);
    });
  }

  sandboxModeBtn.addEventListener('click', () => {
    // Generate daily procedural chamber
    generateProceduralChamber();
    chambersModal.classList.add('hidden');
  });

  function generateProceduralChamber() {
    const seed = Math.floor(Math.random() * 9999);
    const startY = 120 + (seed % 180);
    const goalX = 580 + (seed % 140);
    const goalY = 140 + ((seed * 7) % 240);

    const procChamber: ChamberDef = {
      id: 99,
      title: `PROCEDURAL SEED #${seed}`,
      subtitle: "TOPOLOGICAL ANOMALY &bull; DYNAMIC FOLD",
      hint: "Procedural spacetime manifold. Analyze platform positions and crease strategically!",
      startPos: { x: 100, y: startY },
      startVel: { x: 2.0, y: 0 },
      goalPos: { x: goalX, y: goalY },
      platforms: [
        { p1: { x: 60, y: startY + 40 }, p2: { x: 240, y: startY + 80 }, type: 'solid' },
        { p1: { x: goalX - 100, y: goalY + 40 }, p2: { x: goalX + 80, y: goalY + 40 }, type: 'solid' },
        { p1: { x: 380, y: 100 }, p2: { x: 380, y: 360 }, type: 'laser' }
      ],
      cores: [
        { x: 300, y: 220 },
        { x: 500, y: 320 }
      ],
      initialCrease: { p1: { x: 400, y: 40 }, p2: { x: 400, y: 460 }, side: 1 }
    };

    CHAMBERS.push(procChamber);
    loadChamber(CHAMBERS.length - 1);
  }

  // Victory Modal Actions
  nextChamberBtn.addEventListener('click', () => {
    victoryModal.classList.add('hidden');
    loadChamber((currentChamberIdx + 1) % CHAMBERS.length);
  });

  replayChamberBtn.addEventListener('click', () => {
    victoryModal.classList.add('hidden');
    loadChamber(currentChamberIdx);
  });

  // Audio Toggle
  audioToggle.addEventListener('click', () => {
    gfAudio.enabled = !gfAudio.enabled;
    sound.enabled = gfAudio.enabled;
    if (gfAudio.enabled) {
      soundOnIcon.classList.remove('hidden');
      soundOffIcon.classList.add('hidden');
    } else {
      soundOnIcon.classList.add('hidden');
      soundOffIcon.classList.remove('hidden');
    }
  });

  // Window resize handler
  window.addEventListener('resize', resizeCanvas);

  // Initialize
  resizeCanvas();
  loadChamber(0);
  requestAnimationFrame(render);
</script>
