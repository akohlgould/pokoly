  // --- Audio Synthesis Extensions for Gravifold ---
  class GravifoldAudio {
    private ctx: AudioContext | null = null;
    public enabled = true;

    private getContext(): AudioContext | null {
      if (!this.enabled) return null;
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
      return this.ctx;
    }

    // Realistic paper whoosh using bandpass-filtered noise sweep
    public foldWhoosh(isFolding: boolean) {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const bufferSize = ctx.sampleRate * 0.25;
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.4));
        }

        const noise = ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.Q.value = 4.0;

        const now = ctx.currentTime;
        if (isFolding) {
          filter.frequency.setValueAtTime(300, now);
          filter.frequency.exponentialRampToValueAtTime(2400, now + 0.12);
          filter.frequency.exponentialRampToValueAtTime(600, now + 0.24);
        } else {
          filter.frequency.setValueAtTime(1800, now);
          filter.frequency.exponentialRampToValueAtTime(400, now + 0.22);
        }

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.18, now);
        gain.gain.linearRampToValueAtTime(0.001, now + 0.24);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start(now);
      } catch (e) {}
    }

    // Kinetic Paper Slingshot impulse sound
    public slingshot() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(90, now);
        osc.frequency.exponentialRampToValueAtTime(550, now + 0.18);

        gain.gain.setValueAtTime(0.22, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.28);
      } catch (e) {}
    }

    // Quantum Core Pickup Arpeggio
    public pickupCore(index: number) {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const freqs = [659.25, 830.61, 987.77, 1318.51]; // E5, G#5, B5, E6
        const freq = freqs[Math.min(index, freqs.length - 1)];
        const now = ctx.currentTime;

        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.exponentialRampToValueAtTime(freq * 1.5, now + 0.15);

        gain.gain.setValueAtTime(0.18, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.25);
      } catch (e) {}
    }

    // Orb Bounce on Platform
    public bounce(vel: number) {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        const vol = Math.min(0.16, Math.max(0.03, vel * 0.02));
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(320 + Math.random() * 80, now);
        osc.frequency.exponentialRampToValueAtTime(140, now + 0.08);

        gain.gain.setValueAtTime(vol, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.09);
      } catch (e) {}
    }

    // Singularity Cleared Fanfare
    public victoryFanfare() {
      const notes = [440, 554.37, 659.25, 880, 1108.73];
      notes.forEach((freq, i) => {
        setTimeout(() => {
          sound.playTone(freq, 'sine', 0.25, 0.14);
        }, i * 90);
      });
    }

    public hazardHit() {
      sound.playTone(130, 'sawtooth', 0.18, 0.2);
    }
  }

