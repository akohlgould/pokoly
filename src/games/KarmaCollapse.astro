---
// KarmaCollapse.astro - Physics-based Upvote & Downvote Forum Balance
---

<div id="karma-container" class="relative w-full max-w-4xl mx-auto bg-[#08090f] rounded-2xl overflow-hidden border border-orange-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(249,115,22,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0e101a]/95 border-b border-orange-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/40 flex items-center justify-center text-orange-400 font-bold text-xl shadow-[0_0_15px_rgba(249,115,22,0.3)]">
        🗳️
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-orange-400 via-amber-300 to-rose-400 bg-clip-text text-transparent font-black">KARMA COLLAPSE</span>
          <span class="px-2 py-0.5 text-[10px] bg-orange-500/20 text-orange-300 rounded-md border border-orange-500/40">HIVEMIND</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">BUOYANT UPVOTES &bull; GRAVITATIONAL DOWNVOTES</div>
      </div>
    </div>

    <!-- Center Metric: Stability Timer -->
    <div class="flex items-center gap-4 bg-[#0a0c16] px-4 py-1.5 rounded-xl border border-orange-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">THREAD KARMA:</span>
        <span id="kc-karma" class="font-bold text-orange-400 font-mono ml-1 text-sm">+420</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">HOLD TIME:</span>
        <span id="kc-timer" class="font-bold text-emerald-400 font-mono ml-1 text-sm">0s / 15s</span>
      </div>
    </div>

    <button id="kc-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      NEW THREAD
    </button>
  </div>

  <!-- Main Canvas Playfield -->
  <div class="relative w-full h-[460px] sm:h-[500px] bg-[#04050a] overflow-hidden flex items-center justify-center">
    <canvas id="kc-canvas" class="w-full h-full block touch-none cursor-pointer"></canvas>

    <div class="absolute bottom-4 inset-x-6 flex items-center justify-between pointer-events-none text-xs">
      <div class="bg-[#0b0d18]/80 backdrop-blur-md px-3.5 py-2 rounded-xl border border-orange-500/20 text-slate-300 shadow-lg pointer-events-auto flex gap-3">
        <span class="text-orange-400 font-bold">LEFT CLICK / TAP LEFT:</span> Drop Upvote Balloon (Lifts Track)
      </div>
      <div class="bg-[#0b0d18]/80 backdrop-blur-md px-3.5 py-2 rounded-xl border border-indigo-500/20 text-slate-300 shadow-lg pointer-events-auto flex gap-3">
        <span class="text-indigo-400 font-bold">RIGHT CLICK / TAP RIGHT:</span> Drop Downvote Anvil (Weighs Down)
      </div>
    </div>

    <!-- Victory Modal -->
    <div id="kc-victory-modal" class="absolute inset-0 bg-[#04050a]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-[#101222] border border-orange-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(249,115,22,0.3)]">
        <span class="text-4xl animate-bounce">🏆</span>
        <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">THREAD REACHED r/ALL!</h2>
        <p class="text-xs text-slate-300 mb-4">You successfully balanced the hivemind controversy without getting locked by the moderators!</p>
        
        <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#080914] p-3 rounded-xl border border-orange-500/20">
          <div>REWARD: <span class="text-orange-400 font-bold text-sm">+250 XP</span></div>
        </div>

        <button id="kc-next-btn" class="px-6 py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 text-slate-950 font-black text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
          NEXT THREAD &rarr;
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('kc-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const karmaEl = document.getElementById('kc-karma')!;
  const timerEl = document.getElementById('kc-timer')!;
  const victoryModal = document.getElementById('kc-victory-modal')!;
  const nextBtn = document.getElementById('kc-next-btn')!;
  const resetBtn = document.getElementById('kc-reset-btn')!;

  interface WeightItem {
    x: number;
    y: number;
    type: 'upvote' | 'downvote';
    vy: number;
  }

  let angle = 0; // Bar angle in radians (-0.4 to 0.4 max)
  let angularVel = 0;
  let items: WeightItem[] = [];
  let holdSeconds = 0;
  let isWon = false;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
  }

  function getLogicalSize() {
    const rect = canvas.getBoundingClientRect();
    return { width: rect.width, height: rect.height };
  }

  function init() {
    angle = 0;
    angularVel = 0;
    items = [];
    holdSeconds = 0;
    isWon = false;
    karmaEl.textContent = "+420";
    timerEl.textContent = "0s / 15s";
    victoryModal.classList.add('hidden');
  }

  function dropItem(side: 'left' | 'right', type: 'upvote' | 'downvote') {
    const { width } = getLogicalSize();
    const x = side === 'left' ? width * 0.25 : width * 0.75;
    items.push({
      x,
      y: type === 'upvote' ? 380 : 40,
      type,
      vy: type === 'upvote' ? -3.5 : 3.5
    });
    sound.blip();
  }

  function tick() {
    const { width, height } = getLogicalSize();
    ctx.clearRect(0, 0, width, height);

    ctx.fillStyle = '#05060b';
    ctx.fillRect(0, 0, width, height);

    const cx = width / 2;
    const cy = height * 0.65;
    const barLength = width * 0.65;

    // Fulcrum base
    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx - 30, cy + 80);
    ctx.lineTo(cx + 30, cy + 80);
    ctx.closePath();
    ctx.fill();

    // Random comment brigading
    if (Math.random() < 0.02 && !isWon) {
      dropItem(Math.random() < 0.5 ? 'left' : 'right', Math.random() < 0.5 ? 'upvote' : 'downvote');
    }

    // Apply torque from attached items
    let torque = 0;
    items.forEach(it => {
      it.y += it.vy;
      const arm = it.x - cx;
      if (it.type === 'upvote') {
        torque -= arm * 0.0003; // Lifts upwards
      } else {
        torque += arm * 0.0003; // Pulls down
      }
    });

    angularVel += torque;
    angularVel *= 0.96; // Damping
    angle += angularVel;

    // Check angle threshold
    if (Math.abs(angle) > 0.45) {
      sound.playTone(150, 'sawtooth', 0.25, 0.2);
      init();
    } else {
      if (!isWon) {
        holdSeconds += 0.016;
        timerEl.textContent = `${Math.min(15, Math.floor(holdSeconds))}s / 15s`;
        if (holdSeconds >= 15) {
          isWon = true;
          sound.victory();
          launchConfetti();
          player.addXp(250);
          victoryModal.classList.remove('hidden');
        }
      }
    }

    // Draw Tilting Bar
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(angle);

    ctx.fillStyle = '#334155';
    ctx.beginPath();
    ctx.roundRect(-barLength / 2, -10, barLength, 20, 6);
    ctx.fill();
    ctx.strokeStyle = '#f97316';
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.restore();

    // Draw Items
    items.forEach(it => {
      ctx.beginPath();
      ctx.arc(it.x, it.y, 14, 0, Math.PI * 2);
      ctx.fillStyle = it.type === 'upvote' ? '#ea580c' : '#4f46e5';
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(it.type === 'upvote' ? '▲' : '▼', it.x, it.y);
    });

    requestAnimationFrame(tick);
  }

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    if (x < rect.width / 2) {
      dropItem('left', 'upvote');
    } else {
      dropItem('right', 'downvote');
    }
  });

  resetBtn.addEventListener('click', init);
  nextBtn.addEventListener('click', init);
  window.addEventListener('resize', resize);

  resize();
  init();
  requestAnimationFrame(tick);
</script>
