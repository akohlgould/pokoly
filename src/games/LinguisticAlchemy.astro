---
// LinguisticAlchemy.astro - Etymological Root Morpheme Transmutation
---

<div id="alchemy-container" class="relative w-full max-w-4xl mx-auto bg-[#0a0814] rounded-2xl overflow-hidden border border-purple-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(168,85,247,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0f0c22]/95 border-b border-purple-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/40 flex items-center justify-center text-purple-300 font-bold text-xl shadow-[0_0_15px_rgba(168,85,247,0.3)]">
        📜
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-purple-400 via-pink-300 to-indigo-400 bg-clip-text text-transparent font-black">LINGUISTIC ALCHEMY</span>
          <span class="px-2 py-0.5 text-[10px] bg-purple-500/20 text-purple-300 rounded-md border border-purple-500/40">ETYMON FORGE</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">GREEK & LATIN ROOT TRANSMUTATION</div>
      </div>
    </div>

    <!-- Center Metric -->
    <div class="flex items-center gap-4 bg-[#0a081e] px-4 py-1.5 rounded-xl border border-purple-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">FORGED:</span>
        <span id="la-score" class="font-bold text-purple-300 font-mono ml-1 text-sm">0/4</span>
      </div>
    </div>

    <button id="la-clear-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      CLEAR CRUCIBLE
    </button>
  </div>

  <!-- Main Playing Board -->
  <div class="p-6 flex flex-col items-center justify-center gap-6 min-h-[460px]">
    <!-- Current Target Scroll -->
    <div class="w-full max-w-lg bg-[#140e2b] p-4 rounded-2xl border border-purple-500/40 shadow-xl text-center">
      <div class="text-[11px] text-purple-400 font-bold uppercase tracking-wider mb-1">TARGET MEANING TO FORGE:</div>
      <div id="la-target-hint" class="text-base sm:text-lg font-bold text-white mb-1">"An instrument for measuring and recording time"</div>
      <div id="la-target-slots" class="flex justify-center gap-2 mt-3">
        <span class="w-24 py-1.5 rounded-lg border border-dashed border-purple-400/50 bg-purple-950/30 text-purple-300 font-bold text-xs" id="la-slot-1">?</span>
        <span class="text-purple-400 self-center font-bold">+</span>
        <span class="w-24 py-1.5 rounded-lg border border-dashed border-purple-400/50 bg-purple-950/30 text-purple-300 font-bold text-xs" id="la-slot-2">?</span>
      </div>
    </div>

    <!-- Transmutation Button -->
    <button id="la-forge-btn" class="px-8 py-3 bg-gradient-to-r from-purple-600 via-pink-600 to-indigo-600 hover:brightness-110 text-white font-black text-sm rounded-2xl shadow-xl transition-all active:scale-95 cursor-pointer">
      TRANSMUTE WORD ✨
    </button>

    <!-- Available Etymon Root Flasks -->
    <div class="w-full max-w-xl">
      <div class="text-xs text-slate-400 text-center mb-3">SELECT TWO MORPHEMIC ROOTS TO COMBINE IN THE CRUCIBLE:</div>
      <div id="la-roots-container" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <!-- Dynamically injected roots -->
      </div>
    </div>
  </div>

  <!-- Victory Modal -->
  <div id="la-victory-modal" class="absolute inset-0 bg-[#06040e]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
    <div class="bg-[#120c26] border border-purple-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(168,85,247,0.3)]">
      <span class="text-4xl animate-bounce">📜</span>
      <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">CODEX PURIFIED!</h2>
      <p class="text-xs text-slate-300 mb-4">All linguistic etymons successfully synthesized into coherent lexical roots!</p>
      
      <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#0a0618] p-3 rounded-xl border border-purple-500/20">
        <div>REWARD: <span class="text-purple-400 font-bold text-sm">+250 XP</span></div>
      </div>

      <button id="la-play-again" class="px-6 py-2.5 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
        PLAY AGAIN
      </button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  interface WordRecipe {
    root1: string;
    root2: string;
    result: string;
    definition: string;
  }

  const RECIPES: WordRecipe[] = [
    { root1: 'CHRONO', root2: 'GRAPH', result: 'CHRONOGRAPH', definition: '"An instrument for measuring and recording time"' },
    { root1: 'TELE', root2: 'SCOPE', result: 'TELESCOPE', definition: '"An optical instrument for viewing distant cosmic celestial objects"' },
    { root1: 'BIO', root2: 'LOGY', result: 'BIOLOGY', definition: '"The scientific study of life and living organism systems"' },
    { root1: 'GEO', root2: 'METRY', result: 'GEOMETRY', definition: '"Branch of math dealing with earth measurement and shapes"' }
  ];

  const ALL_ROOTS = [
    { root: 'CHRONO', desc: 'Time' },
    { root: 'GRAPH', desc: 'Write / Record' },
    { root: 'TELE', desc: 'Distant / Far' },
    { root: 'SCOPE', desc: 'Watch / View' },
    { root: 'BIO', desc: 'Life' },
    { root: 'LOGY', desc: 'Study / Doctrine' },
    { root: 'GEO', desc: 'Earth' },
    { root: 'METRY', desc: 'Measurement' }
  ];

  let currentTargetIdx = 0;
  let selectedRoots: string[] = [];
  let score = 0;

  const scoreEl = document.getElementById('la-score')!;
  const targetHintEl = document.getElementById('la-target-hint')!;
  const slot1El = document.getElementById('la-slot-1')!;
  const slot2El = document.getElementById('la-slot-2')!;
  const rootsContainer = document.getElementById('la-roots-container')!;
  const forgeBtn = document.getElementById('la-forge-btn')!;
  const clearBtn = document.getElementById('la-clear-btn')!;
  const victoryModal = document.getElementById('la-victory-modal')!;
  const playAgainBtn = document.getElementById('la-play-again')!;

  function init() {
    currentTargetIdx = 0;
    selectedRoots = [];
    score = 0;
    scoreEl.textContent = '0/4';
    victoryModal.classList.add('hidden');
    renderRoots();
    updateTarget();
  }

  function renderRoots() {
    rootsContainer.innerHTML = '';
    ALL_ROOTS.forEach(r => {
      const btn = document.createElement('button');
      const isSelected = selectedRoots.includes(r.root);
      btn.className = isSelected
        ? 'p-2.5 rounded-xl border border-purple-400 bg-purple-900/60 text-purple-200 text-left transition-all active:scale-95 shadow-[0_0_15px_rgba(168,85,247,0.3)]'
        : 'p-2.5 rounded-xl border border-purple-500/30 bg-[#160f2e] text-slate-300 text-left hover:border-purple-400/60 transition-all active:scale-95';
      btn.innerHTML = `<div class="font-bold text-xs text-white">${r.root}</div><div class="text-[10px] text-purple-400">${r.desc}</div>`;
      btn.addEventListener('click', () => toggleRoot(r.root));
      rootsContainer.appendChild(btn);
    });
  }

  function toggleRoot(r: string) {
    if (selectedRoots.includes(r)) {
      selectedRoots = selectedRoots.filter(x => x !== r);
    } else if (selectedRoots.length < 2) {
      selectedRoots.push(r);
      sound.click();
    }
    updateSlots();
    renderRoots();
  }

  function updateSlots() {
    slot1El.textContent = selectedRoots[0] || '?';
    slot2El.textContent = selectedRoots[1] || '?';
  }

  function updateTarget() {
    targetHintEl.textContent = RECIPES[currentTargetIdx].definition;
  }

  forgeBtn.addEventListener('click', () => {
    if (selectedRoots.length < 2) {
      sound.playTone(200, 'square', 0.1, 0.1);
      return;
    }

    const recipe = RECIPES[currentTargetIdx];
    const match = (selectedRoots[0] === recipe.root1 && selectedRoots[1] === recipe.root2) ||
                  (selectedRoots[0] === recipe.root2 && selectedRoots[1] === recipe.root1);

    if (match) {
      sound.victory();
      score++;
      scoreEl.textContent = `${score}/4`;
      selectedRoots = [];
      updateSlots();
      renderRoots();

      if (score >= 4) {
        launchConfetti();
        player.addXp(250);
        victoryModal.classList.remove('hidden');
      } else {
        currentTargetIdx++;
        updateTarget();
      }
    } else {
      sound.playTone(150, 'sawtooth', 0.2, 0.2);
    }
  });

  clearBtn.addEventListener('click', () => {
    selectedRoots = [];
    updateSlots();
    renderRoots();
    sound.click();
  });

  playAgainBtn.addEventListener('click', init);

  init();
</script>
