---
// MorphoFlora: Genetic Garden
---

<div id="flora-game" class="flex flex-col items-center justify-center p-3 select-none max-w-md mx-auto w-full">
  <!-- Stats Header -->
  <div class="mb-3 flex w-full items-center justify-between rounded-2xl border border-brand-border/60 bg-brand-dark/95 px-4 py-2.5 text-xs">
    <div>Purified: <span id="flora-cleansed" class="font-mono font-bold text-emerald-400">0/12</span></div>
    <div>Pollen: <span id="flora-pollen" class="font-mono font-bold text-brand-gold">100</span></div>
    <div>Generation: <span id="flora-gen" class="font-mono font-bold text-brand-neon">F1</span></div>
  </div>

  <div class="w-full text-center text-xs text-gray-400 mb-2">
    Plant and cross-breed alien flora to spread bioluminescent traits and purify dark spore blight!
  </div>

  <!-- Garden Hex Grid Canvas -->
  <div class="relative rounded-2xl border-2 border-brand-border overflow-hidden bg-black shadow-2xl">
    <canvas id="flora-canvas" width="360" height="360" class="block cursor-pointer touch-none"></canvas>

    <!-- Seed Selection Drawer -->
    <div class="absolute bottom-3 inset-x-3 flex items-center justify-between gap-1.5 bg-brand-dark/85 backdrop-blur-md p-2 rounded-xl border border-brand-border/60 text-xs">
      <button class="flora-seed-btn flex-1 py-1.5 rounded-lg border border-amber-500/60 bg-amber-950/40 text-amber-300 font-bold active:scale-95 text-[10px]" data-trait="lumen">
        ☀️ Solar (Light)
      </button>
      <button class="flora-seed-btn flex-1 py-1.5 rounded-lg border border-brand-border bg-brand-card text-gray-300 font-bold active:scale-95 text-[10px]" data-trait="aqua">
        💧 Aqua (Water)
      </button>
      <button class="flora-seed-btn flex-1 py-1.5 rounded-lg border border-brand-border bg-brand-card text-gray-300 font-bold active:scale-95 text-[10px]" data-trait="thorn">
        🌿 Thorn (Shield)
      </button>
    </div>

    <!-- Victory Overlay Modal -->
    <div id="flora-modal" class="hidden absolute inset-0 flex flex-col items-center justify-center bg-black/90 backdrop-blur-sm p-6 text-center">
      <span class="text-5xl animate-bounce">🌸</span>
      <h3 class="text-2xl font-black text-white mt-2">Garden Cleansed!</h3>
      <p class="text-xs text-gray-300 mt-1">All toxic spore blights purged through symbiotic plant genetics!</p>
      <div class="mt-2 text-xs font-mono text-brand-gold font-bold">+250 XP Awarded</div>
      <button id="flora-modal-btn" class="mt-4 rounded-2xl bg-brand-accent px-6 py-2.5 text-xs font-bold text-white shadow-lg hover:scale-105 active:scale-95 transition-transform cursor-pointer">
        Enter Next Biome →
      </button>
    </div>
  </div>

  <div class="mt-3 text-[11px] text-gray-400 text-center">
    Tap any soil tile to plant selected seed. Planting adjacent to other flora triggers genetic cross-pollination.
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('flora-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const cleansedEl = document.getElementById('flora-cleansed')!;
  const pollenEl = document.getElementById('flora-pollen')!;
  const genEl = document.getElementById('flora-gen')!;
  const modal = document.getElementById('flora-modal')!;
  const modalBtn = document.getElementById('flora-modal-btn')!;

  type Trait = 'lumen' | 'aqua' | 'thorn' | 'hybrid';

  interface HexTile {
    q: number;
    r: number;
    x: number;
    y: number;
    blighted: boolean;
    plant: { trait: Trait; power: number } | null;
  }

  interface PollenParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    color: string;
    alpha: number;
  }

  let selectedTrait: Trait = 'lumen';
  let pollen = 100;
  let generation = 1;
  let tiles: HexTile[] = [];
  let particles: PollenParticle[] = [];
  let isGameOver = false;

  const HEX_RADIUS = 28;
  const TRAIT_COLORS: Record<Trait, string> = {
    lumen: '#f59e0b',
    aqua: '#06b6d4',
    thorn: '#10b981',
    hybrid: '#ec4899'
  };

  function initGarden() {
    isGameOver = false;
    pollen = 100;
    generation = 1;
    tiles = [];
    particles = [];
    modal.classList.add('hidden');

    pollenEl.textContent = pollen.toString();
    genEl.textContent = 'F1';

    // Build hexagonal grid layout
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2 - 15;

    for (let q = -2; q <= 2; q++) {
      for (let r = -2; r <= 2; r++) {
        if (Math.abs(q + r) <= 2) {
          const x = centerX + HEX_RADIUS * Math.sqrt(3) * (q + r / 2);
          const y = centerY + HEX_RADIUS * (3 / 2) * r;
          const isBlight = Math.random() < 0.45;
          tiles.push({
            q,
            r,
            x,
            y,
            blighted: isBlight,
            plant: null
          });
        }
      }
    }

    updateStats();
    player.trackGamePlay('morphoflora');
  }

  function updateStats() {
    const totalBlighted = tiles.filter(t => t.blighted).length;
    cleansedEl.textContent = `${tiles.length - totalBlighted}/${tiles.length}`;
  }

  function plantAt(tile: HexTile) {
    if (pollen < 15 || tile.plant || isGameOver) return;
    sound.score();
    pollen -= 15;
    pollenEl.textContent = pollen.toString();

    // Check neighbors for cross-pollination
    const neighbors = tiles.filter(t => {
      const dq = Math.abs(t.q - tile.q);
      const dr = Math.abs(t.r - tile.r);
      const ds = Math.abs((t.q + t.r) - (tile.q + tile.r));
      return (dq <= 1 && dr <= 1 && ds <= 1) && t !== tile && t.plant !== null;
    });

    let resultingTrait: Trait = selectedTrait;
    if (neighbors.length > 0 && neighbors.some(n => n.plant?.trait !== selectedTrait)) {
      // Emergent Hybrid Vigor
      resultingTrait = 'hybrid';
      generation++;
      genEl.textContent = `F${generation}`;
    }

    tile.plant = {
      trait: resultingTrait,
      power: resultingTrait === 'hybrid' ? 3 : 1
    };

    tile.blighted = false;

    // Purify neighboring blighted hexes
    neighbors.forEach(n => {
      if (n.blighted) {
        n.blighted = false;
        // Purify spark particles
        for (let i = 0; i < 6; i++) {
          particles.push({
            x: n.x,
            y: n.y,
            vx: (Math.random() - 0.5) * 3,
            vy: (Math.random() - 0.5) * 3,
            color: '#34d399',
            alpha: 1
          });
        }
      }
    });

    updateStats();

    // Check Win
    if (tiles.every(t => !t.blighted)) {
      isGameOver = true;
      sound.victory();
      launchConfetti();
      player.addXP(250, 'MorphoFlora Genetic Purification Solved');
      modal.classList.remove('hidden');
    }
  }

  function loop() {
    // Update particles
    particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      p.alpha -= 0.03;
    });
    particles = particles.filter(p => p.alpha > 0);

    draw();
    requestAnimationFrame(loop);
  }

  function drawHex(x: number, y: number, r: number, fill: string, stroke: string) {
    ctx.fillStyle = fill;
    ctx.strokeStyle = stroke;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const angle = (Math.PI / 3) * i + Math.PI / 6;
      const hx = x + r * Math.cos(angle);
      const hy = y + r * Math.sin(angle);
      if (i === 0) ctx.moveTo(hx, hy);
      else ctx.lineTo(hx, hy);
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }

  function draw() {
    ctx.fillStyle = '#060a0f';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Draw Hex Tiles
    tiles.forEach(t => {
      const fill = t.blighted ? '#180f1e' : '#0f1f1d';
      const stroke = t.blighted ? '#701a75' : '#115e59';
      drawHex(t.x, t.y, HEX_RADIUS - 2, fill, stroke);

      // Blight spore smoke marker
      if (t.blighted) {
        ctx.fillStyle = '#c026d3';
        ctx.beginPath();
        ctx.arc(t.x, t.y, 4, 0, Math.PI * 2);
        ctx.fill();
      }

      // Draw Flower Plant
      if (t.plant) {
        ctx.fillStyle = TRAIT_COLORS[t.plant.trait];
        ctx.beginPath();
        ctx.arc(t.x, t.y, 9, 0, Math.PI * 2);
        ctx.fill();

        // Flower Petals
        for (let i = 0; i < 5; i++) {
          const a = (i / 5) * Math.PI * 2;
          ctx.beginPath();
          ctx.arc(t.x + Math.cos(a) * 8, t.y + Math.sin(a) * 8, 4, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(t.x, t.y, 3, 0, Math.PI * 2);
        ctx.fill();
      }
    });

    // Draw Pollen particles
    particles.forEach(p => {
      ctx.globalAlpha = p.alpha;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
  }

  // Seed trait buttons
  document.querySelectorAll('.flora-seed-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      sound.click();
      selectedTrait = (e.currentTarget as HTMLElement).dataset.trait as Trait;
      document.querySelectorAll('.flora-seed-btn').forEach(b => {
        b.className = 'flora-seed-btn flex-1 py-1.5 rounded-lg border border-brand-border bg-brand-card text-gray-300 font-bold active:scale-95 text-[10px]';
      });
      (e.currentTarget as HTMLElement).className = 'flora-seed-btn flex-1 py-1.5 rounded-lg border border-amber-500/60 bg-amber-950/40 text-amber-300 font-bold active:scale-95 text-[10px]';
    });
  });

  canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    const clickedTile = tiles.find(t => Math.hypot(t.x - x, t.y - y) < HEX_RADIUS);
    if (clickedTile) plantAt(clickedTile);
  });

  modalBtn.addEventListener('click', initGarden);

  initGarden();
  loop();
</script>
