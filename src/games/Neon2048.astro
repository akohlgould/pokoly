---
// 2048 Neon: Cyber Number Puzzle
---

<div id="game-2048" class="flex flex-col items-center justify-center p-4 select-none">
  <!-- Stats Header -->
  <div class="mb-4 flex w-full max-w-[340px] items-center justify-between rounded-xl border border-brand-border/60 bg-brand-dark/90 px-4 py-2.5 text-xs">
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Score:</span>
      <span id="score-2048" class="font-mono text-base font-bold text-brand-neon">0</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-gray-400">Best:</span>
      <span id="best-2048" class="font-mono text-base font-bold text-white">0</span>
    </div>
    <button id="restart-2048" class="rounded bg-brand-card px-2.5 py-1 text-xs text-gray-300 hover:text-white transition-colors border border-brand-border">
      Restart
    </button>
  </div>

  <!-- Board Container -->
  <div class="relative rounded-2xl border-2 border-brand-border bg-brand-dark p-3 shadow-2xl">
    <div id="board-2048" class="grid grid-cols-4 grid-rows-4 gap-2.5 w-[300px] h-[300px] sm:w-[340px] sm:h-[340px]">
      <!-- 16 cells generated by script -->
    </div>

    <!-- Overlay on Game Over -->
    <div id="overlay-2048" class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-brand-dark/90 backdrop-blur-sm p-4 text-center opacity-0 pointer-events-none transition-opacity duration-300">
      <h3 id="overlay-title-2048" class="font-display text-2xl font-bold text-white">Game Over!</h3>
      <p class="mt-1 text-xs text-gray-400">No more valid moves.</p>
      <button id="play-again-2048" class="mt-4 rounded-xl bg-brand-accent px-5 py-2 text-xs font-semibold text-white shadow-lg hover:scale-105 active:scale-95 transition-transform">
        Try Again
      </button>
    </div>
  </div>

  <div class="mt-3 text-[11px] text-gray-400">
    Swipe or use Arrow / WASD keys to slide
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  let board: number[][] = Array(4).fill(0).map(() => Array(4).fill(0));
  let score = 0;
  let best = parseInt(localStorage.getItem('pokoly_2048_best') || '0', 10);
  let hasWon = false;

  const boardEl = document.getElementById('board-2048')!;
  const scoreEl = document.getElementById('score-2048')!;
  const bestEl = document.getElementById('best-2048')!;
  const overlay = document.getElementById('overlay-2048')!;
  const overlayTitle = document.getElementById('overlay-title-2048')!;
  const playAgain = document.getElementById('play-again-2048')!;
  const restartBtn = document.getElementById('restart-2048')!;

  bestEl.textContent = best.toString();

  const TILE_COLORS: Record<number, string> = {
    2: 'bg-indigo-950 text-indigo-200 border-indigo-800',
    4: 'bg-indigo-900 text-indigo-100 border-indigo-700',
    8: 'bg-cyan-900 text-cyan-200 border-cyan-700 shadow-cyan-500/20',
    16: 'bg-cyan-800 text-cyan-100 border-cyan-600 shadow-cyan-500/30',
    32: 'bg-teal-800 text-teal-100 border-teal-500',
    64: 'bg-emerald-700 text-emerald-100 border-emerald-400',
    128: 'bg-amber-600 text-amber-100 border-amber-300 font-extrabold',
    256: 'bg-orange-600 text-orange-100 border-orange-300 font-extrabold',
    512: 'bg-rose-600 text-rose-100 border-rose-300 font-black',
    1024: 'bg-purple-600 text-purple-100 border-purple-300 font-black',
    2048: 'bg-gradient-to-r from-amber-400 via-pink-500 to-indigo-500 text-white font-black shadow-lg shadow-pink-500/50',
  };

  function spawnTile() {
    const emptyCells: { r: number; c: number }[] = [];
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        if (board[r][c] === 0) emptyCells.push({ r, c });
      }
    }
    if (emptyCells.length === 0) return;
    const choice = emptyCells[Math.floor(Math.random() * emptyCells.length)];
    board[choice.r][choice.c] = Math.random() < 0.9 ? 2 : 4;
  }

  function render() {
    boardEl.innerHTML = '';
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        const val = board[r][c];
        const cell = document.createElement('div');
        cell.className = 'flex items-center justify-center rounded-xl border transition-all duration-100 font-mono text-base sm:text-xl font-bold select-none';

        if (val === 0) {
          cell.className += ' bg-brand-card/40 border-brand-border/40';
        } else {
          const colorClass = TILE_COLORS[val] || 'bg-brand-neon text-brand-dark border-white';
          cell.className += ` ${colorClass} scale-100`;
          cell.textContent = val.toString();
        }
        boardEl.appendChild(cell);
      }
    }
    scoreEl.textContent = score.toString();
    if (score > best) {
      best = score;
      bestEl.textContent = best.toString();
      localStorage.setItem('pokoly_2048_best', best.toString());
    }
  }

  function slide(row: number[]) {
    let arr = row.filter(val => val !== 0);
    for (let i = 0; i < arr.length - 1; i++) {
      if (arr[i] === arr[i + 1]) {
        arr[i] *= 2;
        score += arr[i];
        if (arr[i] === 2048 && !hasWon) {
          hasWon = true;
          sound.victory();
          launchConfetti();
          player.unlockBadge('score_2048');
          player.addXP(500, '2048 Tile Merged');
        }
        arr.splice(i + 1, 1);
      }
    }
    while (arr.length < 4) {
      arr.push(0);
    }
    return arr;
  }

  function moveLeft() {
    let moved = false;
    for (let r = 0; r < 4; r++) {
      const orig = [...board[r]];
      board[r] = slide(board[r]);
      if (orig.some((v, idx) => v !== board[r][idx])) moved = true;
    }
    return moved;
  }

  function moveRight() {
    let moved = false;
    for (let r = 0; r < 4; r++) {
      const orig = [...board[r]];
      board[r] = slide(board[r].reverse()).reverse();
      if (orig.some((v, idx) => v !== board[r][idx])) moved = true;
    }
    return moved;
  }

  function moveUp() {
    let moved = false;
    for (let c = 0; c < 4; c++) {
      const col = [board[0][c], board[1][c], board[2][c], board[3][c]];
      const res = slide(col);
      for (let r = 0; r < 4; r++) {
        if (board[r][c] !== res[r]) moved = true;
        board[r][c] = res[r];
      }
    }
    return moved;
  }

  function moveDown() {
    let moved = false;
    for (let c = 0; c < 4; c++) {
      const col = [board[0][c], board[1][c], board[2][c], board[3][c]];
      const res = slide(col.reverse()).reverse();
      for (let r = 0; r < 4; r++) {
        if (board[r][c] !== res[r]) moved = true;
        board[r][c] = res[r];
      }
    }
    return moved;
  }

  function checkGameOver() {
    // Check if any empty cell exists
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        if (board[r][c] === 0) return false;
        if (c < 3 && board[r][c] === board[r][c + 1]) return false;
        if (r < 3 && board[r][c] === board[r + 1][c]) return false;
      }
    }
    return true;
  }

  function handleMove(dir: 'left' | 'right' | 'up' | 'down') {
    let moved = false;
    if (dir === 'left') moved = moveLeft();
    if (dir === 'right') moved = moveRight();
    if (dir === 'up') moved = moveUp();
    if (dir === 'down') moved = moveDown();

    if (moved) {
      sound.blip();
      spawnTile();
      render();

      if (checkGameOver()) {
        sound.gameOver();
        overlayTitle.textContent = 'Game Over!';
        overlay.classList.remove('opacity-0', 'pointer-events-none');
      }
    }
  }

  function init() {
    board = Array(4).fill(0).map(() => Array(4).fill(0));
    score = 0;
    hasWon = false;
    overlay.classList.add('opacity-0', 'pointer-events-none');
    spawnTile();
    spawnTile();
    render();
  }

  window.addEventListener('keydown', (e) => {
    if (['ArrowLeft', 'KeyA'].includes(e.code)) { e.preventDefault(); handleMove('left'); }
    if (['ArrowRight', 'KeyD'].includes(e.code)) { e.preventDefault(); handleMove('right'); }
    if (['ArrowUp', 'KeyW'].includes(e.code)) { e.preventDefault(); handleMove('up'); }
    if (['ArrowDown', 'KeyS'].includes(e.code)) { e.preventDefault(); handleMove('down'); }
  });

  // Touch Swipe
  let touchStartX = 0;
  let touchStartY = 0;
  boardEl.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  boardEl.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy)) {
      if (Math.abs(dx) > 30) handleMove(dx > 0 ? 'right' : 'left');
    } else {
      if (Math.abs(dy) > 30) handleMove(dy > 0 ? 'down' : 'up');
    }
  }, { passive: true });

  playAgain.addEventListener('click', init);
  restartBtn.addEventListener('click', init);

  const resetBtn = document.getElementById('btn-restart-game');
  if (resetBtn) resetBtn.addEventListener('click', init);

  init();
</script>
