---
// NeuroLink.astro - Axonal Action Potential & Synaptic Switch Routing
---
<div class="relative w-full h-[650px] bg-[#070913] rounded-2xl border border-indigo-500/30 overflow-hidden flex flex-col select-none font-mono text-indigo-100">
  <!-- HUD Header -->
  <div class="h-14 bg-indigo-950/80 border-b border-indigo-500/20 px-4 flex items-center justify-between text-xs sm:text-sm z-10 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 font-bold">
        🧠
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2">
          <span>NEUROLINK</span>
          <span id="cortex-badge" class="px-2 py-0.5 text-[10px] bg-indigo-500/20 text-indigo-300 rounded border border-indigo-500/40">CORTEX LOBE 1</span>
        </div>
        <div class="text-[10px] text-indigo-300/70">SYNAPTIC ACTION POTENTIAL ROUTER</div>
      </div>
    </div>

    <!-- Stats & Bandwidth -->
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2 bg-indigo-900/60 px-3 py-1 rounded-full border border-indigo-700/60">
        <span class="text-indigo-400 text-[11px]">SCORE:</span>
        <span id="score-display" class="text-white font-bold text-sm">0</span>
      </div>

      <div class="flex items-center gap-2 bg-indigo-900/60 px-3 py-1 rounded-full border border-indigo-700/60">
        <span class="text-indigo-400 text-[11px]">SYNAPSE INTEGRITY:</span>
        <div class="w-16 h-2.5 bg-slate-800 rounded-full overflow-hidden">
          <div id="integrity-bar" class="h-full bg-cyan-400 transition-all duration-200" style="width: 100%"></div>
        </div>
        <span id="integrity-pct" class="text-xs font-bold text-cyan-300">100%</span>
      </div>

      <div class="bg-indigo-900/60 px-3 py-1 rounded-full border border-indigo-700/60">
        <span class="text-indigo-400 text-[11px]">COMBO:</span>
        <span id="combo-display" class="text-amber-400 font-bold text-xs sm:text-sm">x1</span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <button id="reset-btn" class="px-2.5 py-1.5 bg-indigo-900/80 hover:bg-indigo-800 text-indigo-200 border border-indigo-600/60 rounded-lg text-xs transition-all">
        RESTART
      </button>
    </div>
  </div>

  <!-- Interactive Synapse Canvas -->
  <div class="relative flex-1 bg-[#060814] overflow-hidden flex items-center justify-center">
    <canvas id="neuro-canvas" class="w-full h-full cursor-pointer"></canvas>

    <!-- Bottom Controls & Hints -->
    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between pointer-events-none text-xs">
      <div class="bg-indigo-950/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-indigo-700/60 text-indigo-200 shadow-lg pointer-events-auto">
        <span class="text-cyan-400 font-bold">CLICK JUNCTION NODES:</span> Switch axon tracks to match impulse colors with receptor dendrites!
      </div>
      <div class="bg-indigo-950/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-indigo-700/60 text-indigo-200 shadow-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
        <span>ACh</span>
        <span class="w-2.5 h-2.5 rounded-full bg-pink-500 ml-2"></span>
        <span>Serotonin</span>
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 ml-2"></span>
        <span>Dopamine</span>
      </div>
    </div>

    <!-- Victory Modal -->
    <div id="victory-modal" class="absolute inset-0 bg-indigo-950/85 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-indigo-900/90 border border-indigo-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_50px_rgba(99,102,241,0.25)]">
        <div class="w-16 h-16 rounded-2xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-3xl mx-auto mb-4 animate-pulse">
          ⚡
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">NEURAL SYNCHRONY!</h2>
        <p class="text-xs sm:text-sm text-indigo-200 mb-4">Action potential waves successfully integrated into high-order consciousness.</p>
        <div class="flex justify-center gap-4 text-xs text-indigo-300 font-bold mb-6 bg-indigo-950/80 p-3 rounded-xl border border-indigo-800">
          <div>SCORE: <span id="stat-score" class="text-white">12,450</span></div>
          <div>MAX COMBO: <span id="stat-combo" class="text-amber-400">x8</span></div>
          <div>XP EARNED: <span class="text-emerald-400">+150 XP</span></div>
        </div>
        <div class="flex gap-3 justify-center">
          <button id="next-cortex-btn" class="px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-bold text-sm rounded-xl shadow-lg transition-all active:scale-95">
            NEXT CORTEX &rarr;
          </button>
          <button id="replay-btn" class="px-4 py-2.5 bg-indigo-950 hover:bg-indigo-900 text-indigo-200 text-sm rounded-xl border border-indigo-700 transition-all">
            REPLAY
          </button>
        </div>
      </div>
    </div>

    <!-- Synaptic Burnout Modal -->
    <div id="burnout-modal" class="absolute inset-0 bg-indigo-950/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-indigo-950 border border-red-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_50px_rgba(239,68,68,0.25)]">
        <div class="w-16 h-16 rounded-2xl bg-red-500/20 border border-red-500/40 flex items-center justify-center text-3xl mx-auto mb-4">
          ⚠️
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-red-400 mb-2">SYNAPTIC BURNOUT!</h2>
        <p class="text-xs sm:text-sm text-indigo-200 mb-6">Mismatched action potentials caused excitotoxicity and transmission collapse.</p>
        <button id="retry-burnout-btn" class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-bold text-sm rounded-xl transition-all shadow-lg">
          STABILIZE NEURAL NET
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('neuro-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const cortexBadge = document.getElementById('cortex-badge')!;
  const scoreDisplay = document.getElementById('score-display')!;
  const integrityBar = document.getElementById('integrity-bar')!;
  const integrityPct = document.getElementById('integrity-pct')!;
  const comboDisplay = document.getElementById('combo-display')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const victoryModal = document.getElementById('victory-modal')!;
  const burnoutModal = document.getElementById('burnout-modal')!;
  const nextCortexBtn = document.getElementById('next-cortex-btn')!;
  const replayBtn = document.getElementById('replay-btn')!;
  const retryBurnoutBtn = document.getElementById('retry-burnout-btn')!;
  const statScore = document.getElementById('stat-score')!;
  const statCombo = document.getElementById('stat-combo')!;

  const TYPES = [
    { name: 'ACh', color: '#06b6d4' },
    { name: 'Serotonin', color: '#ec4899' },
    { name: 'Dopamine', color: '#f59e0b' }
  ];

  interface AxonJunction {
    id: number;
    x: number;
    y: number;
    r: number;
    activeBranch: 0 | 1; // upper (0) or lower (1) branch
    label: string;
  }

  interface Impulse {
    id: number;
    typeIdx: number; // 0, 1, 2
    track: number; // 0: Top, 1: Mid, 2: Bot
    progress: number; // 0.0 to 1.0 along the pipeline
    speed: number;
  }

  interface ReceptorTerminal {
    id: number;
    y: number;
    typeIdx: number;
    label: string;
    pulses: number;
  }

  let currentLevel = 0;
  let score = 0;
  let integrity = 100;
  let combo = 1;
  let maxCombo = 1;
  let isGameOver = false;

  let junctions: AxonJunction[] = [];
  let terminals: ReceptorTerminal[] = [];
  let impulses: Impulse[] = [];
  let nextImpulseId = 0;
  let spawnTimer = 0;
  let impulsesDelivered = 0;
  let targetImpressions = 20;

  function resizeCanvas() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    setupLevelTopology();
  }

  function setupLevelTopology() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;

    // 4 Switch Junctions arranged in two sequential stages
    junctions = [
      { id: 0, x: w * 0.32, y: h * 0.35, r: 18, activeBranch: 0, label: 'J-1' },
      { id: 1, x: w * 0.32, y: h * 0.65, r: 18, activeBranch: 1, label: 'J-2' },
      { id: 2, x: w * 0.64, y: h * 0.28, r: 18, activeBranch: 0, label: 'J-3' },
      { id: 3, x: w * 0.64, y: h * 0.72, r: 18, activeBranch: 1, label: 'J-4' },
    ];

    // 3 Destination Terminals (Right side)
    terminals = [
      { id: 0, y: h * 0.2, typeIdx: 0, label: 'MOTOR (ACh)', pulses: 0 },
      { id: 1, y: h * 0.5, typeIdx: 1, label: 'LIMBIC (Serotonin)', pulses: 0 },
      { id: 2, y: h * 0.8, typeIdx: 2, label: 'PREFRONTAL (Dopamine)', pulses: 0 },
    ];
  }

  function initLevel(lvlIdx: number) {
    currentLevel = lvlIdx;
    score = 0;
    integrity = 100;
    combo = 1;
    maxCombo = 1;
    isGameOver = false;
    impulses = [];
    spawnTimer = 1.0;
    impulsesDelivered = 0;
    targetImpressions = 15 + lvlIdx * 5;

    cortexBadge.textContent = `CORTEX LOBE ${lvlIdx + 1}`;
    victoryModal.classList.add('hidden');
    burnoutModal.classList.add('hidden');

    setupLevelTopology();
    updateUI();
  }

  function toggleJunction(jIdx: number) {
    if (isGameOver) return;
    const j = junctions[jIdx];
    if (j) {
      j.activeBranch = j.activeBranch === 0 ? 1 : 0;
      sound.click();
    }
  }

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    for (let i = 0; i < junctions.length; i++) {
      const j = junctions[i];
      if (Math.hypot(x - j.x, y - j.y) <= j.r + 14) {
        toggleJunction(i);
        break;
      }
    }
  });

  resetBtn.addEventListener('click', () => {
    sound.click();
    initLevel(currentLevel);
  });
  nextCortexBtn.addEventListener('click', () => {
    sound.click();
    initLevel(currentLevel + 1);
  });
  replayBtn.addEventListener('click', () => {
    sound.click();
    initLevel(currentLevel);
  });
  retryBurnoutBtn.addEventListener('click', () => {
    sound.click();
    initLevel(currentLevel);
  });

  function updateUI() {
    scoreDisplay.textContent = score.toString();
    comboDisplay.textContent = `x${combo}`;
    integrityBar.style.width = `${Math.max(0, integrity)}%`;
    integrityPct.textContent = `${Math.round(integrity)}%`;

    if (integrity < 30) {
      integrityBar.className = 'h-full bg-red-500 transition-all duration-200 animate-pulse';
      integrityPct.className = 'text-xs font-bold text-red-400';
    } else {
      integrityBar.className = 'h-full bg-cyan-400 transition-all duration-200';
      integrityPct.className = 'text-xs font-bold text-cyan-300';
    }
  }

  // Calculate current (x, y) coordinates for an impulse given its progress (0 to 1)
  function getImpulsePosition(imp: Impulse): { x: number; y: number } {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const startX = 40;
    const startY = imp.track === 0 ? h * 0.35 : h * 0.65;

    // Segment 1: from Start (x=40) to Stage 1 Junctions (x=w*0.32)
    const j1 = imp.track === 0 ? junctions[0] : junctions[1];
    if (imp.progress < 0.32) {
      const t = imp.progress / 0.32;
      return {
        x: startX + (j1.x - startX) * t,
        y: startY + (j1.y - startY) * t
      };
    }

    // Segment 2: from Stage 1 Junctions to Stage 2 Junctions (x=w*0.64)
    const nextJ = j1.activeBranch === 0 ? junctions[2] : junctions[3];
    if (imp.progress < 0.64) {
      const t = (imp.progress - 0.32) / 0.32;
      return {
        x: j1.x + (nextJ.x - j1.x) * t,
        y: j1.y + (nextJ.y - j1.y) * t
      };
    }

    // Segment 3: from Stage 2 Junction to Terminals (x=w-50)
    // Destination terminal depends on activeBranch of nextJ
    let termIdx = 1;
    if (nextJ.id === 2) {
      termIdx = nextJ.activeBranch === 0 ? 0 : 1;
    } else {
      termIdx = nextJ.activeBranch === 0 ? 1 : 2;
    }

    const term = terminals[termIdx];
    const t = (imp.progress - 0.64) / 0.36;
    return {
      x: nextJ.x + ((w - 60) - nextJ.x) * t,
      y: nextJ.y + (term.y - nextJ.y) * t
    };
  }

  let lastTime = performance.now();
  function gameLoop(now: number) {
    const dt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;

    if (!isGameOver) {
      // Spawn new impulses
      spawnTimer -= dt;
      if (spawnTimer <= 0 && impulsesDelivered + impulses.length < targetImpressions) {
        spawnTimer = Math.max(1.1, 2.2 - currentLevel * 0.25);
        impulses.push({
          id: nextImpulseId++,
          typeIdx: Math.floor(Math.random() * 3),
          track: Math.random() < 0.5 ? 0 : 1,
          progress: 0,
          speed: 0.16 + currentLevel * 0.03
        });
      }

      // Update active impulses
      for (let i = impulses.length - 1; i >= 0; i--) {
        const imp = impulses[i];
        imp.progress += imp.speed * dt;

        // Reached destination
        if (imp.progress >= 1.0) {
          // Resolve terminal match
          const j1 = imp.track === 0 ? junctions[0] : junctions[1];
          const nextJ = j1.activeBranch === 0 ? junctions[2] : junctions[3];
          let termIdx = 1;
          if (nextJ.id === 2) {
            termIdx = nextJ.activeBranch === 0 ? 0 : 1;
          } else {
            termIdx = nextJ.activeBranch === 0 ? 1 : 2;
          }

          const targetTerm = terminals[termIdx];
          if (targetTerm.typeIdx === imp.typeIdx) {
            // Correct match!
            sound.score();
            combo++;
            maxCombo = Math.max(maxCombo, combo);
            score += 100 * combo;
            targetTerm.pulses++;
          } else {
            // Mismatch! Excitotoxicity penalty
            sound.hit();
            combo = 1;
            integrity = Math.max(0, integrity - 20);
          }

          impulsesDelivered++;
          impulses.splice(i, 1);
          updateUI();

          // Check burnout
          if (integrity <= 0) {
            triggerBurnout();
            break;
          }

          // Check win
          if (impulsesDelivered >= targetImpressions && impulses.length === 0) {
            triggerVictory();
            break;
          }
        }
      }
    }

    render(now);
    requestAnimationFrame(gameLoop);
  }

  function triggerVictory() {
    isGameOver = true;
    sound.powerup();
    launchConfetti();
    player.addXP(150);

    statScore.textContent = score.toString();
    statCombo.textContent = `x${maxCombo}`;
    victoryModal.classList.remove('hidden');
  }

  function triggerBurnout() {
    isGameOver = true;
    sound.fail();
    burnoutModal.classList.remove('hidden');
  }

  function render(time: number) {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    ctx.clearRect(0, 0, w, h);

    // Render Dendrite Background Web
    ctx.strokeStyle = 'rgba(79, 70, 229, 0.08)';
    ctx.lineWidth = 1;
    for (let y = 50; y < h; y += 40) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.bezierCurveTo(w * 0.3, y + Math.sin(y) * 30, w * 0.7, y - Math.cos(y) * 30, w, y);
      ctx.stroke();
    }

    // Render Axon pathways
    const drawAxon = (x1: number, y1: number, x2: number, y2: number, active: boolean) => {
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.strokeStyle = active ? 'rgba(99, 102, 241, 0.8)' : 'rgba(51, 65, 85, 0.3)';
      ctx.lineWidth = active ? 4 : 2;
      ctx.stroke();
    };

    if (junctions.length >= 4) {
      // Inputs to Stage 1
      drawAxon(40, h * 0.35, junctions[0].x, junctions[0].y, true);
      drawAxon(40, h * 0.65, junctions[1].x, junctions[1].y, true);

      // Stage 1 to Stage 2
      drawAxon(junctions[0].x, junctions[0].y, junctions[2].x, junctions[2].y, junctions[0].activeBranch === 0);
      drawAxon(junctions[0].x, junctions[0].y, junctions[3].x, junctions[3].y, junctions[0].activeBranch === 1);

      drawAxon(junctions[1].x, junctions[1].y, junctions[2].x, junctions[2].y, junctions[1].activeBranch === 0);
      drawAxon(junctions[1].x, junctions[1].y, junctions[3].x, junctions[3].y, junctions[1].activeBranch === 1);

      // Stage 2 to Terminals
      if (terminals.length >= 3) {
        drawAxon(junctions[2].x, junctions[2].y, w - 60, terminals[0].y, junctions[2].activeBranch === 0);
        drawAxon(junctions[2].x, junctions[2].y, w - 60, terminals[1].y, junctions[2].activeBranch === 1);

        drawAxon(junctions[3].x, junctions[3].y, w - 60, terminals[1].y, junctions[3].activeBranch === 0);
        drawAxon(junctions[3].x, junctions[3].y, w - 60, terminals[2].y, junctions[3].activeBranch === 1);
      }
    }

    // Render Terminals (Right side)
    for (const term of terminals) {
      const col = TYPES[term.typeIdx].color;
      ctx.save();
      ctx.beginPath();
      ctx.arc(w - 60, term.y, 22, 0, Math.PI * 2);
      ctx.fillStyle = `${col}22`;
      ctx.fill();
      ctx.strokeStyle = col;
      ctx.lineWidth = 3;
      ctx.stroke();

      ctx.fillStyle = col;
      ctx.font = 'bold 11px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(term.label, w - 90, term.y + 4);
      ctx.restore();
    }

    // Render Junction Switches
    for (let i = 0; i < junctions.length; i++) {
      const j = junctions[i];
      ctx.save();
      ctx.beginPath();
      ctx.arc(j.x, j.y, j.r, 0, Math.PI * 2);
      ctx.fillStyle = '#1e1b4b';
      ctx.fill();
      ctx.strokeStyle = '#6366f1';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Branch arrow
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(j.x - 8, j.y);
      ctx.lineTo(j.x + 8, j.activeBranch === 0 ? j.y - 7 : j.y + 7);
      ctx.stroke();

      ctx.fillStyle = '#94a3b8';
      ctx.font = 'bold 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(j.label, j.x, j.y - 24);
      ctx.restore();
    }

    // Render Impulses
    for (const imp of impulses) {
      const pos = getImpulsePosition(imp);
      const col = TYPES[imp.typeIdx].color;

      ctx.save();
      // Outer aura
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 10 + Math.sin(time / 80) * 2, 0, Math.PI * 2);
      ctx.fillStyle = `${col}44`;
      ctx.fill();

      // Glowing core
      ctx.beginPath();
      ctx.arc(pos.x, pos.y, 6, 0, Math.PI * 2);
      ctx.fillStyle = col;
      ctx.shadowColor = col;
      ctx.shadowBlur = 12;
      ctx.fill();
      ctx.restore();
    }
  }

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
  initLevel(0);
  requestAnimationFrame(gameLoop);
</script>
