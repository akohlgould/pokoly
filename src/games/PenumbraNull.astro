  <div class="h-14 bg-slate-900/95 border-b border-cyan-500/20 px-4 flex items-center justify-between text-xs sm:text-sm z-20 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 font-bold shadow-inner">
        🌑
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2">
          <span>PENUMBRA NULL</span>
          <span id="sector-badge" class="px-2 py-0.5 text-[10px] bg-cyan-500/20 text-cyan-300 rounded border border-cyan-500/40">SECTOR 1: HELIOS PRIME</span>
        </div>
        <div class="text-[10px] text-cyan-400/70">LIGHT IS VACUUM &bull; SHADOW IS MATTER</div>
      </div>
    </div>

    <!-- Center Gauges: Ablation Buffer & Harvest Quota -->
