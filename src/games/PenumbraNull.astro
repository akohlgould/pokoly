      <div class="bg-slate-950/85 backdrop-blur-md px-3.5 py-2 rounded-xl border border-cyan-500/30 text-slate-200 shadow-2xl pointer-events-auto flex items-center gap-3">
        <div class="flex items-center gap-2">
          <span class="px-1.5 py-0.5 bg-cyan-500/20 text-cyan-300 rounded text-[10px] font-bold border border-cyan-500/40">AIM</span>
