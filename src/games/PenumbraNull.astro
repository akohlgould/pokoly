        <span class="text-slate-400 text-[11px] font-bold">ABLATION:</span>
        <div class="w-24 sm:w-28 h-2.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700">
          <div id="ablation-bar" class="h-full bg-cyan-400 rounded-full transition-all duration-75 shadow-[0_0_8px_#22d3ee]" style="width: 100%"></div>
        </div>
        <span id="ablation-pct" class="text-xs font-bold text-cyan-300 min-w-[36px]">100%</span>
      </div>

      <!-- Lux Harvest Progress -->
      <div class="hidden sm:flex items-center gap-2 bg-slate-950/80 px-3 py-1.5 rounded-full border border-slate-700/80">
        <span class="text-amber-400 text-[11px] font-bold">LUX HARVEST:</span>
        <div class="w-20 h-2 bg-slate-800 rounded-full overflow-hidden border border-slate-700">
          <div id="harvest-bar" class="h-full bg-amber-400 rounded-full transition-all duration-150 shadow-[0_0_6px_#f59e0b]" style="width: 0%"></div>
        </div>
        <span id="harvest-text" class="text-xs font-bold text-amber-300">0/100</span>
      </div>

      <!-- Score -->
      <div class="flex items-center gap-1.5 bg-slate-950/80 px-3 py-1.5 rounded-full border border-slate-700/80">
        <span class="text-slate-400 text-[11px]">SCORE:</span>
        <span id="score-text" class="text-white font-bold text-xs sm:text-sm">0</span>
      </div>
    </div>

    <!-- Actions & Sound Toggle -->
    <div class="flex items-center gap-2">
      <button id="sound-btn" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-600 rounded-lg text-xs transition-all flex items-center gap-1">
        <span id="sound-icon">🔊</span>
      </button>
      <button id="reset-btn" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 rounded-lg text-xs transition-all">
        RESET
      </button>
    </div>
  </div>

  <!-- Game Arena Viewport -->
  <div class="relative flex-1 bg-[#f8fafc] overflow-hidden flex items-center justify-center">
    <canvas id="penumbra-canvas" class="w-full h-full cursor-crosshair touch-none"></canvas>

    <!-- Exposure Alert Overlay (Flashes red when player is in raw lethal light) -->
