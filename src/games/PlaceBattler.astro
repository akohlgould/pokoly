---
// PlaceBattler.astro - r/Place Pixel Canvas Defense Arcade
---

<div id="place-container" class="relative w-full max-w-4xl mx-auto bg-[#07080e] rounded-2xl overflow-hidden border border-red-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(239,68,68,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0c0d16]/95 border-b border-red-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/40 flex items-center justify-center text-red-400 font-bold text-xl shadow-[0_0_15px_rgba(239,68,68,0.3)]">
        🟥
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-red-400 via-orange-300 to-yellow-400 bg-clip-text text-transparent font-black">PLACE BATTLER</span>
          <span class="px-2 py-0.5 text-[10px] bg-red-500/20 text-red-300 rounded-md border border-red-500/40">CANVAS WAR</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">DEFEND THE SACRED ARTWORK &bull; REPEL THE VOID</div>
      </div>
    </div>

    <!-- Center Metric: Canvas Integrity -->
    <div class="flex items-center gap-4 bg-[#0a0b12] px-4 py-1.5 rounded-xl border border-red-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">INTEGRITY:</span>
        <span id="pb-integrity" class="font-bold text-emerald-400 font-mono ml-1 text-sm">100%</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">TIME:</span>
        <span id="pb-timer" class="font-bold text-white font-mono ml-1 text-sm">30s</span>
      </div>
    </div>

    <button id="pb-bomb-btn" class="px-3 py-1.5 bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold rounded-xl text-xs transition-all active:scale-95 shadow-md">
      PURGE BOMB (1)
    </button>
  </div>

  <!-- Main Canvas -->
  <div class="p-6 flex flex-col items-center justify-center gap-4 min-h-[460px]">
    <!-- Color Palette -->
    <div class="flex items-center gap-2">
      <span class="text-[11px] text-slate-400 font-bold mr-1">PALETTE:</span>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#ffffff] border-2 border-white shadow-md" data-color="#ffffff"></button>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#ff4500] border-2 border-transparent" data-color="#ff4500"></button>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#ffa800] border-2 border-transparent" data-color="#ffa800"></button>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#ffd635] border-2 border-transparent" data-color="#ffd635"></button>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#00a368] border-2 border-transparent" data-color="#00a368"></button>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#3690ea] border-2 border-transparent" data-color="#3690ea"></button>
      <button class="pb-color-btn w-7 h-7 rounded-lg bg-[#b44ac0] border-2 border-transparent" data-color="#b44ac0"></button>
    </div>

    <!-- 16x16 Pixel Grid Canvas -->
    <canvas id="pb-canvas" width="360" height="360" class="border-4 border-slate-700 rounded-xl shadow-2xl block touch-none cursor-crosshair"></canvas>
  </div>

  <!-- Victory Modal -->
  <div id="pb-victory-modal" class="absolute inset-0 bg-[#04050a]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
    <div class="bg-[#121424] border border-red-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(239,68,68,0.3)]">
      <span class="text-4xl animate-bounce">🎨</span>
      <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">CANVAS PRESERVED!</h2>
      <p class="text-xs text-slate-300 mb-4">Your community artwork stood the test of time and defeated The Void!</p>
      
      <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#080914] p-3 rounded-xl border border-red-500/20">
        <div>REWARD: <span class="text-red-400 font-bold text-sm">+250 XP</span></div>
      </div>

      <button id="pb-next-btn" class="px-6 py-2.5 bg-gradient-to-r from-red-500 to-orange-500 text-white font-bold text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
        DEFEND NEXT SECTOR &rarr;
      </button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('pb-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const integrityEl = document.getElementById('pb-integrity')!;
  const timerEl = document.getElementById('pb-timer')!;
  const bombBtn = document.getElementById('pb-bomb-btn')!;
  const victoryModal = document.getElementById('pb-victory-modal')!;
  const nextBtn = document.getElementById('pb-next-btn')!;

  const GRID_SIZE = 16;
  let currentColor = '#ffffff';
  let pixels: string[] = [];
  let targetArt: string[] = [];
  let bombsLeft = 1;
  let timeLeft = 30;
  let isWon = false;

  function init() {
    isWon = false;
    bombsLeft = 1;
    timeLeft = 30;
    bombBtn.textContent = "PURGE BOMB (1)";
    victoryModal.classList.add('hidden');

    pixels = new Array(GRID_SIZE * GRID_SIZE).fill('#ffffff');
    targetArt = new Array(GRID_SIZE * GRID_SIZE).fill('#ffffff');

    // Create target Heart / Snoo artwork in center
    for (let r = 0; r < GRID_SIZE; r++) {
      for (let c = 0; c < GRID_SIZE; c++) {
        // Red heart pattern
        if ((r === 4 && (c === 5 || c === 6 || c === 9 || c === 10)) ||
            (r === 5 && c >= 4 && c <= 11) ||
            (r === 6 && c >= 4 && c <= 11) ||
            (r === 7 && c >= 5 && c <= 10) ||
            (r === 8 && c >= 6 && c <= 9) ||
            (r === 9 && (c === 7 || c === 8))) {
          targetArt[r * GRID_SIZE + c] = '#ff4500';
          pixels[r * GRID_SIZE + c] = '#ff4500';
        }
      }
    }
  }

  function tick() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const cellW = canvas.width / GRID_SIZE;
    const cellH = canvas.height / GRID_SIZE;

    // The Void Attacks! Random black pixels strike
    if (Math.random() < 0.25 && !isWon) {
      const corruptIdx = Math.floor(Math.random() * pixels.length);
      pixels[corruptIdx] = '#000000'; // The void
    }

    // Render 16x16 grid
    for (let r = 0; r < GRID_SIZE; r++) {
      for (let c = 0; c < GRID_SIZE; c++) {
        ctx.fillStyle = pixels[r * GRID_SIZE + c];
        ctx.fillRect(c * cellW, r * cellH, cellW, cellH);
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 0.5;
        ctx.strokeRect(c * cellW, r * cellH, cellW, cellH);
      }
    }

    // Calculate integrity
    let matchCount = 0;
    for (let i = 0; i < pixels.length; i++) {
      if (pixels[i] === targetArt[i]) matchCount++;
    }
    const integrity = Math.round((matchCount / pixels.length) * 100);
    integrityEl.textContent = `${integrity}%`;

    if (!isWon) {
      timeLeft -= 0.016;
      timerEl.textContent = `${Math.max(0, Math.ceil(timeLeft))}s`;

      if (timeLeft <= 0) {
        if (integrity >= 75) {
          isWon = true;
          sound.victory();
          launchConfetti();
          player.addXp(250);
          victoryModal.classList.remove('hidden');
        } else {
          init();
        }
      }
    }

    requestAnimationFrame(tick);
  }

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const cellW = rect.width / GRID_SIZE;
    const cellH = rect.height / GRID_SIZE;
    const c = Math.floor((e.clientX - rect.left) / cellW);
    const r = Math.floor((e.clientY - rect.top) / cellH);

    if (c >= 0 && c < GRID_SIZE && r >= 0 && r < GRID_SIZE) {
      pixels[r * GRID_SIZE + c] = currentColor;
      sound.blip();
    }
  });

  document.querySelectorAll('.pb-color-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      currentColor = (e.currentTarget as HTMLElement).getAttribute('data-color') || '#ffffff';
      document.querySelectorAll('.pb-color-btn').forEach(b => b.classList.replace('border-white', 'border-transparent'));
      (e.currentTarget as HTMLElement).classList.replace('border-transparent', 'border-white');
      sound.click();
    });
  });

  bombBtn.addEventListener('click', () => {
    if (bombsLeft > 0) {
      bombsLeft--;
      bombBtn.textContent = "PURGE BOMB (0)";
      // Restore all corrupted pixels to targetArt
      pixels = [...targetArt];
      sound.score();
    }
  });

  nextBtn.addEventListener('click', init);

  init();
  requestAnimationFrame(tick);
</script>
