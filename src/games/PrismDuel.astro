---
// PrismDuel.astro - Chromatic Laser Refraction & Polarization Optics
---

<div id="prism-container" class="relative w-full max-w-4xl mx-auto bg-[#070912] rounded-2xl overflow-hidden border border-fuchsia-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(217,70,239,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0c0e1e]/95 border-b border-fuchsia-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/40 flex items-center justify-center text-fuchsia-400 font-bold text-xl shadow-[0_0_15px_rgba(217,70,239,0.3)]">
        💎
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-fuchsia-400 via-pink-300 to-cyan-400 bg-clip-text text-transparent font-black">PRISM DUEL</span>
          <span class="px-2 py-0.5 text-[10px] bg-fuchsia-500/20 text-fuchsia-300 rounded-md border border-fuchsia-500/40">CHROMATIC OPTICS</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">BEAM SPLITTING &bull; REFRACTIVE POLARIZATION</div>
      </div>
    </div>

    <!-- Center Targets -->
    <div class="flex items-center gap-4 bg-[#0a0c1a] px-4 py-1.5 rounded-xl border border-fuchsia-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">RED CORE:</span>
        <span id="pd-red" class="font-bold text-rose-400 font-mono ml-1 text-sm">LOCKED</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">BLUE CORE:</span>
        <span id="pd-blue" class="font-bold text-cyan-400 font-mono ml-1 text-sm">UNLOCKED</span>
      </div>
    </div>

    <button id="pd-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      REALIGN
    </button>
  </div>

  <!-- Main Canvas Playfield -->
  <div class="relative w-full h-[460px] sm:h-[500px] bg-[#03050c] overflow-hidden flex items-center justify-center">
    <canvas id="pd-canvas" class="w-full h-full block touch-none cursor-pointer"></canvas>

    <div class="absolute top-4 left-4 max-w-xs pointer-events-none bg-[#090b16]/80 backdrop-blur-md p-3 rounded-xl border border-fuchsia-500/20 text-[11px] text-slate-300 shadow-lg">
      <span class="text-fuchsia-400 font-bold">TACTICAL OPTICS:</span>
      <span class="text-white ml-1">Click mirrors and prisms to rotate them 45°. Split the white laser beam and route Red to the Red Sensor and Blue to the Blue Sensor!</span>
    </div>

    <!-- Victory Modal -->
    <div id="pd-victory-modal" class="absolute inset-0 bg-[#03050c]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-[#0f1124] border border-fuchsia-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(217,70,239,0.3)]">
        <span class="text-4xl animate-bounce">🌈</span>
        <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">SPECTRUM HARMONIZED!</h2>
        <p class="text-xs text-slate-300 mb-4">Both Red and Blue wavelengths aligned simultaneously with pure chromatic fidelity!</p>
        
        <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#080916] p-3 rounded-xl border border-fuchsia-500/20">
          <div>REWARD: <span class="text-fuchsia-400 font-bold text-sm">+250 XP</span></div>
        </div>

        <button id="pd-next-btn" class="px-6 py-2.5 bg-gradient-to-r from-fuchsia-500 to-cyan-500 text-white font-bold text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
          NEXT OPTICAL CHAMBER &rarr;
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('pd-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const redEl = document.getElementById('pd-red')!;
  const blueEl = document.getElementById('pd-blue')!;
  const victoryModal = document.getElementById('pd-victory-modal')!;
  const nextBtn = document.getElementById('pd-next-btn')!;
  const resetBtn = document.getElementById('pd-reset-btn')!;

  interface OpticalNode {
    r: number;
    c: number;
    type: 'prism' | 'mirror';
    angle: number; // 0, 45, 90, 135 deg
  }

  const GRID_SIZE = 5;
  let nodes: OpticalNode[] = [];
  let isWon = false;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
  }

  function getLogicalSize() {
    const rect = canvas.getBoundingClientRect();
    return { width: rect.width, height: rect.height };
  }

  function init() {
    isWon = false;
    redEl.textContent = "LOCKED";
    blueEl.textContent = "LOCKED";
    victoryModal.classList.add('hidden');

    nodes = [
      { r: 2, c: 1, type: 'prism', angle: 45 },
      { r: 1, c: 3, type: 'mirror', angle: 90 },
      { r: 3, c: 3, type: 'mirror', angle: 0 },
    ];
  }

  function tick() {
    const { width, height } = getLogicalSize();
    ctx.clearRect(0, 0, width, height);

    ctx.fillStyle = '#050711';
    ctx.fillRect(0, 0, width, height);

    const cellW = width / GRID_SIZE;
    const cellH = height / GRID_SIZE;

    // Draw Grid Lines
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 1;
    for (let i = 0; i <= GRID_SIZE; i++) {
      ctx.beginPath();
      ctx.moveTo(i * cellW, 0); ctx.lineTo(i * cellW, height);
      ctx.moveTo(0, i * cellH); ctx.lineTo(width, i * cellH);
      ctx.stroke();
    }

    // Laser Source at (2, 0)
    const srcX = 0;
    const srcY = 2.5 * cellH;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, srcY - 8, 24, 16);

    // Red Target at (1, 4), Blue Target at (3, 4)
    const redTgtX = 4.5 * cellW;
    const redTgtY = 1.5 * cellH;
    const blueTgtX = 4.5 * cellW;
    const blueTgtY = 3.5 * cellH;

    ctx.fillStyle = '#ef4444';
    ctx.beginPath(); ctx.arc(redTgtX, redTgtY, 18, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#06b6d4';
    ctx.beginPath(); ctx.arc(blueTgtX, blueTgtY, 18, 0, Math.PI * 2); ctx.fill();

    // Laser Tracing
    const prism = nodes.find(n => n.type === 'prism')!;
    const prismX = (prism.c + 0.5) * cellW;
    const prismY = (prism.r + 0.5) * cellH;

    // White incident beam
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(srcX, srcY);
    ctx.lineTo(prismX, prismY);
    ctx.stroke();

    // Split beams from prism
    const redAngle = prism.angle === 45 ? -Math.PI / 4 : 0;
    const blueAngle = prism.angle === 45 ? Math.PI / 4 : Math.PI / 2;

    const m1 = nodes.find(n => n.r === 1 && n.c === 3)!;
    const m2 = nodes.find(n => n.r === 3 && n.c === 3)!;

    const m1X = (m1.c + 0.5) * cellW;
    const m1Y = (m1.r + 0.5) * cellH;
    const m2X = (m2.c + 0.5) * cellW;
    const m2Y = (m2.r + 0.5) * cellH;

    // Red beam path
    ctx.strokeStyle = '#ef4444';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(prismX, prismY);
    ctx.lineTo(m1X, m1Y);
    if (m1.angle === 90) {
      ctx.lineTo(redTgtX, redTgtY);
      redEl.textContent = "CONNECTED";
      redEl.className = "font-bold text-rose-400 font-mono ml-1 text-sm animate-pulse";
    }
    ctx.stroke();

    // Blue beam path
    ctx.strokeStyle = '#06b6d4';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(prismX, prismY);
    ctx.lineTo(m2X, m2Y);
    if (m2.angle === 0) {
      ctx.lineTo(blueTgtX, blueTgtY);
      blueEl.textContent = "CONNECTED";
      blueEl.className = "font-bold text-cyan-400 font-mono ml-1 text-sm animate-pulse";
    }
    ctx.stroke();

    // Check Win Condition
    if (m1.angle === 90 && m2.angle === 0 && !isWon) {
      isWon = true;
      sound.victory();
      launchConfetti();
      player.addXp(250);
      victoryModal.classList.remove('hidden');
    }

    // Draw Optical Elements
    nodes.forEach(n => {
      const cx = (n.c + 0.5) * cellW;
      const cy = (n.r + 0.5) * cellH;

      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate((n.angle * Math.PI) / 180);

      if (n.type === 'prism') {
        ctx.beginPath();
        ctx.moveTo(0, -22);
        ctx.lineTo(20, 18);
        ctx.lineTo(-20, 18);
        ctx.closePath();
        ctx.fillStyle = 'rgba(217, 70, 239, 0.4)';
        ctx.fill();
        ctx.strokeStyle = '#d946ef';
        ctx.lineWidth = 2.5;
        ctx.stroke();
      } else {
        // Mirror bar
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 6;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(-20, 0);
        ctx.lineTo(20, 0);
        ctx.stroke();
      }

      ctx.restore();
    });

    requestAnimationFrame(tick);
  }

  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const cellW = rect.width / GRID_SIZE;
    const cellH = rect.height / GRID_SIZE;
    const c = Math.floor((e.clientX - rect.left) / cellW);
    const r = Math.floor((e.clientY - rect.top) / cellH);

    const hit = nodes.find(n => n.r === r && n.c === c);
    if (hit) {
      hit.angle = (hit.angle + 45) % 180;
      sound.click();
    }
  });

  resetBtn.addEventListener('click', init);
  nextBtn.addEventListener('click', init);
  window.addEventListener('resize', resize);

  resize();
  init();
  requestAnimationFrame(tick);
</script>
