---
// RegexLabyrinth.astro - Hacker Terminal Syntax Bug Hunter
---

<div id="regex-container" class="relative w-full max-w-4xl mx-auto bg-[#040806] rounded-2xl overflow-hidden border border-emerald-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(16,185,129,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#08120c]/95 border-b border-emerald-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-bold text-xl shadow-[0_0_15px_rgba(16,185,129,0.3)]">
        👾
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-green-400 bg-clip-text text-transparent font-black">REGEX LABYRINTH</span>
          <span class="px-2 py-0.5 text-[10px] bg-emerald-500/20 text-emerald-300 rounded-md border border-emerald-500/40">PROD HOTFIX</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">REGULAR EXPRESSION PATTERN COMPILER</div>
      </div>
    </div>

    <!-- Center Metric: Stack Health -->
    <div class="flex items-center gap-4 bg-[#061009] px-4 py-1.5 rounded-xl border border-emerald-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">BUGS PURGED:</span>
        <span id="rl-purged" class="font-bold text-emerald-400 font-mono ml-1 text-sm">0/8</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">STACK OVERFLOW:</span>
        <span id="rl-stack" class="font-bold text-emerald-400 font-mono ml-1 text-sm">0%</span>
      </div>
    </div>

    <button id="rl-clear-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      CLEAR PATTERN
    </button>
  </div>

  <!-- Terminal Display & Matcher -->
  <div class="p-6 flex flex-col items-center justify-center gap-5 min-h-[460px]">
    <!-- Active Bugs Conveyor -->
    <div class="w-full max-w-xl bg-[#08140c] p-4 rounded-xl border border-emerald-500/30 shadow-inner">
      <div class="text-[10px] text-emerald-400 font-bold uppercase mb-2">RUNNING INCOMING BUG THREADS:</div>
      <div id="rl-bugs-list" class="flex flex-wrap gap-2 min-h-[48px]">
        <!-- Injected active bug badges -->
      </div>
    </div>

    <!-- Regex Pattern Compiler Box -->
    <div class="w-full max-w-xl bg-[#020503] p-4 rounded-xl border-2 border-emerald-500/50 flex items-center justify-between gap-3 shadow-lg">
      <div class="flex items-center gap-1 font-mono text-base sm:text-lg text-emerald-300 overflow-x-auto">
        <span class="text-emerald-500 font-bold">/</span>
        <span id="rl-compiled-pattern" class="font-bold tracking-wide text-white">^err_\d+$</span>
        <span class="text-emerald-500 font-bold">/g</span>
      </div>
      <button id="rl-exec-btn" class="px-6 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all cursor-pointer">
        COMPILE & EXECUTE ⚡
      </button>
    </div>

    <!-- Syntax Token Drawer -->
    <div class="w-full max-w-xl">
      <div class="text-xs text-slate-400 text-center mb-2">CLICK REGEX TOKENS TO CONSTRUCT MATCH FILTER:</div>
      <div class="flex flex-wrap justify-center gap-2">
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="^">^ (Start)</button>
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="err_">err_</button>
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="\d+">\d+ (Digits)</button>
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="leak_">leak_</button>
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="[0-9a-f]+">[0-9a-f]+ (Hex)</button>
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="null_ptr">null_ptr</button>
        <button class="rl-token-btn px-3 py-1.5 rounded-lg border border-emerald-500/40 bg-[#091a10] text-emerald-300 font-bold text-xs hover:border-emerald-400" data-token="$">$ (End)</button>
      </div>
    </div>
  </div>

  <!-- Victory Modal -->
  <div id="rl-victory-modal" class="absolute inset-0 bg-[#020503]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
    <div class="bg-[#091a10] border border-emerald-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(16,185,129,0.3)]">
      <span class="text-4xl animate-bounce">⚡</span>
      <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">HOTFIX DEPLOYED!</h2>
      <p class="text-xs text-slate-300 mb-4">All rogue memory leaks and exception bugs purged from production!</p>
      
      <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#040d08] p-3 rounded-xl border border-emerald-500/20">
        <div>REWARD: <span class="text-emerald-400 font-bold text-sm">+250 XP</span></div>
      </div>

      <button id="rl-play-again" class="px-6 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
        NEXT SPRINT &rarr;
      </button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const bugsListEl = document.getElementById('rl-bugs-list')!;
  const compiledPatternEl = document.getElementById('rl-compiled-pattern')!;
  const purgedEl = document.getElementById('rl-purged')!;
  const execBtn = document.getElementById('rl-exec-btn')!;
  const clearBtn = document.getElementById('rl-clear-btn')!;
  const victoryModal = document.getElementById('rl-victory-modal')!;
  const playAgainBtn = document.getElementById('rl-play-again')!;

  const AVAILABLE_BUGS = ['err_404', 'err_500', 'err_502', 'leak_0x7f', 'leak_0xbc', 'null_ptr', 'err_200'];
  let activeBugs: string[] = [];
  let userTokens: string[] = [];
  let purgedCount = 0;
  let isWon = false;

  function init() {
    isWon = false;
    purgedCount = 0;
    userTokens = ['^', 'err_', '\\d+', '$'];
    purgedEl.textContent = '0/8';
    victoryModal.classList.add('hidden');
    updatePattern();

    activeBugs = ['err_404', 'leak_0x7f', 'err_500', 'null_ptr', 'err_502', 'leak_0xbc'];
    renderBugs();
  }

  function renderBugs() {
    bugsListEl.innerHTML = '';
    activeBugs.forEach(b => {
      const badge = document.createElement('span');
      badge.className = 'px-3 py-1 bg-red-950/60 border border-red-500/40 text-red-300 font-mono text-xs rounded-lg flex items-center gap-1.5';
      badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>${b}`;
      bugsListEl.appendChild(badge);
    });
  }

  function updatePattern() {
    compiledPatternEl.textContent = userTokens.join('') || '(empty)';
  }

  document.querySelectorAll('.rl-token-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const tok = (e.currentTarget as HTMLElement).getAttribute('data-token') || '';
      userTokens.push(tok);
      updatePattern();
      sound.click();
    });
  });

  clearBtn.addEventListener('click', () => {
    userTokens = [];
    updatePattern();
    sound.click();
  });

  execBtn.addEventListener('click', () => {
    try {
      const raw = userTokens.join('');
      const regex = new RegExp(raw);
      let killed = 0;

      activeBugs = activeBugs.filter(b => {
        if (regex.test(b)) {
          killed++;
          return false;
        }
        return true;
      });

      if (killed > 0) {
        sound.score();
        purgedCount += killed;
        purgedEl.textContent = `${purgedCount}/8`;
        renderBugs();

        if (purgedCount >= 6) {
          isWon = true;
          sound.victory();
          launchConfetti();
          player.addXp(250);
          victoryModal.classList.remove('hidden');
        }
      } else {
        sound.playTone(150, 'sawtooth', 0.2, 0.2);
      }
    } catch (_) {
      sound.playTone(120, 'square', 0.2, 0.2);
    }
  });

  playAgainBtn.addEventListener('click', init);

  init();
</script>
