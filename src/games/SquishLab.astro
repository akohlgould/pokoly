---
// SquishLab.astro - Oddly Satisfying Hydraulic Press Destruction
---

<div id="squish-container" class="relative w-full max-w-4xl mx-auto bg-[#0a0808] rounded-2xl overflow-hidden border border-red-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(239,68,68,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#120d0d]/95 border-b border-red-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/40 flex items-center justify-center text-red-400 font-bold text-xl shadow-[0_0_15px_rgba(239,68,68,0.3)]">
        🔨
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-red-500 via-orange-400 to-amber-300 bg-clip-text text-transparent font-black">SQUISH LAB</span>
          <span class="px-2 py-0.5 text-[10px] bg-red-500/20 text-red-300 rounded-md border border-red-500/40">HYDRAULIC PRESS</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">ODDLY SATISFYING &bull; 10,000 PSI DESTRUCTION</div>
      </div>
    </div>

    <!-- Center Metric: Pressure Gauge -->
    <div class="flex items-center gap-4 bg-[#0e0a0a] px-4 py-1.5 rounded-xl border border-red-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">HYDRAULIC PRESSURE:</span>
        <span id="sl-psi" class="font-bold text-red-400 font-mono ml-1 text-sm">0 PSI</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">SMASHED:</span>
        <span id="sl-smashed" class="font-bold text-amber-400 font-mono ml-1 text-sm">0/3</span>
      </div>
    </div>

    <button id="sl-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      NEW ITEM
    </button>
  </div>

  <!-- Main Canvas Playfield -->
  <div class="relative w-full h-[460px] sm:h-[500px] bg-[#050404] overflow-hidden flex items-center justify-center">
    <canvas id="sl-canvas" class="w-full h-full block touch-none cursor-ns-resize"></canvas>

    <!-- Material Selector Drawer -->
    <div class="absolute bottom-4 inset-x-6 flex items-center justify-between gap-3 z-20">
      <button class="sl-mat-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-amber-500/60 bg-amber-950/60 text-amber-300 font-bold active:scale-95 text-xs transition-all" data-type="duck">
        🦆 RUBBER DUCK
      </button>
      <button class="sl-mat-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-cyan-500/60 bg-cyan-950/40 text-cyan-300 font-bold active:scale-95 text-xs transition-all" data-type="diamond">
        💎 DIAMOND BLOCK
      </button>
      <button class="sl-mat-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-emerald-500/60 bg-emerald-950/40 text-emerald-300 font-bold active:scale-95 text-xs transition-all" data-type="slime">
        🟢 SLIME BALL
      </button>
    </div>

    <!-- Victory Modal -->
    <div id="sl-victory-modal" class="absolute inset-0 bg-[#050404]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-[#140c0c] border border-red-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(239,68,68,0.3)]">
        <span class="text-4xl animate-bounce">💥</span>
        <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">CATASTROPHIC ODDLY SATISFYING!</h2>
        <p class="text-xs text-slate-300 mb-4">Complete ductile structural collapse achieved. High-pressure destruction verified!</p>
        
        <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#0a0606] p-3 rounded-xl border border-red-500/20">
          <div>REWARD: <span class="text-amber-400 font-bold text-sm">+250 XP</span></div>
        </div>

        <button id="sl-play-again" class="px-6 py-2.5 bg-gradient-to-r from-red-500 to-amber-500 text-slate-950 font-black text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
          CRUSH ANOTHER &rarr;
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('sl-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const psiEl = document.getElementById('sl-psi')!;
  const smashedEl = document.getElementById('sl-smashed')!;
  const victoryModal = document.getElementById('sl-victory-modal')!;
  const playAgainBtn = document.getElementById('sl-play-again')!;
  const resetBtn = document.getElementById('sl-reset-btn')!;

  type MaterialType = 'duck' | 'diamond' | 'slime';
  let activeMaterial: MaterialType = 'duck';

  let pressY = 60; // Piston Y coordinate (60 to 320)
  let isDragging = false;
  let particles: { x: number; y: number; vx: number; vy: number; color: string; size: number }[] = [];
  let smashedCount = 0;
  let isCrushed = false;
  let isWon = false;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
  }

  function getLogicalSize() {
    const rect = canvas.getBoundingClientRect();
    return { width: rect.width, height: rect.height };
  }

  function init() {
    pressY = 60;
    particles = [];
    isCrushed = false;
    psiEl.textContent = '0 PSI';
    victoryModal.classList.add('hidden');
  }

  function tick() {
    const { width, height } = getLogicalSize();
    ctx.clearRect(0, 0, width, height);

    ctx.fillStyle = '#060404';
    ctx.fillRect(0, 0, width, height);

    const anvilY = height * 0.75;
    const cx = width / 2;

    // Draw Bottom Hardened Steel Anvil Block
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(cx - 140, anvilY, 280, 80);
    ctx.strokeStyle = '#475569';
    ctx.lineWidth = 3;
    ctx.strokeRect(cx - 140, anvilY, 280, 80);

    // Compute Compression Ratio
    const itemHeight = Math.max(12, anvilY - pressY);
    const squishScale = Math.min(1, itemHeight / 120);
    const spreadScale = 1 + (1 - squishScale) * 2.2;
    const psi = Math.round((1 - squishScale) * 10000);
    psiEl.textContent = `${psi} PSI`;

    // Draw Squishing Item
    if (!isCrushed) {
      ctx.save();
      ctx.translate(cx, anvilY);
      ctx.scale(spreadScale, squishScale);

      if (activeMaterial === 'duck') {
        ctx.fillStyle = '#facc15';
        ctx.beginPath();
        ctx.ellipse(0, -60, 45, 55, 0, 0, Math.PI * 2);
        ctx.fill();
        // Beak
        ctx.fillStyle = '#ea580c';
        ctx.beginPath();
        ctx.moveTo(35, -65); ctx.lineTo(60, -58); ctx.lineTo(35, -50); ctx.fill();
      } else if (activeMaterial === 'diamond') {
        ctx.fillStyle = '#38bdf8';
        ctx.fillRect(-45, -90, 90, 90);
      } else {
        ctx.fillStyle = '#22c55e';
        ctx.beginPath();
        ctx.arc(0, -55, 50, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
    }

    // Catastrophic failure at > 9200 PSI
    if (psi > 9200 && !isCrushed) {
      isCrushed = true;
      smashedCount++;
      smashedEl.textContent = `${smashedCount}/3`;
      sound.playTone(80, 'sawtooth', 0.4, 0.3);

      // Explode into crunchy particles
      const color = activeMaterial === 'duck' ? '#facc15' : (activeMaterial === 'diamond' ? '#38bdf8' : '#22c55e');
      for (let i = 0; i < 90; i++) {
        particles.push({
          x: cx + (Math.random() - 0.5) * 60,
          y: anvilY - 10,
          vx: (Math.random() - 0.5) * 16,
          vy: -Math.random() * 12,
          color,
          size: 3 + Math.random() * 4
        });
      }

      if (smashedCount >= 3 && !isWon) {
        isWon = true;
        sound.victory();
        launchConfetti();
        player.addXp(250);
        victoryModal.classList.remove('hidden');
      }
    }

    // Update Particles
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.5; // Gravity
      ctx.fillStyle = p.color;
      ctx.fillRect(p.x, p.y, p.size, p.size);
      if (p.y > height) particles.splice(i, 1);
    }

    // Draw Descending Hydraulic Steel Piston
    ctx.fillStyle = '#334155';
    ctx.fillRect(cx - 120, 0, 240, pressY);
    ctx.strokeStyle = '#64748b';
    ctx.lineWidth = 4;
    ctx.strokeRect(cx - 120, 0, 240, pressY);

    // Heavy Piston Head Face
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(cx - 130, pressY - 14, 260, 14);

    requestAnimationFrame(tick);
  }

  canvas.addEventListener('pointerdown', (e) => {
    isDragging = true;
  });

  window.addEventListener('pointermove', (e) => {
    if (isDragging) {
      const rect = canvas.getBoundingClientRect();
      const anvilY = rect.height * 0.75;
      pressY = Math.max(60, Math.min(anvilY - 10, e.clientY - rect.top));
    }
  });

  window.addEventListener('pointerup', () => { isDragging = false; });

  document.querySelectorAll('.sl-mat-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      activeMaterial = (e.currentTarget as HTMLElement).getAttribute('data-type') as MaterialType;
      init();
      sound.click();
    });
  });

  resetBtn.addEventListener('click', init);
  playAgainBtn.addEventListener('click', () => {
    smashedCount = 0;
    smashedEl.textContent = '0/3';
    isWon = false;
    init();
  });
  window.addEventListener('resize', resize);

  resize();
  init();
  requestAnimationFrame(tick);
</script>
