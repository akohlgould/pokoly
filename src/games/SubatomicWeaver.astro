---
// SubatomicWeaver.astro - Relativistic Quark Collider & Hadron Synthesis
---

<div id="quark-container" class="relative w-full max-w-4xl mx-auto bg-[#050711] rounded-2xl overflow-hidden border border-emerald-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(16,185,129,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0a0f22]/95 border-b border-emerald-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-bold text-xl shadow-[0_0_15px_rgba(16,185,129,0.3)]">
        ⚛️
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent font-black">SUBATOMIC WEAVER</span>
          <span class="px-2 py-0.5 text-[10px] bg-emerald-500/20 text-emerald-300 rounded-md border border-emerald-500/40">QUARK COLLIDER</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">HADRON CONFINEMENT &bull; LORENTZ DEFLECTION</div>
      </div>
    </div>

    <!-- Center Gauge: Nucleons Synthesized -->
    <div class="flex items-center gap-4 bg-[#080d1e] px-4 py-1.5 rounded-xl border border-emerald-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">PROTONS:</span>
        <span id="sw-protons" class="font-bold text-emerald-400 font-mono ml-1 text-sm">0/2</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">NEUTRONS:</span>
        <span id="sw-neutrons" class="font-bold text-cyan-400 font-mono ml-1 text-sm">0/2</span>
      </div>
    </div>

    <button id="sw-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      FLUSH CHAMBER
    </button>
  </div>

  <!-- Main Canvas -->
  <div class="relative w-full h-[460px] sm:h-[500px] bg-[#03050c] overflow-hidden flex items-center justify-center">
    <canvas id="sw-canvas" class="w-full h-full block touch-none cursor-crosshair"></canvas>

    <!-- Quark Injector Tray -->
    <div class="absolute bottom-4 inset-x-4 sm:inset-x-24 flex items-center justify-between gap-3 z-20">
      <button id="sw-inject-up" class="flex-1 py-2 sm:py-2.5 rounded-xl border border-emerald-500/60 bg-emerald-950/60 text-emerald-300 font-bold active:scale-95 text-xs transition-all shadow-[0_0_20px_rgba(16,185,129,0.3)]">
        🟢 INJECT UP QUARK (+2/3) [U]
      </button>
      <button id="sw-inject-down" class="flex-1 py-2 sm:py-2.5 rounded-xl border border-cyan-500/60 bg-cyan-950/40 text-cyan-300 font-bold active:scale-95 text-xs transition-all" data-type="down">
        🔵 INJECT DOWN QUARK (-1/3) [D]
      </button>
    </div>

    <!-- Victory Modal -->
    <div id="sw-victory-modal" class="absolute inset-0 bg-[#03050c]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-[#0b1022] border border-emerald-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(16,185,129,0.3)]">
        <span class="text-4xl animate-bounce">🌟</span>
        <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">HELIUM NUCLEUS FUSED!</h2>
        <p class="text-xs text-slate-300 mb-4">Stable Hadronic confinement achieved. Relativistic collider stabilized!</p>
        
        <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#060a16] p-3 rounded-xl border border-emerald-500/20">
          <div>REWARD: <span class="text-emerald-400 font-bold text-sm">+250 XP</span></div>
        </div>

        <button id="sw-next-btn" class="px-6 py-2.5 bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-black text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
          NEXT SYNTHESIS &rarr;
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('sw-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const protonsEl = document.getElementById('sw-protons')!;
  const neutronsEl = document.getElementById('sw-neutrons')!;
  const injectUpBtn = document.getElementById('sw-inject-up')!;
  const injectDownBtn = document.getElementById('sw-inject-down')!;
  const victoryModal = document.getElementById('sw-victory-modal')!;
  const nextBtn = document.getElementById('sw-next-btn')!;
  const resetBtn = document.getElementById('sw-reset-btn')!;

  type QuarkFlavor = 'up' | 'down';
  interface Quark {
    x: number;
    y: number;
    vx: number;
    vy: number;
    flavor: QuarkFlavor;
    charge: number;
  }

  let quarks: Quark[] = [];
  let protons = 0;
  let neutrons = 0;
  let magnetField = 0; // Lorentz field adjusted by mouse
  let isWon = false;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
  }

  function getLogicalSize() {
    const rect = canvas.getBoundingClientRect();
    return { width: rect.width, height: rect.height };
  }

  function init() {
    quarks = [];
    protons = 0;
    neutrons = 0;
    isWon = false;
    protonsEl.textContent = '0/2';
    neutronsEl.textContent = '0/2';
    victoryModal.classList.add('hidden');
  }

  function injectQuark(flavor: QuarkFlavor) {
    const { width, height } = getLogicalSize();
    quarks.push({
      x: 30,
      y: height / 2,
      vx: 4 + Math.random() * 2,
      vy: (Math.random() - 0.5) * 2,
      flavor,
      charge: flavor === 'up' ? 2/3 : -1/3
    });
    sound.blip();
  }

  function tick() {
    const { width, height } = getLogicalSize();
    ctx.clearRect(0, 0, width, height);

    // Collider Vacuum Ring
    ctx.fillStyle = '#04060e';
    ctx.fillRect(0, 0, width, height);

    const cx = width / 2;
    const cy = height / 2;
    const ringRadius = Math.min(width, height) * 0.38;

    // Confinement Ring Track
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 42;
    ctx.beginPath();
    ctx.arc(cx, cy, ringRadius, 0, Math.PI * 2);
    ctx.stroke();

    ctx.strokeStyle = '#0284c7';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(cx, cy, ringRadius - 20, 0, Math.PI * 2);
    ctx.arc(cx, cy, ringRadius + 20, 0, Math.PI * 2);
    ctx.stroke();

    // Central Fusion Core
    ctx.beginPath();
    ctx.arc(cx, cy, 32, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(16, 185, 129, 0.15)';
    ctx.fill();
    ctx.strokeStyle = '#10b981';
    ctx.lineWidth = 2;
    ctx.stroke();

    // Update Quarks
    quarks.forEach(q => {
      // Lorentz deflection towards ring center
      const dx = cx - q.x;
      const dy = cy - q.y;
      const dist = Math.hypot(dx, dy);

      // Centripetal magnetic steering
      const fx = (dx / dist) * 0.12 * q.charge;
      const fy = (dy / dist) * 0.12 * q.charge;

      q.vx += fx;
      q.vy += fy;

      q.x += q.vx;
      q.y += q.vy;

      // Draw Quark
      ctx.beginPath();
      ctx.arc(q.x, q.y, 8, 0, Math.PI * 2);
      ctx.fillStyle = q.flavor === 'up' ? '#10b981' : '#06b6d4';
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    });

    // Collision & Hadron Fusion Check
    for (let i = 0; i < quarks.length; i++) {
      for (let j = i + 1; j < quarks.length; j++) {
        for (let k = j + 1; k < quarks.length; k++) {
          const q1 = quarks[i], q2 = quarks[j], q3 = quarks[k];
          const d12 = Math.hypot(q1.x - q2.x, q1.y - q2.y);
          const d23 = Math.hypot(q2.x - q3.x, q2.y - q3.y);
          if (d12 < 20 && d23 < 20) {
            const upCount = [q1, q2, q3].filter(q => q.flavor === 'up').length;
            const downCount = [q1, q2, q3].filter(q => q.flavor === 'down').length;

            if (upCount === 2 && downCount === 1) {
              // Proton formed!
              protons++;
              quarks.splice(k, 1);
              quarks.splice(j, 1);
              quarks.splice(i, 1);
              sound.score();
              protonsEl.textContent = `${protons}/2`;
              break;
            } else if (upCount === 1 && downCount === 2) {
              // Neutron formed!
              neutrons++;
              quarks.splice(k, 1);
              quarks.splice(j, 1);
              quarks.splice(i, 1);
              sound.score();
              neutronsEl.textContent = `${neutrons}/2`;
              break;
            }
          }
        }
      }
    }

    // Check Victory (Helium Nucleus: 2 Protons + 2 Neutrons)
    if (protons >= 2 && neutrons >= 2 && !isWon) {
      isWon = true;
      sound.victory();
      launchConfetti();
      player.addXp(250);
      victoryModal.classList.remove('hidden');
    }

    requestAnimationFrame(tick);
  }

  injectUpBtn.addEventListener('click', () => injectQuark('up'));
  injectDownBtn.addEventListener('click', () => injectQuark('down'));
  resetBtn.addEventListener('click', init);
  nextBtn.addEventListener('click', init);
  window.addEventListener('resize', resize);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'u' || e.key === 'U') injectQuark('up');
    else if (e.key === 'd' || e.key === 'D') injectQuark('down');
  });

  resize();
  init();
  requestAnimationFrame(tick);
</script>
