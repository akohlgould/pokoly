---
// Sudoku Modern: Daily Logic
---

<div id="sudoku-app" class="flex flex-col items-center justify-center p-3 select-none w-full max-w-xl mx-auto">
  <!-- Stats Header -->
  <div class="mb-3 flex w-full items-center justify-between rounded-2xl border border-brand-border/60 bg-brand-dark/95 px-4 py-2.5 text-xs">
    <div class="flex items-center gap-2">
      <span class="text-gray-400">Difficulty:</span>
      <select id="sudoku-diff" class="rounded-lg bg-brand-card border border-brand-border px-2 py-1 text-xs text-white font-bold outline-none cursor-pointer">
        <option value="easy">Easy</option>
        <option value="medium" selected>Medium</option>
        <option value="hard">Hard</option>
      </select>
    </div>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1">
        <span class="text-gray-400">Mistakes:</span>
        <span id="sudoku-mistakes" class="font-mono font-bold text-red-400">0/3</span>
      </div>
      <div class="flex items-center gap-1 font-mono text-amber-400 font-bold">
        <span>⏱</span>
        <span id="sudoku-timer">00:00</span>
      </div>
    </div>

    <button id="sudoku-new-btn" class="rounded-xl border border-brand-border bg-brand-card px-3 py-1 text-xs text-gray-300 hover:text-white transition-colors">
      New Game
    </button>
  </div>

  <!-- 9x9 Sudoku Board Container -->
  <div class="relative overflow-hidden rounded-2xl border-2 border-brand-border bg-brand-dark p-2 sm:p-3 shadow-2xl">
    <div id="sudoku-grid" class="grid grid-cols-9 gap-[2px] bg-brand-border/60 p-[2px] rounded-xl">
      <!-- 81 cells generated by script -->
    </div>

    <!-- Victory Overlay -->
    <div id="sudoku-win-modal" class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-brand-dark/95 backdrop-blur-md p-6 text-center opacity-0 pointer-events-none transition-all duration-300">
      <span class="text-5xl animate-bounce">🧩</span>
      <h3 class="font-display text-2xl font-bold text-white mt-2">Sudoku Solved!</h3>
      <p class="mt-1 text-xs text-gray-300">Completed in <span id="sudoku-final-time" class="font-mono font-bold text-brand-neon">00:00</span></p>
      <div class="mt-2 text-xs text-emerald-400 font-bold">+250 XP Claimed</div>
      <button id="sudoku-win-replay" class="mt-4 rounded-xl bg-brand-accent px-6 py-2.5 font-bold text-white shadow-lg hover:scale-105 active:scale-95 transition-transform">
        Play Another
      </button>
    </div>

    <!-- Game Over Overlay -->
    <div id="sudoku-lose-modal" class="absolute inset-0 flex flex-col items-center justify-center rounded-2xl bg-brand-dark/95 backdrop-blur-md p-6 text-center opacity-0 pointer-events-none transition-all duration-300">
      <span class="text-5xl">💥</span>
      <h3 class="font-display text-2xl font-bold text-white mt-2">3 Mistakes Reached</h3>
      <p class="mt-1 text-xs text-gray-400">Better luck on the next puzzle!</p>
      <button id="sudoku-lose-replay" class="mt-4 rounded-xl bg-brand-card border border-brand-border px-6 py-2.5 font-bold text-white hover:border-brand-neon transition-colors">
        Try Again
      </button>
    </div>
  </div>

  <!-- Controls Action Bar: Notes toggle, Erase, Hint -->
  <div class="mt-3 flex w-full items-center justify-between gap-2 max-w-sm">
    <button id="sudoku-notes-btn" class="flex-1 flex items-center justify-center gap-1.5 rounded-xl border border-brand-border bg-brand-card py-2 text-xs font-semibold text-gray-300 hover:border-brand-neon transition-all">
      <span>✏️</span>
      <span>Notes: <span id="notes-status" class="text-gray-400 font-bold">OFF</span></span>
    </button>
    <button id="sudoku-erase-btn" class="flex-1 flex items-center justify-center gap-1.5 rounded-xl border border-brand-border bg-brand-card py-2 text-xs font-semibold text-gray-300 hover:border-brand-neon transition-all">
      <span>⌫</span>
      <span>Erase</span>
    </button>
    <button id="sudoku-hint-btn" class="flex-1 flex items-center justify-center gap-1.5 rounded-xl border border-brand-border bg-brand-card py-2 text-xs font-semibold text-amber-400 hover:border-amber-400 transition-all">
      <span>💡</span>
      <span>Hint (3)</span>
    </button>
  </div>

  <!-- Digits Pad (1-9) -->
  <div class="mt-3 grid grid-cols-9 gap-1.5 w-full max-w-sm">
    {Array.from({ length: 9 }, (_, i) => i + 1).map(num => (
      <button
        class="sudoku-num-btn h-12 rounded-xl border border-brand-border/70 bg-brand-card font-mono text-base font-black text-white hover:border-brand-neon hover:bg-brand-neon hover:text-brand-dark active:scale-95 transition-all shadow-sm"
        data-num={num}
      >
        {num}
      </button>
    ))}
  </div>

  <div class="mt-3 text-[11px] text-gray-400 text-center">
    Keyboard: Use <span class="font-mono text-brand-neon">1-9</span> to enter, <span class="font-mono text-brand-neon">Arrows</span> to navigate, <span class="font-mono text-brand-neon">N</span> to toggle pencil notes.
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  interface CellState {
    row: number;
    col: number;
    val: number;
    solution: number;
    initial: boolean;
    notes: Set<number>;
    isError: boolean;
  }

  // Pre-validated base puzzles with multiple valid transformations (row/col permutation + rotation)
  const BASE_PUZZLE = [
    [5, 3, 4, 6, 7, 8, 9, 1, 2],
    [6, 7, 2, 1, 9, 5, 3, 4, 8],
    [1, 9, 8, 3, 4, 2, 5, 6, 7],
    [8, 5, 9, 7, 6, 1, 4, 2, 3],
    [4, 2, 6, 8, 5, 3, 7, 9, 1],
    [7, 1, 3, 9, 2, 4, 8, 5, 6],
    [9, 6, 1, 5, 3, 7, 2, 8, 4],
    [2, 8, 7, 4, 1, 9, 6, 3, 5],
    [3, 4, 5, 2, 8, 6, 1, 7, 9]
  ];

  function generateSudoku(cluesCount: number): { puzzle: number[][]; solution: number[][] } {
    // Generate isomorphic solution by permuting numbers
    const perm = [1, 2, 3, 4, 5, 6, 7, 8, 9].sort(() => Math.random() - 0.5);
    const solution = BASE_PUZZLE.map(row => row.map(val => perm[val - 1]));

    // Randomly swap bands (groups of 3 rows)
    const bandOrder = [0, 1, 2].sort(() => Math.random() - 0.5);
    const swappedRows: number[][] = [];
    bandOrder.forEach(b => {
      const rows = [0, 1, 2].sort(() => Math.random() - 0.5);
      rows.forEach(r => swappedRows.push(solution[b * 3 + r]));
    });

    const puzzle = swappedRows.map(row => [...row]);
    const totalCells = 81;
    const toRemove = totalCells - cluesCount;

    const positions: [number, number][] = [];
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        positions.push([r, c]);
      }
    }
    positions.sort(() => Math.random() - 0.5);

    for (let i = 0; i < toRemove; i++) {
      const [r, c] = positions[i];
      puzzle[r][c] = 0;
    }

    return { puzzle, solution: swappedRows };
  }

  let board: CellState[][] = [];
  let selectedRow = 0;
  let selectedCol = 0;
  let isNotesMode = false;
  let mistakes = 0;
  let hintsLeft = 3;
  let isGameOver = false;
  let seconds = 0;
  let timerInterval: any = null;

  const gridEl = document.getElementById('sudoku-grid')!;
  const diffSelect = document.getElementById('sudoku-diff') as HTMLSelectElement;
  const mistakesEl = document.getElementById('sudoku-mistakes')!;
  const timerEl = document.getElementById('sudoku-timer')!;
  const newBtn = document.getElementById('sudoku-new-btn')!;
  const notesBtn = document.getElementById('sudoku-notes-btn')!;
  const notesStatusEl = document.getElementById('notes-status')!;
  const eraseBtn = document.getElementById('sudoku-erase-btn')!;
  const hintBtn = document.getElementById('sudoku-hint-btn')!;
  const winModal = document.getElementById('sudoku-win-modal')!;
  const winReplay = document.getElementById('sudoku-win-replay')!;
  const loseModal = document.getElementById('sudoku-lose-modal')!;
  const loseReplay = document.getElementById('sudoku-lose-replay')!;
  const finalTimeEl = document.getElementById('sudoku-final-time')!;

  function startTimer() {
    clearInterval(timerInterval);
    seconds = 0;
    timerInterval = setInterval(() => {
      if (isGameOver) return;
      seconds++;
      const m = String(Math.floor(seconds / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      timerEl.textContent = `${m}:${s}`;
    }, 1000);
  }

  function initGame() {
    isGameOver = false;
    mistakes = 0;
    hintsLeft = 3;
    isNotesMode = false;
    notesStatusEl.textContent = 'OFF';
    notesBtn.classList.remove('border-brand-neon', 'bg-brand-neon/20');
    mistakesEl.textContent = '0/3';
    hintBtn.textContent = '💡 Hint (3)';
    winModal.classList.add('opacity-0', 'pointer-events-none');
    loseModal.classList.add('opacity-0', 'pointer-events-none');

    const diff = diffSelect.value;
    const clues = diff === 'easy' ? 42 : diff === 'hard' ? 28 : 34;
    const { puzzle, solution } = generateSudoku(clues);

    board = [];
    for (let r = 0; r < 9; r++) {
      const rowArr: CellState[] = [];
      for (let c = 0; c < 9; c++) {
        const val = puzzle[r][c];
        rowArr.push({
          row: r,
          col: c,
          val,
          solution: solution[r][c],
          initial: val !== 0,
          notes: new Set(),
          isError: false
        });
      }
      board.push(rowArr);
    }

    selectedRow = 0;
    selectedCol = 0;
    startTimer();
    render();
    player.trackGamePlay('sudoku');
  }

  function render() {
    gridEl.innerHTML = '';
    const selectedCell = board[selectedRow]?.[selectedCol];
    const targetVal = selectedCell?.val || 0;

    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const cell = board[r][c];
        const isSelected = r === selectedRow && c === selectedCol;
        const isPeer = r === selectedRow || c === selectedCol || (Math.floor(r / 3) === Math.floor(selectedRow / 3) && Math.floor(c / 3) === Math.floor(selectedCol / 3));
        const isSameNum = targetVal > 0 && cell.val === targetVal;

        const cellDiv = document.createElement('div');
        // Border styling for 3x3 blocks
        const borderR = (c + 1) % 3 === 0 && c < 8 ? 'border-r-2 border-r-indigo-400/40' : '';
        const borderB = (r + 1) % 3 === 0 && r < 8 ? 'border-b-2 border-b-indigo-400/40' : '';

        let bg = 'bg-brand-dark/90';
        if (isSelected) {
          bg = 'bg-brand-neon/30';
        } else if (isSameNum) {
          bg = 'bg-brand-accent/30';
        } else if (isPeer) {
          bg = 'bg-brand-card/70';
        }

        cellDiv.className = `relative flex h-9 w-9 sm:h-12 sm:w-12 items-center justify-center font-mono text-sm sm:text-base cursor-pointer transition-colors ${bg} ${borderR} ${borderB}`;

        if (cell.val > 0) {
          const textColor = cell.isError
            ? 'text-red-400 font-bold'
            : cell.initial
            ? 'text-white font-black'
            : 'text-brand-neon font-bold';
          cellDiv.innerHTML = `<span class="${textColor}">${cell.val}</span>`;
        } else if (cell.notes.size > 0) {
          // Render 3x3 pencil grid inside cell
          const notesGrid = document.createElement('div');
          notesGrid.className = 'grid grid-cols-3 grid-rows-3 w-full h-full p-0.5 text-[8px] font-mono leading-none text-gray-400';
          for (let n = 1; n <= 9; n++) {
            const nSpan = document.createElement('span');
            nSpan.className = 'flex items-center justify-center';
            nSpan.textContent = cell.notes.has(n) ? n.toString() : '';
            notesGrid.appendChild(nSpan);
          }
          cellDiv.appendChild(notesGrid);
        }

        cellDiv.addEventListener('click', () => {
          sound.click();
          selectedRow = r;
          selectedCol = c;
          render();
        });

        gridEl.appendChild(cellDiv);
      }
    }
  }

  function handleInput(num: number) {
    if (isGameOver) return;
    const cell = board[selectedRow][selectedCol];
    if (cell.initial) return;

    if (isNotesMode) {
      sound.blip();
      if (cell.notes.has(num)) {
        cell.notes.delete(num);
      } else {
        cell.notes.add(num);
      }
      render();
      return;
    }

    // Direct value entry
    if (num === cell.solution) {
      sound.score();
      cell.val = num;
      cell.isError = false;
      cell.notes.clear();

      // Clear matching note from peers
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (r === selectedRow || c === selectedCol || (Math.floor(r / 3) === Math.floor(selectedRow / 3) && Math.floor(c / 3) === Math.floor(selectedCol / 3))) {
            board[r][c].notes.delete(num);
          }
        }
      }

      checkWin();
    } else {
      sound.gameOver();
      cell.val = num;
      cell.isError = true;
      mistakes++;
      mistakesEl.textContent = `${mistakes}/3`;

      if (mistakes >= 3) {
        triggerGameOver();
        return;
      }
    }

    render();
  }

  function eraseSelected() {
    if (isGameOver) return;
    const cell = board[selectedRow][selectedCol];
    if (cell.initial) return;
    sound.click();
    cell.val = 0;
    cell.isError = false;
    cell.notes.clear();
    render();
  }

  function applyHint() {
    if (isGameOver || hintsLeft <= 0) return;
    const cell = board[selectedRow][selectedCol];
    if (cell.initial || cell.val === cell.solution) {
      // Find an unsolved cell
      for (let r = 0; r < 9; r++) {
        for (let c = 0; c < 9; c++) {
          if (!board[r][c].initial && board[r][c].val !== board[r][c].solution) {
            selectedRow = r;
            selectedCol = c;
            break;
          }
        }
      }
    }

    sound.victory();
    hintsLeft--;
    hintBtn.textContent = `💡 Hint (${hintsLeft})`;
    const targetCell = board[selectedRow][selectedCol];
    targetCell.val = targetCell.solution;
    targetCell.isError = false;
    targetCell.notes.clear();
    render();
    checkWin();
  }

  function checkWin() {
    const isAllFilled = board.every(row => row.every(cell => cell.val === cell.solution));
    if (isAllFilled) {
      isGameOver = true;
      clearInterval(timerInterval);
      sound.victory();
      launchConfetti();
      player.addXP(250, 'Sudoku Puzzle Cleared');
      finalTimeEl.textContent = timerEl.textContent;
      winModal.classList.remove('opacity-0', 'pointer-events-none');
    }
  }

  function triggerGameOver() {
    isGameOver = true;
    clearInterval(timerInterval);
    sound.gameOver();
    loseModal.classList.remove('opacity-0', 'pointer-events-none');
  }

  // Event Listeners
  document.querySelectorAll('.sudoku-num-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const num = parseInt((e.currentTarget as HTMLElement).dataset.num!, 10);
      handleInput(num);
    });
  });

  notesBtn.addEventListener('click', () => {
    sound.click();
    isNotesMode = !isNotesMode;
    notesStatusEl.textContent = isNotesMode ? 'ON' : 'OFF';
    if (isNotesMode) {
      notesBtn.classList.add('border-brand-neon', 'bg-brand-neon/20');
    } else {
      notesBtn.classList.remove('border-brand-neon', 'bg-brand-neon/20');
    }
  });

  eraseBtn.addEventListener('click', eraseSelected);
  hintBtn.addEventListener('click', applyHint);
  newBtn.addEventListener('click', initGame);
  winReplay.addEventListener('click', initGame);
  loseReplay.addEventListener('click', initGame);
  diffSelect.addEventListener('change', initGame);

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (isGameOver) return;
    if (e.key >= '1' && e.key <= '9') {
      handleInput(parseInt(e.key, 10));
    } else if (e.key === 'Backspace' || e.key === 'Delete') {
      eraseSelected();
    } else if (e.key.toLowerCase() === 'n') {
      notesBtn.click();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedRow = (selectedRow + 8) % 9;
      render();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedRow = (selectedRow + 1) % 9;
      render();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      selectedCol = (selectedCol + 8) % 9;
      render();
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      selectedCol = (selectedCol + 1) % 9;
      render();
    }
  });

  initGame();
</script>

