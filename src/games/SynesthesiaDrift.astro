---
// SynesthesiaDrift.astro - Frequency & Color-Matching Supersonic Racer
---

<div id="syn-drift-container" class="relative w-full max-w-4xl mx-auto bg-[#05060d] rounded-2xl overflow-hidden border border-rose-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(244,63,94,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#090b17]/95 border-b border-rose-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/40 flex items-center justify-center text-rose-400 font-bold text-xl shadow-[0_0_15px_rgba(244,63,94,0.3)]">
        ⚡
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-rose-400 via-amber-300 to-cyan-400 bg-clip-text text-transparent font-black">SYNESTHESIA DRIFT</span>
          <span class="px-2 py-0.5 text-[10px] bg-rose-500/20 text-rose-300 rounded-md border border-rose-500/40">SONIC RACER</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">CHROMATIC FREQUENCY SYNC &bull; 60 FPS</div>
      </div>
    </div>

    <!-- Center Stats -->
    <div class="flex items-center gap-4 bg-[#0a0d20] px-4 py-1.5 rounded-xl border border-rose-500/30">
      <div>
        <span class="text-[10px] text-slate-400">SCORE:</span>
        <span id="sd-score" class="font-bold text-white font-mono ml-1 text-sm">0</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400">COMBO:</span>
        <span id="sd-combo" class="font-bold text-rose-400 font-mono ml-1 text-sm">x1</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400">SHIELD:</span>
        <span id="sd-shield" class="font-bold text-emerald-400 font-mono ml-1 text-sm">100%</span>
      </div>
    </div>

    <button id="sd-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      RESTART
    </button>
  </div>

  <!-- Main Canvas -->
  <div class="relative w-full h-[460px] sm:h-[500px] bg-[#04050a] overflow-hidden flex items-center justify-center">
    <canvas id="sd-canvas" class="w-full h-full block touch-none"></canvas>

    <!-- Resonance Channel Switcher -->
    <div class="absolute bottom-4 inset-x-4 sm:inset-x-20 flex items-center justify-between gap-2 z-20">
      <button class="sd-color-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-rose-500/60 bg-rose-950/60 text-rose-300 font-bold active:scale-95 text-xs transition-all shadow-[0_0_20px_rgba(244,63,94,0.3)]" data-color="rose">
        🔴 BASS (110Hz) [1]
      </button>
      <button class="sd-color-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-amber-500/60 bg-amber-950/40 text-amber-300 font-bold active:scale-95 text-xs transition-all" data-color="amber">
        🟡 MID (440Hz) [2]
      </button>
      <button class="sd-color-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-cyan-500/60 bg-cyan-950/40 text-cyan-300 font-bold active:scale-95 text-xs transition-all" data-color="cyan">
        🔵 TREBLE (880Hz) [3]
      </button>
    </div>

    <!-- Game Over Overlay -->
    <div id="sd-over-modal" class="absolute inset-0 bg-[#04050a]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
      <div class="bg-[#0c0d1c] border border-rose-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(244,63,94,0.3)]">
        <span class="text-4xl">💥</span>
        <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">SHIELD COLLAPSE</h2>
        <p class="text-xs text-slate-300 mb-4">Acoustic harmonic desynchronization occurred.</p>
        
        <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#070814] p-3 rounded-xl border border-rose-500/20">
          <div>SCORE: <span id="sd-final-score" class="text-white font-bold text-sm">0</span></div>
          <div>MAX COMBO: <span id="sd-final-combo" class="text-rose-400 font-bold text-sm">x1</span></div>
        </div>

        <button id="sd-play-again" class="px-6 py-2.5 bg-gradient-to-r from-rose-500 to-amber-500 text-white font-bold text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
          RACE AGAIN
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  const canvas = document.getElementById('sd-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  const scoreEl = document.getElementById('sd-score')!;
  const comboEl = document.getElementById('sd-combo')!;
  const shieldEl = document.getElementById('sd-shield')!;
  const overModal = document.getElementById('sd-over-modal')!;
  const finalScoreEl = document.getElementById('sd-final-score')!;
  const finalComboEl = document.getElementById('sd-final-combo')!;
  const playAgainBtn = document.getElementById('sd-play-again')!;
  const resetBtn = document.getElementById('sd-reset-btn')!;

  type ColorMode = 'rose' | 'amber' | 'cyan';
  const COLOR_CONFIG: Record<ColorMode, { color: string; hex: string; freq: number }> = {
    rose: { color: 'rose', hex: '#f43f5e', freq: 110 },
    amber: { color: 'amber', hex: '#fbbf24', freq: 440 },
    cyan: { color: 'cyan', hex: '#06b6d4', freq: 880 }
  };

  interface Gate {
    y: number;
    lane: number; // 0, 1, 2
    color: ColorMode;
    passed: boolean;
  }

  let playerLane = 1; // 0: left, 1: center, 2: right
  let playerColor: ColorMode = 'rose';
  let score = 0;
  let combo = 1;
  let maxCombo = 1;
  let shield = 100;
  let speed = 4;
  let isGameOver = false;
  let gates: Gate[] = [];
  let nextGateDist = 60;
  let stars: { x: number; y: number; z: number }[] = [];

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
  }

  function getLogicalSize() {
    const rect = canvas.getBoundingClientRect();
    return { width: rect.width, height: rect.height };
  }

  function init() {
    score = 0;
    combo = 1;
    maxCombo = 1;
    shield = 100;
    speed = 4;
    isGameOver = false;
    gates = [];
    nextGateDist = 60;

    scoreEl.textContent = '0';
    comboEl.textContent = 'x1';
    shieldEl.textContent = '100%';
    overModal.classList.add('hidden');

    const { width, height } = getLogicalSize();
    stars = [];
    for (let i = 0; i < 80; i++) {
      stars.push({
        x: (Math.random() - 0.5) * width,
        y: (Math.random() - 0.5) * height,
        z: Math.random() * width
      });
    }
  }

  function switchColor(c: ColorMode) {
    playerColor = c;
    sound.playTone(COLOR_CONFIG[c].freq, 'triangle', 0.1, 0.15);
    document.querySelectorAll('.sd-color-btn').forEach(btn => {
      const isTarget = btn.getAttribute('data-color') === c;
      btn.className = isTarget
        ? `sd-color-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-${c}-500/80 bg-${c}-950/70 text-${c}-300 font-bold active:scale-95 text-xs transition-all shadow-[0_0_20px_rgba(244,63,94,0.3)]`
        : `sd-color-btn flex-1 py-2 sm:py-2.5 rounded-xl border border-slate-700 bg-slate-900/40 text-slate-400 font-bold active:scale-95 text-xs transition-all`;
    });
  }

  function tick() {
    const { width, height } = getLogicalSize();
    ctx.clearRect(0, 0, width, height);

    // Deep neon highway perspective
    const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
    bgGrad.addColorStop(0, '#030408');
    bgGrad.addColorStop(1, '#080a18');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, width, height);

    // Starfield speedlines
    ctx.fillStyle = '#ffffff';
    stars.forEach(s => {
      s.z -= speed * 1.5;
      if (s.z <= 0) s.z = width;
      const k = 120 / s.z;
      const px = s.x * k + width / 2;
      const py = s.y * k + height / 2;
      if (px >= 0 && px < width && py >= 0 && py < height) {
        const size = Math.max(1, (1 - s.z / width) * 2.5);
        ctx.fillRect(px, py, size, size);
      }
    });

    // Draw 3 Highway Lanes
    const laneWidth = width / 3;
    for (let i = 1; i <= 2; i++) {
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(i * laneWidth, 0);
      ctx.lineTo(i * laneWidth, height);
      ctx.stroke();
    }

    if (!isGameOver) {
      // Spawn Gates
      nextGateDist -= speed;
      if (nextGateDist <= 0) {
        const colors: ColorMode[] = ['rose', 'amber', 'cyan'];
        gates.push({
          y: -40,
          lane: Math.floor(Math.random() * 3),
          color: colors[Math.floor(Math.random() * colors.length)],
          passed: false
        });
        nextGateDist = Math.max(80, 160 - speed * 8);
      }

      // Accelerate gently
      speed = Math.min(12, speed + 0.001);
    }

    // Draw & Update Gates
    const playerY = height - 90;
    gates.forEach(g => {
      if (!isGameOver) g.y += speed;

      const gx = g.lane * laneWidth + 10;
      const gw = laneWidth - 20;

      ctx.save();
      ctx.strokeStyle = COLOR_CONFIG[g.color].hex;
      ctx.fillStyle = COLOR_CONFIG[g.color].hex + '22';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.roundRect(gx, g.y, gw, 28, 8);
      ctx.fill();
      ctx.stroke();

      // Gate sonic ripple
      ctx.beginPath();
      ctx.arc(gx + gw / 2, g.y + 14, 18, 0, Math.PI * 2);
      ctx.strokeStyle = COLOR_CONFIG[g.color].hex + '88';
      ctx.stroke();
      ctx.restore();

      // Collision check with player
      if (!g.passed && Math.abs(g.y - playerY) < 25) {
        if (g.lane === playerLane) {
          g.passed = true;
          if (g.color === playerColor) {
            // Harmonic match!
            score += 100 * combo;
            combo++;
            maxCombo = Math.max(maxCombo, combo);
            sound.score();
          } else {
            // Desync crash!
            shield = Math.max(0, shield - 35);
            combo = 1;
            sound.playTone(120, 'sawtooth', 0.25, 0.2);
            if (shield <= 0) {
              isGameOver = true;
              finalScoreEl.textContent = score.toString();
              finalComboEl.textContent = `x${maxCombo}`;
              overModal.classList.remove('hidden');
              player.addXp(Math.floor(score / 10));
            }
          }
          scoreEl.textContent = score.toString();
          comboEl.textContent = `x${combo}`;
          shieldEl.textContent = `${shield}%`;
        }
      }
    });

    gates = gates.filter(g => g.y < height + 50);

    // Draw Player Vessel
    const px = playerLane * laneWidth + laneWidth / 2;
    const py = playerY;
    ctx.save();
    ctx.translate(px, py);

    // Shield Aura
    ctx.beginPath();
    ctx.arc(0, 0, 26, 0, Math.PI * 2);
    ctx.fillStyle = COLOR_CONFIG[playerColor].hex + '33';
    ctx.fill();
    ctx.strokeStyle = COLOR_CONFIG[playerColor].hex;
    ctx.lineWidth = 2.5;
    ctx.stroke();

    // Ship Delta Wing
    ctx.beginPath();
    ctx.moveTo(0, -20);
    ctx.lineTo(16, 16);
    ctx.lineTo(0, 8);
    ctx.lineTo(-16, 16);
    ctx.closePath();
    ctx.fillStyle = '#ffffff';
    ctx.fill();

    ctx.restore();

    requestAnimationFrame(tick);
  }

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
      playerLane = Math.max(0, playerLane - 1);
      sound.blip();
    } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
      playerLane = Math.min(2, playerLane + 1);
      sound.blip();
    } else if (e.key === '1') switchColor('rose');
    else if (e.key === '2') switchColor('amber');
    else if (e.key === '3') switchColor('cyan');
  });

  // Touch & Click Lane Switching
  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const laneWidth = rect.width / 3;
    playerLane = Math.min(2, Math.max(0, Math.floor(x / laneWidth)));
    sound.blip();
  });

  document.querySelectorAll('.sd-color-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const c = (e.currentTarget as HTMLElement).getAttribute('data-color') as ColorMode;
      switchColor(c);
    });
  });

  resetBtn.addEventListener('click', init);
  playAgainBtn.addEventListener('click', init);
  window.addEventListener('resize', resize);

  resize();
  init();
  requestAnimationFrame(tick);
</script>
