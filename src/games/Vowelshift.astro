---
// VowelShift: Anagram Slider
---

<div id="vowel-game" class="flex flex-col items-center justify-center p-3 select-none max-w-sm mx-auto w-full">
  <!-- Stats Header -->
  <div class="mb-3 flex w-full items-center justify-between rounded-2xl border border-brand-border/60 bg-brand-dark/95 px-4 py-2.5 text-xs">
    <div>Level: <span id="vowel-level" class="font-mono font-bold text-brand-neon">1/3</span></div>
    <div>Moves: <span id="vowel-moves" class="font-mono font-bold text-white">0</span></div>
    <div>Par: <span id="vowel-par" class="font-mono font-bold text-brand-gold">8</span></div>
    <button id="vowel-reset" class="rounded-xl border border-brand-border bg-brand-card px-2.5 py-1 text-xs text-gray-300 hover:text-white transition-colors cursor-pointer">
      Reset
    </button>
  </div>

  <div class="w-full text-center text-xs text-gray-400 mb-2">
    Slide horizontal letter rows to form valid English words in all 4 rows:
  </div>

  <!-- 4x4 Grid Container with Inline Left/Right Row Shifter Buttons -->
  <div class="relative p-3 bg-brand-card/70 border-2 border-brand-border rounded-2xl shadow-2xl w-full">
    <div class="flex flex-col gap-2.5" id="vowel-rows-container">
      <!-- 4 rows with [<] [4 letter tiles] [>] -->
    </div>
  </div>

  <div class="mt-3 text-[11px] text-gray-400 text-center">
    Tap <span class="font-mono text-brand-neon">◀ / ▶</span> or swipe horizontally across each row to slide letters.
  </div>

  <!-- Victory Overlay Modal -->
  <div id="vowel-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-sm p-4">
    <div class="rounded-3xl border-2 border-brand-border bg-brand-dark p-6 max-w-sm w-full text-center shadow-2xl">
      <span id="vowel-stars" class="text-4xl animate-bounce">⭐⭐⭐</span>
      <h3 id="vowel-modal-title" class="text-2xl font-black text-white mt-2">Matrix Solved!</h3>
      <p id="vowel-modal-msg" class="text-xs text-gray-300 mt-1">Cleared in 6 moves (Par: 8)</p>
      <div class="mt-2 text-xs font-mono text-brand-gold font-bold">+200 XP Awarded</div>
      <button id="vowel-modal-btn" class="mt-5 w-full rounded-2xl bg-brand-accent py-3 text-xs font-bold text-white shadow-lg hover:scale-105 active:scale-95 transition-transform cursor-pointer">
        Next Matrix Level →
      </button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  interface LevelConfig {
    targets: string[];
    scrambled: string[][];
    par: number;
  }

  const LEVELS: LevelConfig[] = [
    {
      targets: ['STAR', 'TIME', 'OPEN', 'REST'],
      scrambled: [
        ['R', 'S', 'T', 'A'],
        ['E', 'T', 'I', 'M'],
        ['P', 'E', 'N', 'O'],
        ['T', 'R', 'E', 'S']
      ],
      par: 6
    },
    {
      targets: ['CYBER', 'PIXEL', 'CLOUD', 'FLASH'], // 5-letter or 4-letter levels
      targets_4: ['MOON', 'DARK', 'GLOW', 'BEAM'],
      scrambled: [
        ['O', 'N', 'M', 'O'],
        ['R', 'K', 'D', 'A'],
        ['W', 'G', 'L', 'O'],
        ['A', 'M', 'B', 'E']
      ],
      par: 8
    },
    {
      targets: ['GAME', 'PLAY', 'FIRE', 'WIND'],
      scrambled: [
        ['M', 'E', 'G', 'A'],
        ['A', 'Y', 'P', 'L'],
        ['R', 'E', 'F', 'I'],
        ['N', 'D', 'W', 'I']
      ],
      par: 10
    }
  ];

  let currentLevelIdx = 0;
  let currentGrid: string[][] = [];
  let targets: string[] = [];
  let par = 8;
  let moves = 0;
  let isGameOver = false;

  const rowsContainer = document.getElementById('vowel-rows-container')!;
  const levelEl = document.getElementById('vowel-level')!;
  const movesEl = document.getElementById('vowel-moves')!;
  const parEl = document.getElementById('vowel-par')!;
  const resetBtn = document.getElementById('vowel-reset')!;
  const modal = document.getElementById('vowel-modal')!;
  const modalTitle = document.getElementById('vowel-modal-title')!;
  const modalMsg = document.getElementById('vowel-modal-msg')!;
  const starsEl = document.getElementById('vowel-stars')!;
  const modalBtn = document.getElementById('vowel-modal-btn')!;

  function loadLevel(idx: number) {
    currentLevelIdx = idx % LEVELS.length;
    const lvl = LEVELS[currentLevelIdx];
    targets = lvl.targets_4 || lvl.targets;
    currentGrid = lvl.scrambled.map(row => [...row]);
    par = lvl.par;
    moves = 0;
    isGameOver = false;

    levelEl.textContent = `${currentLevelIdx + 1}/${LEVELS.length}`;
    movesEl.textContent = '0';
    parEl.textContent = par.toString();
    modal.classList.add('hidden');

    render();
    player.trackGamePlay('vowelshift');
  }

  function render() {
    rowsContainer.innerHTML = '';
    movesEl.textContent = moves.toString();

    for (let r = 0; r < 4; r++) {
      const rowWrapper = document.createElement('div');
      rowWrapper.className = 'flex items-center justify-between gap-1.5 w-full';

      // Left shift button
      const leftBtn = document.createElement('button');
      leftBtn.className = 'w-8 h-12 rounded-xl bg-brand-dark border border-brand-border text-brand-neon hover:bg-brand-neon hover:text-brand-dark flex items-center justify-center font-bold text-xs transition-all active:scale-90';
      leftBtn.textContent = '◀';
      leftBtn.addEventListener('click', () => shiftRow(r, -1));
      rowWrapper.appendChild(leftBtn);

      // Letter tiles container
      const tilesContainer = document.createElement('div');
      tilesContainer.className = 'flex-1 grid grid-cols-4 gap-1.5';

      const isRowComplete = currentGrid[r].join('') === targets[r];

      for (let c = 0; c < 4; c++) {
        const char = currentGrid[r][c];
        const isVowel = 'AEIOU'.includes(char);
        const tile = document.createElement('div');
        tile.className = `h-12 rounded-xl border flex items-center justify-center font-mono text-base font-black transition-all ${
          isRowComplete
            ? 'bg-emerald-500/20 border-emerald-400 text-emerald-300 shadow-sm shadow-emerald-400/30'
            : isVowel
            ? 'bg-amber-500/15 border-amber-500/40 text-amber-300'
            : 'bg-brand-dark border-brand-border text-white'
        }`;
        tile.textContent = char;
        tilesContainer.appendChild(tile);
      }

      // Touch swipe support
      let touchStartX = 0;
      tilesContainer.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      tilesContainer.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 30) {
          shiftRow(r, diff > 0 ? 1 : -1);
        }
      });

      rowWrapper.appendChild(tilesContainer);

      // Right shift button
      const rightBtn = document.createElement('button');
      rightBtn.className = 'w-8 h-12 rounded-xl bg-brand-dark border border-brand-border text-brand-neon hover:bg-brand-neon hover:text-brand-dark flex items-center justify-center font-bold text-xs transition-all active:scale-90';
      rightBtn.textContent = '▶';
      rightBtn.addEventListener('click', () => shiftRow(r, 1));
      rowWrapper.appendChild(rightBtn);

      rowsContainer.appendChild(rowWrapper);
    }
  }

  function shiftRow(row: number, dir: number) {
    if (isGameOver) return;
    sound.click();
    moves++;
    const arr = [...currentGrid[row]];
    if (dir === 1) {
      arr.unshift(arr.pop()!);
    } else {
      arr.push(arr.shift()!);
    }
    currentGrid[row] = arr;
    render();
    checkWin();
  }

  function checkWin() {
    const won = currentGrid.every((row, r) => row.join('') === targets[r]);
    if (won) {
      isGameOver = true;
      sound.victory();
      launchConfetti();
      player.addXP(200, 'VowelShift Matrix Solved');

      const stars = moves <= par ? '⭐⭐⭐' : moves <= par + 4 ? '⭐⭐' : '⭐';
      starsEl.textContent = stars;
      modalMsg.textContent = `Completed in ${moves} moves (Par: ${par})`;
      modal.classList.remove('hidden');
    }
  }

  resetBtn.addEventListener('click', () => {
    sound.click();
    loadLevel(currentLevelIdx);
  });

  modalBtn.addEventListener('click', () => {
    loadLevel(currentLevelIdx + 1);
  });

  loadLevel(0);
</script>
