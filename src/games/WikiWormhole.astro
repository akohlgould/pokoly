---
// WikiWormhole.astro - 6 Degrees of Wikipedia Speedrun Constellation
---

<div id="wiki-container" class="relative w-full max-w-4xl mx-auto bg-[#07080f] rounded-2xl overflow-hidden border border-indigo-500/30 flex flex-col select-none font-mono shadow-[0_0_50px_rgba(99,102,241,0.15)]">
  <!-- HUD Header -->
  <div class="h-16 bg-[#0c0e1c]/95 border-b border-indigo-500/20 px-3 sm:px-6 flex items-center justify-between text-xs text-slate-300 z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/40 flex items-center justify-center text-indigo-400 font-bold text-xl shadow-[0_0_15px_rgba(99,102,241,0.3)]">
        🌐
      </div>
      <div>
        <div class="text-white font-bold tracking-wider flex items-center gap-2 text-sm sm:text-base">
          <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent font-black">WIKI WORMHOLE</span>
          <span class="px-2 py-0.5 text-[10px] bg-indigo-500/20 text-indigo-300 rounded-md border border-indigo-500/40">6 DEGREES</span>
        </div>
        <div class="text-[10px] sm:text-xs text-slate-400">HYPERLINK GRAPH &bull; SPEEDRUN RABBIT HOLE</div>
      </div>
    </div>

    <!-- Center Metric: Hops & Timer -->
    <div class="flex items-center gap-4 bg-[#090b18] px-4 py-1.5 rounded-xl border border-indigo-500/30">
      <div>
        <span class="text-[10px] text-slate-400 font-bold">HOPS:</span>
        <span id="ww-hops" class="font-bold text-indigo-300 font-mono ml-1 text-sm">0 / 5</span>
      </div>
      <div class="h-3 w-px bg-slate-700"></div>
      <div>
        <span class="text-[10px] text-slate-400 font-bold">TIME LEFT:</span>
        <span id="ww-timer" class="font-bold text-emerald-400 font-mono ml-1 text-sm">45s</span>
      </div>
    </div>

    <button id="ww-reset-btn" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs transition-all">
      RESTART ROUTE
    </button>
  </div>

  <!-- Main Playing Area -->
  <div class="p-6 flex flex-col items-center justify-center gap-6 min-h-[460px]">
    <!-- Route Objective Card -->
    <div class="w-full max-w-xl bg-[#0f1224] p-4 rounded-xl border border-indigo-500/30 flex items-center justify-between shadow-lg">
      <div class="text-left">
        <span class="text-[10px] text-slate-400 font-bold uppercase">CURRENT ARTICLE:</span>
        <div id="ww-current-title" class="text-base sm:text-lg font-black text-white">Banana</div>
      </div>
      <div class="text-indigo-400 font-black text-xl">➔</div>
      <div class="text-right">
        <span class="text-[10px] text-slate-400 font-bold uppercase">TARGET DESTINATION:</span>
        <div id="ww-target-title" class="text-base sm:text-lg font-black text-purple-400">Quantum Computing</div>
      </div>
    </div>

    <!-- Semantic Hyperlink Node Cluster -->
    <div class="w-full max-w-xl">
      <div class="text-xs text-slate-400 text-center mb-3">CLICK A LINK TO JUMP THROUGH THE KNOWLEDGE GRAPH:</div>
      <div id="ww-links-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- Injected semantic links -->
      </div>
    </div>
  </div>

  <!-- Victory Modal -->
  <div id="ww-victory-modal" class="absolute inset-0 bg-[#04050a]/90 backdrop-blur-md hidden flex flex-col items-center justify-center z-30 p-6">
    <div class="bg-[#12142c] border border-indigo-500/50 p-6 sm:p-8 rounded-2xl max-w-md w-full text-center shadow-[0_0_60px_rgba(99,102,241,0.3)]">
      <span class="text-4xl animate-bounce">🐇</span>
      <h2 class="text-xl sm:text-2xl font-black text-white mt-2 mb-1 tracking-wide">RABBIT HOLE CONQUERED!</h2>
      <p class="text-xs text-slate-300 mb-4">You bridged disparate human knowledge in record time across the Wikipedia hypertext graph!</p>
      
      <div class="flex justify-center gap-6 text-xs font-mono mb-6 bg-[#080918] p-3 rounded-xl border border-indigo-500/20">
        <div>TOTAL HOPS: <span id="ww-stat-hops" class="text-indigo-300 font-bold text-sm">3</span></div>
        <div>REWARD: <span class="text-purple-400 font-bold text-sm">+250 XP</span></div>
      </div>

      <button id="ww-next-btn" class="px-6 py-2.5 bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-bold text-xs rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all">
        NEXT SPEEDRUN &rarr;
      </button>
    </div>
  </div>
</div>

<script>
  import { sound } from '../utils/audio';
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';

  interface WikiNode {
    title: string;
    links: string[];
  }

  const WIKI_GRAPH: Record<string, string[]> = {
    "Banana": ["Potassium", "Agriculture", "Southeast Asia", "Fruit"],
    "Potassium": ["Radioactivity", "Periodic Table", "Electrolyte", "Chemical Element"],
    "Radioactivity": ["Nuclear Physics", "Marie Curie", "Alpha Particle", "Quantum Mechanics"],
    "Nuclear Physics": ["Quantum Mechanics", "Manhattan Project", "Particle Accelerator", "Atom"],
    "Quantum Mechanics": ["Quantum Computing", "Schrödinger Equation", "Max Planck", "Entanglement"],
    "Quantum Computing": ["Qubit", "Superposition", "Cryptography", "IBM"],

    "Agriculture": ["Industrial Revolution", "Domestication", "Fertilizer", "Civilization"],
    "Civilization": ["History of Science", "Ancient Greece", "Philosophy", "Writing"],
    "Philosophy": ["Logic", "Epistemology", "Ethics", "Science"],
    "Logic": ["Turing Machine", "Boolean Algebra", "Computer Science", "Algorithms"],
    "Computer Science": ["Quantum Computing", "Alan Turing", "Internet", "Artificial Intelligence"]
  };

  let currentArticle = "Banana";
  const targetArticle = "Quantum Computing";
  let hops = 0;
  let timeLeft = 45;
  let isWon = false;
  let timerInterval: any = null;

  const currentTitleEl = document.getElementById('ww-current-title')!;
  const targetTitleEl = document.getElementById('ww-target-title')!;
  const linksContainer = document.getElementById('ww-links-container')!;
  const hopsEl = document.getElementById('ww-hops')!;
  const timerEl = document.getElementById('ww-timer')!;
  const statHopsEl = document.getElementById('ww-stat-hops')!;
  const victoryModal = document.getElementById('ww-victory-modal')!;
  const nextBtn = document.getElementById('ww-next-btn')!;
  const resetBtn = document.getElementById('ww-reset-btn')!;

  function init() {
    currentArticle = "Banana";
    hops = 0;
    timeLeft = 45;
    isWon = false;
    hopsEl.textContent = "0 / 5";
    timerEl.textContent = "45s";
    currentTitleEl.textContent = currentArticle;
    targetTitleEl.textContent = targetArticle;
    victoryModal.classList.add('hidden');

    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      if (!isWon) {
        timeLeft--;
        timerEl.textContent = `${timeLeft}s`;
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          sound.playTone(150, 'sawtooth', 0.3, 0.2);
          init();
        }
      }
    }, 1000);

    renderLinks();
  }

  function renderLinks() {
    linksContainer.innerHTML = '';
    const outgoing = WIKI_GRAPH[currentArticle] || ["Philosophy", "Computer Science", "History", "Science"];

    outgoing.forEach(link => {
      const btn = document.createElement('button');
      btn.className = 'p-3 rounded-xl border border-indigo-500/30 bg-[#12152a] hover:bg-indigo-950/60 hover:border-indigo-400 transition-all text-left flex items-center justify-between group active:scale-95 cursor-pointer shadow-md';
      btn.innerHTML = `
        <span class="font-bold text-xs text-white group-hover:text-indigo-300 transition-colors">${link}</span>
        <span class="text-indigo-400 group-hover:translate-x-1 transition-transform">➔</span>
      `;
      btn.addEventListener('click', () => navigateTo(link));
      linksContainer.appendChild(btn);
    });
  }

  function navigateTo(target: string) {
    if (isWon) return;

    hops++;
    hopsEl.textContent = `${hops} / 5`;
    currentArticle = target;
    currentTitleEl.textContent = currentArticle;
    sound.click();

    if (currentArticle === targetArticle) {
      isWon = true;
      clearInterval(timerInterval);
      sound.victory();
      launchConfetti();
      player.addXp(250);
      statHopsEl.textContent = hops.toString();
      victoryModal.classList.remove('hidden');
    } else if (hops >= 5) {
      sound.playTone(150, 'sawtooth', 0.3, 0.2);
      init();
    } else {
      renderLinks();
    }
  }

  nextBtn.addEventListener('click', init);
  resetBtn.addEventListener('click', init);

  init();
</script>
