---
import LiveTicker from '../components/LiveTicker.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QuestsModal from '../components/QuestsModal.astro';
import MarketingModal from '../components/MarketingModal.astro';
import { AD_CONFIG } from '../config/ads';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  schema?: object | object[];
}

const rawCanonical = Astro.props.canonical || Astro.url.href;
const canonicalUrlObj = new URL(rawCanonical, Astro.site || 'https://pokoly.com');
const normalizedPath = canonicalUrlObj.pathname.endsWith('/')
  ? canonicalUrlObj.pathname
  : `${canonicalUrlObj.pathname}/`;
const canonical = `${canonicalUrlObj.origin}${normalizedPath}`;

const {
  title,
  description,
  image = '/logos/pokoly-logo.svg',
  schema
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || Astro.url).href} />
    <meta property="og:site_name" content="Pokoly.com" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Instant Subdomain Client Router Fallback -->
    <script is:inline>
      (function() {
        try {
          var host = window.location.hostname.toLowerCase();
          var sub = null;
          if (host.endsWith('.pokoly.com')) {
            var s = host.replace('.pokoly.com', '').split('.').pop();
            if (s && s !== 'www') sub = s;
          } else if (host.endsWith('.pages.dev')) {
            var parts = host.replace('.pages.dev', '').split('.');
            if (parts.length > 1) sub = parts[0];
          } else {
            var p = host.split('.');
            if (p.length >= 3 && p[0] !== 'www') sub = p[0];
          }

          if (sub) {
            var map = {
              'fruits': '/games/fruit-merge',
              'fruit': '/games/fruit-merge',
              'merge': '/games/fruit-merge',
              'suika': '/games/fruit-merge',
              'watermelon': '/games/fruit-merge',
              'words': '/games/word-guess',
              'word': '/games/word-guess',
              'wordguess': '/games/word-guess',
              'wordle': '/games/word-guess',
              'timeline': '/games/chronotrail',
              'chronotrail': '/games/chronotrail',
              'history': '/games/chronotrail',
              'nanopoker': '/games/nanojoker',
              'nanojoker': '/games/nanojoker',
              'poker': '/games/nanojoker',
              'balatro': '/games/nanojoker',
              'pegdungeon': '/games/pegdungeon',
              'peggle': '/games/pegdungeon',
              'pachinko': '/games/pegdungeon',
              'orbitsurvivors': '/games/orbit-survivors',
              'orbit': '/games/orbit-survivors',
              'connections': '/games/synapse',
              'synapse': '/games/synapse',
              'wordhedge': '/games/wordhedge',
              'semantic': '/games/semanticlimb',
              'geopixel': '/games/geopixel',
              'numbers': '/games/numberdrop',
              'cryptogram': '/games/cipherpunk',
              'vowelshift': '/games/vowelshift',
              'lexifall': '/games/lexifall',
              'radicals': '/games/kanjiforge',
              'kanji': '/games/kanjiforge',
              '2048': '/games/neon-2048',
              'solitaire': '/games/solitaire',
              'cards': '/games/solitaire',
              'snake': '/games/cyber-snake',
              'minesweeper': '/games/minesweeper',
              'breakout': '/games/breakout',
              'typing': '/games/speed-typing',
              'sudoku': '/games/sudoku',
              'flappy': '/games/flappy-cyber',
              'chronowave': '/games/chronowave',
              'quantumweave': '/games/quantumweave',
              'gravityforge': '/games/gravityforge',
              'synthia': '/games/synthia',
              'morphoflora': '/games/morphoflora',
              'prismpulse': '/games/prismpulse',
              'clockworkheist': '/games/clockworkheist',
              'geothermal': '/games/geothermal',
              'neurolink': '/games/neurolink',
              'tectonicdrift': '/games/tectonicdrift',
              'cymatica': '/games/cymatica',
              'penumbra': '/games/penumbra-null',
              'gravifold': '/games/gravifold',
              'sonar': '/games/echolocation',
              'echo': '/games/echolocation',
              'echolocation': '/games/echolocation',
              'cursor': '/games/cursorsiege',
              'cursorsiege': '/games/cursorsiege',
              'malware': '/games/cursorsiege',
              'circuit': '/games/circuithacker',
              'circuithacker': '/games/circuithacker',
              'logic': '/games/circuithacker'
            };
            var target = map[sub];
            if (target && (window.location.pathname === '/' || window.location.pathname === '')) {
              window.location.replace(target);
            }
          }
        } catch (e) {}
      })();
    </script>

    {AD_CONFIG.enabled && AD_CONFIG.provider === 'adsense' && AD_CONFIG.adsenseClientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${AD_CONFIG.adsenseClientId}`}
        crossorigin="anonymous"
      ></script>
    )}

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-screen bg-brand-dark font-sans text-gray-100 antialiased selection:bg-brand-neon selection:text-brand-dark flex flex-col justify-between">
    <div>
      <!-- Live Social Proof Activity Ticker -->
      <LiveTicker />

      <!-- Main Navigation -->
      <Navbar />

      <!-- Page Content -->
      <slot />
    </div>

    <!-- Footer -->
    <Footer />

    <!-- Global Retention & Marketing Modals -->
    <QuestsModal />
    <MarketingModal />

    <!-- Level-up Celebration Toast Notification -->
    <div id="level-up-toast" class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-2xl border border-brand-gold/60 bg-brand-card p-4 shadow-2xl shadow-brand-gold/20 transition-all duration-500 translate-y-24 opacity-0 pointer-events-none">
      <span class="text-3xl animate-bounce">🏆</span>
      <div>
        <div class="font-bold text-white text-sm">Level Up!</div>
        <div class="text-xs text-brand-gold" id="toast-level-title">You reached Level 2!</div>
      </div>
    </div>

    <!-- PWA Install Prompt Banner (Mobile & Desktop) -->
    <div id="pwa-install-banner" class="fixed bottom-4 left-4 z-40 hidden items-center gap-3 rounded-2xl border border-brand-border bg-brand-card/95 backdrop-blur-md p-3 shadow-2xl">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-neon text-brand-dark font-black text-sm">
        📲
      </div>
      <div>
        <div class="text-xs font-bold text-white">Install Pokoly</div>
        <div class="text-[10px] text-gray-400">Play in 1-tap from your homescreen</div>
      </div>
      <button id="pwa-install-btn" class="rounded-xl bg-brand-neon px-3 py-1.5 text-xs font-bold text-brand-dark hover:opacity-90 transition-opacity">
        Install
      </button>
      <button id="pwa-dismiss-btn" class="text-gray-400 hover:text-white text-xs px-1">✕</button>
    </div>
  </body>
</html>

<script>
  import { player } from '../utils/player';
  import { launchConfetti } from '../utils/confetti';
  import { sound } from '../utils/audio';

  // Register Service Worker
  if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }

  // PWA Install Prompt Handling
  let deferredPrompt: any = null;
  const installBanner = document.getElementById('pwa-install-banner');
  const installBtn = document.getElementById('pwa-install-btn');
  const dismissBtn = document.getElementById('pwa-dismiss-btn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    installBanner?.classList.remove('hidden');
    installBanner?.classList.add('flex');
  });

  installBtn?.addEventListener('click', async () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      const choice = await deferredPrompt.userChoice;
      if (choice.outcome === 'accepted') {
        player.unlockBadge('first_play');
      }
      deferredPrompt = null;
      installBanner?.classList.add('hidden');
    }
  });

  dismissBtn?.addEventListener('click', () => {
    installBanner?.classList.add('hidden');
  });

  // Watch for Level Ups
  let prevLevel = player.getProfile().level;
  player.subscribe(() => {
    const curLevel = player.getProfile().level;
    if (curLevel > prevLevel) {
      prevLevel = curLevel;
      launchConfetti();
      sound.victory();

      const toast = document.getElementById('level-up-toast');
      const toastTitle = document.getElementById('toast-level-title');
      if (toast && toastTitle) {
        toastTitle.textContent = `You reached Level ${curLevel}: ${player.getTitle()}!`;
        toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
        }, 4000);
      }
    }
  });
</script>
