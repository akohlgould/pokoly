---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { GAMES, CATEGORIES } from '../../data/games';

export function getStaticPaths() {
  return CATEGORIES.filter(c => c.id !== 'all').map(cat => ({
    params: { cat: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryGames = GAMES.filter(g => g.category === category.id);
const siteUrl = (Astro.site?.toString() || 'https://pokoly.com').replace(/\/$/, '');

const categorySchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Best Free ${category.name} Online - Pokoly`,
    description: `Play free ${category.name} in your browser without downloads or installs.`,
    url: `${siteUrl}/categories/${category.id}/`
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteUrl}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: category.name,
        item: `${siteUrl}/categories/${category.id}/`
      }
    ]
  }
];
---

<BaseLayout
  title={`Best Free ${category.name} Online - Play Instant at Pokoly`}
  description={`Play the top free ${category.name} online with no download and no lag. ${category.description}.`}
  canonical={`${siteUrl}/categories/${category.id}/`}
  schema={categorySchema}
>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <!-- Header -->
    <div class="mb-8 flex flex-col items-start gap-3 border-b border-brand-border/60 pb-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-3">
          <span class="text-4xl">{category.icon}</span>
          <h1 class="font-display text-3xl font-extrabold text-white">
            {category.name}
          </h1>
        </div>
        <p class="mt-2 text-sm text-gray-400">
          {category.description}. Enjoy fast, unblocked gameplay directly in your browser.
        </p>
      </div>

      <a
        href="/"
        class="rounded-xl border border-brand-border bg-brand-card px-4 py-2 text-xs font-semibold text-gray-300 transition-colors hover:border-brand-neon hover:text-white"
      >
        ← All Genres
      </a>
    </div>

    <!-- Ad Leaderboard -->
    <div class="mb-8 flex justify-center">
      <AdSlot slot="leaderboard" />
    </div>

    <!-- Games Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {categoryGames.map(game => (
        <GameCard game={game} />
      ))}
    </div>

    <!-- Category SEO Text -->
    <div class="mt-12 rounded-2xl border border-brand-border bg-brand-card/40 p-6 text-xs text-gray-400 leading-relaxed space-y-3">
      <h2 class="font-display text-lg font-bold text-white">Why Play {category.name} on Pokoly?</h2>
      <p>
        Pokoly brings you high-fidelity {category.name} with instantaneous launch times. Because all game logic and rendering execute locally in your browser using modern HTML5 Canvas, you get smooth 60 FPS gameplay with zero input delay, zero buffering, and zero storage impact on your device.
      </p>
      <p>
        Whether you are taking a 5-minute break at school, at work, or on mobile transit, every game in the {category.name} collection is 100% free, responsive across touchscreens and keyboards, and automatically saves your high scores locally.
      </p>
    </div>
  </main>
</BaseLayout>
