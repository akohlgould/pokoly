---
import GameLayout from '../../layouts/GameLayout.astro';
import { GAMES } from '../../data/games';
import type { GameMeta } from '../../data/games';

import WordGuess from '../../games/WordGuess.astro';
import FruitMerge from '../../games/FruitMerge.astro';
import Neon2048 from '../../games/Neon2048.astro';
import KlondikeSolitaire from '../../games/KlondikeSolitaire.astro';
import CyberSnake from '../../games/CyberSnake.astro';
import Minesweeper from '../../games/Minesweeper.astro';
import BrickBreaker from '../../games/BrickBreaker.astro';
import Synapse from '../../games/Synapse.astro';
import Lexifall from '../../games/Lexifall.astro';
import Chronotrail from '../../games/Chronotrail.astro';
import Vowelshift from '../../games/Vowelshift.astro';
import Cipherpunk from '../../games/Cipherpunk.astro';
import Numberdrop from '../../games/Numberdrop.astro';
import Geopixel from '../../games/Geopixel.astro';
import Semanticlimb from '../../games/Semanticlimb.astro';
import Wordhedge from '../../games/Wordhedge.astro';
import Kanjiforge from '../../games/Kanjiforge.astro';
import Nanojoker from '../../games/Nanojoker.astro';
import OrbitSurvivors from '../../games/OrbitSurvivors.astro';
import Pegdungeon from '../../games/Pegdungeon.astro';
import SpeedTyping from '../../games/SpeedTyping.astro';
import Sudoku from '../../games/Sudoku.astro';
import FlappyCyber from '../../games/FlappyCyber.astro';
import ChronoWave from '../../games/ChronoWave.astro';
import QuantumWeave from '../../games/QuantumWeave.astro';
import GravityForge from '../../games/GravityForge.astro';
import Synthia from '../../games/Synthia.astro';
import MorphoFlora from '../../games/MorphoFlora.astro';
import PrismPulse from '../../games/PrismPulse.astro';
import ClockworkHeist from '../../games/ClockworkHeist.astro';
import GeoThermal from '../../games/GeoThermal.astro';
import NeuroLink from '../../games/NeuroLink.astro';
import TectonicDrift from '../../games/TectonicDrift.astro';

export function getStaticPaths() {
  return GAMES.map(game => ({
    params: { id: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameMeta;
}

const { game } = Astro.props;
---

<GameLayout game={game}>
  {game.id === 'word-guess' && <WordGuess />}
  {game.id === 'fruit-merge' && <FruitMerge />}
  {game.id === 'neon-2048' && <Neon2048 />}
  {game.id === 'solitaire' && <KlondikeSolitaire />}
  {game.id === 'cyber-snake' && <CyberSnake />}
  {game.id === 'minesweeper' && <Minesweeper />}
  {game.id === 'breakout' && <BrickBreaker />}
  {game.id === 'synapse' && <Synapse />} 
  {game.id === 'lexifall' && <Lexifall />} 
  {game.id === 'chronotrail' && <Chronotrail />} 
  {game.id === 'vowelshift' && <Vowelshift />} 
  {game.id === 'cipherpunk' && <Cipherpunk />} 
  {game.id === 'numberdrop' && <Numberdrop />} 
  {game.id === 'geopixel' && <Geopixel />} 
  {game.id === 'semanticlimb' && <Semanticlimb />} 
  {game.id === 'wordhedge' && <Wordhedge />} 
  {game.id === 'kanjiforge' && <Kanjiforge />} 
  {game.id === 'nanojoker' && <Nanojoker />} 
  {game.id === 'orbit-survivors' && <OrbitSurvivors />} 
  {game.id === 'pegdungeon' && <Pegdungeon />} 
  {game.id === 'speed-typing' && <SpeedTyping />}
  {game.id === 'sudoku' && <Sudoku />}
  {game.id === 'flappy-cyber' && <FlappyCyber />} 
  {game.id === 'chronowave' && <ChronoWave />} 
  {game.id === 'quantumweave' && <QuantumWeave />} 
  {game.id === 'gravityforge' && <GravityForge />} 
  {game.id === 'synthia' && <Synthia />} 
  {game.id === 'morphoflora' && <MorphoFlora />} 
  {game.id === 'prismpulse' && <PrismPulse />} 
  {game.id === 'clockworkheist' && <ClockworkHeist />} 
  {game.id === 'geothermal' && <GeoThermal />} 
  {game.id === 'neurolink' && <NeuroLink />} 
  {game.id === 'tectonicdrift' && <TectonicDrift />} 
</GameLayout>
