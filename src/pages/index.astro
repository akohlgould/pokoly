---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { GAMES, CATEGORIES } from '../data/games';

const siteUrl = (Astro.site?.toString() || 'https://pokoly.com').replace(/\/$/, '');

// Featured Marquee Game
const featuredGame = GAMES.find(g => g.id === 'fruit-merge') || GAMES[0];

// Secondary Marquee Highlights
const secondarySpotlights = [
  GAMES.find(g => g.id === 'cymatica') || GAMES[1],
  GAMES.find(g => g.id === 'word-guess') || GAMES[2],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[3],
];

// Trending Hits
const trendingGames = [
  GAMES.find(g => g.id === 'fruit-merge') || GAMES[0],
  GAMES.find(g => g.id === 'cymatica') || GAMES[1],
  GAMES.find(g => g.id === 'word-guess') || GAMES[2],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[3],
  GAMES.find(g => g.id === 'chronotrail') || GAMES[4],
  GAMES.find(g => g.id === 'nanojoker') || GAMES[5],
];

// Curated Brain & Word Shelf
const brainPicks = [
  GAMES.find(g => g.id === 'word-guess') || GAMES[0],
  GAMES.find(g => g.id === 'synapse') || GAMES[1],
  GAMES.find(g => g.id === 'lexifall') || GAMES[2],
  GAMES.find(g => g.id === 'sudoku') || GAMES[3],
  GAMES.find(g => g.id === 'cipherpunk') || GAMES[4],
  GAMES.find(g => g.id === 'neon-2048') || GAMES[5],
];

// Curated Physics & Action Shelf
const physicsPicks = [
  GAMES.find(g => g.id === 'fruit-merge') || GAMES[0],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[1],
  GAMES.find(g => g.id === 'gravifold') || GAMES[2],
  GAMES.find(g => g.id === 'bouncygolf') || GAMES[3],
  GAMES.find(g => g.id === 'breakout-sandbox') || GAMES[4],
  GAMES.find(g => g.id === 'jellydrop') || GAMES[5],
];

const categoryCounts = {
  puzzle: GAMES.filter(g => g.category === 'puzzle').length,
  arcade: GAMES.filter(g => g.category === 'arcade').length,
  physics: GAMES.filter(g => g.category === 'physics').length,
  word: GAMES.filter(g => g.category === 'word').length,
  card: GAMES.filter(g => g.category === 'card').length,
};

const portalSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pokoly - Free Browser Games & Arcade Portal',
    url: `${siteUrl}/`,
    description: `Play ${GAMES.length}+ free browser games with no downloads or logins. Word puzzles, physics drops, Solitaire, retro arcade, and minesweeper.`,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteUrl}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Pokoly',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/logos/pokoly-icon.svg`
  }
];
---

<BaseLayout
  title="Pokoly - Free Browser Games, Instant Play & Unblocked"
  description={`Play ${GAMES.length}+ free browser games with no download or login. Cosmic fruit merge, Cymatica acoustic resonance, word puzzles, Klondike solitaire, and arcade classics. Fast 60 FPS on any device.`}
  canonical={`${siteUrl}/`}
  schema={portalSchema}
>
  <main class="mx-auto max-w-7xl px-4 py-5 sm:px-6 space-y-8">
    <!-- Hero Section -->
    <section class="rounded-lg border border-zinc-800 bg-[#0c0e15] p-5 sm:p-7">
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12 lg:gap-8">
        <!-- Hero Left Column -->
        <div class="lg:col-span-7 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded border border-zinc-800 bg-zinc-900 px-2.5 py-1 font-mono text-[11px] text-zinc-300">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              <span>{GAMES.length} Compiled Games</span>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded border border-zinc-800 bg-zinc-900 px-2.5 py-1 font-mono text-[11px] text-zinc-400">
              <span>Canvas 2D / WebGL</span>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded border border-zinc-800 bg-zinc-900 px-2.5 py-1 font-mono text-[11px] text-zinc-400">
              <span>Zero Telemetry</span>
            </span>
          </div>

          <h1 class="font-sans text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl leading-tight">
            Client-Side Arcade. <br />
            <span class="text-zinc-400">Zero Latency Browser Games.</span>
          </h1>

          <p class="max-w-xl text-xs sm:text-sm text-zinc-400 leading-relaxed">
            {GAMES.length} HTML5 Canvas and WebGL games executed entirely in-browser. Zero external runtime dependencies, zero user registration, and deterministic save state persistence via localStorage.
          </p>

          <!-- Primary Hero Actions -->
          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            <a
              href={`/games/${featuredGame.slug}/`}
              class="inline-flex items-center gap-2 rounded border border-zinc-600 bg-zinc-100 px-4 py-2 font-mono text-xs font-semibold text-zinc-900 transition-colors hover:bg-white"
            >
              <span>Launch Featured: {featuredGame.title.split(':')[0]}</span>
              <span class="text-zinc-600">→</span>
            </a>

            <button
              id="hero-surprise-btn"
              class="inline-flex items-center gap-1.5 rounded border border-zinc-800 bg-zinc-900 px-3.5 py-2 font-mono text-xs font-medium text-zinc-300 transition-colors hover:border-zinc-600 hover:text-white cursor-pointer"
            >
              <span>🎲 Random Game</span>
            </button>

            <button
              id="hero-search-jump-btn"
              class="inline-flex items-center gap-1.5 rounded border border-zinc-800 bg-zinc-900/60 px-3 py-2 font-mono text-xs text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200 cursor-pointer"
            >
              <span>Search Library</span>
              <kbd class="rounded border border-zinc-700 bg-zinc-800 px-1 py-0.2 text-[10px] text-zinc-300">/</kbd>
            </button>
          </div>

          <!-- Feature Highlights Bar -->
          <div class="grid grid-cols-3 gap-3 border-t border-zinc-800/80 pt-3.5 text-xs">
            <div>
              <span class="font-mono text-xs font-semibold text-zinc-200">{GAMES.length} Games</span>
              <div class="font-mono text-[10px] text-zinc-500">Standalone Bundles</div>
            </div>
            <div>
              <span class="font-mono text-xs font-semibold text-emerald-400">60 Hz Loop</span>
              <div class="font-mono text-[10px] text-zinc-500">RAF Sync</div>
            </div>
            <div>
              <span class="font-mono text-xs font-semibold text-zinc-200">100% Free</span>
              <div class="font-mono text-[10px] text-zinc-500">No Account Required</div>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: Curated Marquee Spotlight -->
        <div class="lg:col-span-5">
          <div class="rounded border border-zinc-800 bg-[#0d0f17] p-3.5">
            <div class="flex items-center justify-between border-b border-zinc-800 pb-2 text-xs">
              <span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-zinc-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                Featured Title
              </span>
              <span class="font-mono text-[10px] text-amber-400">
                ★ {featuredGame.rating}
              </span>
            </div>

            <!-- Spotlight Visual -->
            <a
              href={`/games/${featuredGame.slug}/`}
              class="group relative my-2.5 flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded border border-zinc-800 bg-black"
            >
              <img
                src={`/screenshots/${featuredGame.slug}.webp`}
                alt={`${featuredGame.title} Gameplay Screenshot`}
                class="h-full w-full object-cover object-center"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>

              <div class="absolute top-2 left-2 flex items-center gap-1.5 rounded border border-zinc-800 bg-black/90 px-2 py-0.5 font-sans text-xs font-semibold text-white">
                <img src={`/logos/${featuredGame.slug}.svg`} alt="" class="h-4 w-4 object-contain" />
                <span>{featuredGame.title.split(':')[0]}</span>
              </div>

              <div class="absolute bottom-2 right-2 rounded border border-zinc-800 bg-black/90 px-1.5 py-0.5 font-mono text-[9px] text-zinc-300">
                60 FPS
              </div>
            </a>

            <div>
              <a href={`/games/${featuredGame.slug}/`} class="group inline-block">
                <h2 class="font-sans text-base font-bold text-white group-hover:text-zinc-300 transition-colors">
                  {featuredGame.title}
                </h2>
              </a>
              <p class="mt-1 line-clamp-2 text-xs text-zinc-400 leading-normal">
                {featuredGame.tagline}
              </p>
            </div>

            <!-- Also Trending Companion Mini Row -->
            <div class="mt-3 border-t border-zinc-800 pt-2.5">
              <div class="mb-1.5 font-mono text-[10px] uppercase tracking-wider text-zinc-500">Popular Companions:</div>
              <div class="grid grid-cols-3 gap-1.5">
                {secondarySpotlights.map(sec => (
                  <a
                    href={`/games/${sec.slug}/`}
                    class="group flex items-center gap-2 rounded border border-zinc-800 bg-zinc-900/60 p-1.5 transition-colors hover:border-zinc-600 hover:bg-zinc-800/80"
                  >
                    <img
                      src={`/screenshots/${sec.slug}.webp`}
                      alt={sec.title}
                      class="h-8 w-8 rounded border border-zinc-800 object-cover shrink-0"
                      loading="lazy"
                    />
                    <div class="truncate font-sans text-[11px] font-medium text-zinc-300 group-hover:text-white">
                      {sec.title.split(':')[0]}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Quick Navigation Bar -->
    <section>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
        <button
          data-jump-cat="puzzle"
          class="cat-nav-tile group flex items-center gap-2.5 rounded border border-zinc-800 bg-[#0d0f17] p-2.5 text-left transition-colors hover:border-zinc-600 hover:bg-[#111420] cursor-pointer"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded border border-zinc-800 bg-zinc-900 text-sm">
            🧩
          </span>
          <div>
            <div class="text-xs font-semibold text-zinc-200 group-hover:text-white">Puzzle &amp; Logic</div>
            <div class="font-mono text-[10px] text-zinc-500">{categoryCounts.puzzle} titles</div>
          </div>
        </button>

        <button
          data-jump-cat="arcade"
          class="cat-nav-tile group flex items-center gap-2.5 rounded border border-zinc-800 bg-[#0d0f17] p-2.5 text-left transition-colors hover:border-zinc-600 hover:bg-[#111420] cursor-pointer"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded border border-zinc-800 bg-zinc-900 text-sm">
            💥
          </span>
          <div>
            <div class="text-xs font-semibold text-zinc-200 group-hover:text-white">Retro Arcade</div>
            <div class="font-mono text-[10px] text-zinc-500">{categoryCounts.arcade} titles</div>
          </div>
        </button>

        <button
          data-jump-cat="physics"
          class="cat-nav-tile group flex items-center gap-2.5 rounded border border-zinc-800 bg-[#0d0f17] p-2.5 text-left transition-colors hover:border-zinc-600 hover:bg-[#111420] cursor-pointer"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded border border-zinc-800 bg-zinc-900 text-sm">
            ⚛️
          </span>
          <div>
            <div class="text-xs font-semibold text-zinc-200 group-hover:text-white">Physics Sandbox</div>
            <div class="font-mono text-[10px] text-zinc-500">{categoryCounts.physics} titles</div>
          </div>
        </button>

        <button
          data-jump-cat="word"
          class="cat-nav-tile group flex items-center gap-2.5 rounded border border-zinc-800 bg-[#0d0f17] p-2.5 text-left transition-colors hover:border-zinc-600 hover:bg-[#111420] cursor-pointer"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded border border-zinc-800 bg-zinc-900 text-sm">
            🔤
          </span>
          <div>
            <div class="text-xs font-semibold text-zinc-200 group-hover:text-white">Word &amp; Brain</div>
            <div class="font-mono text-[10px] text-zinc-500">{categoryCounts.word} titles</div>
          </div>
        </button>

        <button
          data-jump-cat="card"
          class="cat-nav-tile col-span-2 sm:col-span-1 group flex items-center gap-2.5 rounded border border-zinc-800 bg-[#0d0f17] p-2.5 text-left transition-colors hover:border-zinc-600 hover:bg-[#111420] cursor-pointer"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded border border-zinc-800 bg-zinc-900 text-sm">
            🃏
          </span>
          <div>
            <div class="text-xs font-semibold text-zinc-200 group-hover:text-white">Card Roguelikes</div>
            <div class="font-mono text-[10px] text-zinc-500">{categoryCounts.card} titles</div>
          </div>
        </button>
      </div>
    </section>

    <!-- Curated Shelf 1: Trending Now with Screenshots -->
    <section>
      <div class="flex items-center justify-between pb-2.5">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-zinc-400">01 //</span>
          <h2 class="font-sans text-base font-bold text-zinc-100">Trending Now</h2>
        </div>
        <a href="#catalog" class="font-mono text-[11px] text-zinc-400 hover:text-white transition-colors">
          View All ({GAMES.length}) →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
        {trendingGames.map(g => (
          <a
            href={`/games/${g.slug}/`}
            class="group flex flex-col rounded border border-zinc-800 bg-[#0d0f17] p-2 transition-colors hover:border-zinc-600 hover:bg-[#111420]"
          >
            <div
              class="relative flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded border border-zinc-800 bg-black"
            >
              <img
                src={`/screenshots/${g.slug}.webp`}
                alt={`${g.title} Screenshot`}
                class="h-full w-full object-cover object-center"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute top-1 left-1 rounded border border-zinc-800 bg-black/90 p-0.5">
                <img src={`/logos/${g.slug}.svg`} alt="" class="h-3.5 w-3.5 object-contain" />
              </div>
            </div>
            <div class="mt-1.5 truncate w-full font-sans text-xs font-semibold text-zinc-200 group-hover:text-white">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-zinc-400">
              <span class="text-amber-400">★ {g.rating}</span>
              <span class="capitalize text-zinc-500">{g.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Curated Shelf 2: Brain & Word Puzzles with Screenshots -->
    <section>
      <div class="flex items-center justify-between pb-2.5">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-zinc-400">02 //</span>
          <h2 class="font-sans text-base font-bold text-zinc-100">Mind &amp; Deduction Puzzles</h2>
        </div>
        <button data-jump-cat="word" class="cat-nav-link font-mono text-[11px] text-zinc-400 hover:text-white transition-colors cursor-pointer">
          Word Catalog →
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
        {brainPicks.map(g => (
          <a
            href={`/games/${g.slug}/`}
            class="group flex flex-col rounded border border-zinc-800 bg-[#0d0f17] p-2 transition-colors hover:border-zinc-600 hover:bg-[#111420]"
          >
            <div
              class="relative flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded border border-zinc-800 bg-black"
            >
              <img
                src={`/screenshots/${g.slug}.webp`}
                alt={`${g.title} Screenshot`}
                class="h-full w-full object-cover object-center"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute top-1 left-1 rounded border border-zinc-800 bg-black/90 p-0.5">
                <img src={`/logos/${g.slug}.svg`} alt="" class="h-3.5 w-3.5 object-contain" />
              </div>
            </div>
            <div class="mt-1.5 truncate w-full font-sans text-xs font-semibold text-zinc-200 group-hover:text-white">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-zinc-400">
              <span class="text-amber-400">★ {g.rating}</span>
              <span class="capitalize text-zinc-500">{g.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Curated Shelf 3: Physics & Sandbox Classics with Screenshots -->
    <section>
      <div class="flex items-center justify-between pb-2.5">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-zinc-400">03 //</span>
          <h2 class="font-sans text-base font-bold text-zinc-100">Physics &amp; Kinetic Drops</h2>
        </div>
        <button data-jump-cat="physics" class="cat-nav-link font-mono text-[11px] text-zinc-400 hover:text-white transition-colors cursor-pointer">
          Physics Catalog →
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
        {physicsPicks.map(g => (
          <a
            href={`/games/${g.slug}/`}
            class="group flex flex-col rounded border border-zinc-800 bg-[#0d0f17] p-2 transition-colors hover:border-zinc-600 hover:bg-[#111420]"
          >
            <div
              class="relative flex aspect-[16/10] w-full items-center justify-center overflow-hidden rounded border border-zinc-800 bg-black"
            >
              <img
                src={`/screenshots/${g.slug}.webp`}
                alt={`${g.title} Screenshot`}
                class="h-full w-full object-cover object-center"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute top-1 left-1 rounded border border-zinc-800 bg-black/90 p-0.5">
                <img src={`/logos/${g.slug}.svg`} alt="" class="h-3.5 w-3.5 object-contain" />
              </div>
            </div>
            <div class="mt-1.5 truncate w-full font-sans text-xs font-semibold text-zinc-200 group-hover:text-white">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-zinc-400">
              <span class="text-amber-400">★ {g.rating}</span>
              <span class="capitalize text-zinc-500">{g.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Main Arcade Library & Complete Catalog Section -->
    <section id="catalog" class="pt-4 border-t border-zinc-800">
      <!-- Toolbar: Title, Count & Instant Search -->
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-zinc-800 pb-3.5">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="font-sans text-xl sm:text-2xl font-bold text-white">
              All Arcade Games
            </h2>
            <span id="catalog-count-badge" class="rounded border border-zinc-800 bg-zinc-900 px-2 py-0.5 font-mono text-xs text-zinc-400">
              {GAMES.length} Titles
            </span>
          </div>
          <p class="mt-0.5 text-xs text-zinc-400">
            Search titles, genres, or keywords. Press <kbd class="px-1 py-0.2 rounded border border-zinc-700 bg-zinc-800 text-[10px] font-mono text-zinc-300">/</kbd> to focus search.
          </p>
        </div>

        <!-- Search Bar with Clear Button -->
        <div class="relative w-full sm:w-72">
          <input
            id="game-search-input"
            type="text"
            placeholder={`Search ${GAMES.length} games...`}
            class="w-full rounded border border-zinc-800 bg-[#0d0f17] px-3 py-1.5 pl-8 pr-7 text-xs text-zinc-100 placeholder-zinc-500 focus:border-zinc-500 focus:bg-[#111420] focus:outline-none transition-colors"
          />
          <span class="absolute left-2.5 top-2 text-xs text-zinc-500 pointer-events-none">⌕</span>
          <button
            id="search-clear-btn"
            class="hidden absolute right-2.5 top-1.5 text-xs text-zinc-400 hover:text-white px-1 py-0.5 rounded cursor-pointer"
            title="Clear search"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-3 flex flex-wrap items-center gap-1.5">
        <button
          data-category="all"
          class="cat-filter-btn rounded border border-zinc-500 bg-zinc-800 px-3 py-1 font-mono text-[11px] font-semibold text-zinc-100 transition-colors cursor-pointer"
        >
          All ({GAMES.length})
        </button>

        <button
          data-category="favorites"
          id="btn-filter-favs"
          class="cat-filter-btn rounded border border-zinc-800 bg-[#0d0f17] px-3 py-1 font-mono text-[11px] font-medium text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200 cursor-pointer"
        >
          Favorites (<span id="favs-count">0</span>)
        </button>

        {CATEGORIES.slice(1).map(cat => {
          const count = GAMES.filter(g => g.category === cat.id).length;
          return (
            <button
              data-category={cat.id}
              class="cat-filter-btn rounded border border-zinc-800 bg-[#0d0f17] px-3 py-1 font-mono text-[11px] font-medium text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200 cursor-pointer"
            >
              <span>{cat.name} ({count})</span>
            </button>
          );
        })}
      </div>

      <!-- Games Grid with Screenshots -->
      <div id="games-grid" class="mt-5 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 items-stretch">
        {GAMES.map(game => (
          <div
            data-game-category={game.category}
            data-game-title={game.title.toLowerCase()}
            data-game-slug={game.slug}
            data-game-keywords={game.keywords.join(' ').toLowerCase()}
            class="game-item-card h-full flex flex-col"
          >
            <GameCard game={game} />
          </div>
        ))}
      </div>

      <!-- Empty Results State -->
      <div id="no-results-msg" class="hidden py-12 text-center text-zinc-400">
        <p class="text-sm font-semibold text-zinc-200">No games match query</p>
        <p class="mt-1 font-mono text-xs text-zinc-500">Try keywords like word, physics, 2048, or card.</p>
        <button
          id="reset-search-btn"
          class="mt-3 rounded border border-zinc-700 bg-zinc-850 px-3 py-1 font-mono text-xs text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors cursor-pointer"
        >
          Reset Filter
        </button>
      </div>
    </section>

    <!-- Technical Architecture & Specifications Section -->
    <section class="border-t border-zinc-800 pt-8 pb-4 text-xs">
      <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-300">
            Platform Architecture &amp; Runtime Specifications
          </h2>
          <p class="mt-0.5 text-xs text-zinc-500">
            Deterministic client-side compilation targeting modern web standards.
          </p>
        </div>
        <a
          href="/unblocked/"
          class="inline-flex items-center gap-1 font-mono text-[11px] text-zinc-400 hover:text-zinc-200 transition-colors"
        >
          <span>View Unblocked Routing Specs</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="rounded border border-zinc-800 bg-[#0d0f17] p-3 space-y-1.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-zinc-500">Graphics &amp; Audio</div>
          <div class="font-sans text-xs font-semibold text-zinc-200">HTML5 Canvas &amp; WebGL 2.0</div>
          <p class="text-[11px] text-zinc-400 leading-relaxed">
            60 Hz frame synchronized render loops driven by <code class="font-mono text-[10px] text-zinc-300">requestAnimationFrame</code>. Web Audio API synthesizers for procedural low-latency effects.
          </p>
        </div>

        <div class="rounded border border-zinc-800 bg-[#0d0f17] p-3 space-y-1.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-zinc-500">Network &amp; Bundling</div>
          <div class="font-sans text-xs font-semibold text-zinc-200">Zero Runtime Server Calls</div>
          <p class="text-[11px] text-zinc-400 leading-relaxed">
            Static ES module bundles cached at the edge on Cloudflare Pages CDN. Games run entirely in memory after initial asset fetch.
          </p>
        </div>

        <div class="rounded border border-zinc-800 bg-[#0d0f17] p-3 space-y-1.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-zinc-500">Input Subsystems</div>
          <div class="font-sans text-xs font-semibold text-zinc-200">Multi-Device Pointer Events</div>
          <p class="text-[11px] text-zinc-400 leading-relaxed">
            Unified touch, mouse, and keyboard listeners with default passive event prevention. Responsive viewport scaling across desktop and mobile.
          </p>
        </div>

        <div class="rounded border border-zinc-800 bg-[#0d0f17] p-3 space-y-1.5">
          <div class="font-mono text-[10px] uppercase tracking-wider text-zinc-500">Persistence Model</div>
          <div class="font-sans text-xs font-semibold text-zinc-200">W3C localStorage Engine</div>
          <p class="text-[11px] text-zinc-400 leading-relaxed">
            High scores, save data, and game states persist locally in browser storage. Zero cross-site tracking cookies, zero analytics beacons.
          </p>
        </div>
      </div>
    </section>

    <!-- AdSlot (Only renders when ads enabled) -->
    <AdSlot slot="footer-banner" />
  </main>
</BaseLayout>

<script>
  import { player } from '../utils/player';
  import { GAMES } from '../data/games';

  const searchInput = document.getElementById('game-search-input') as HTMLInputElement;
  const searchClearBtn = document.getElementById('search-clear-btn');
  const filterBtns = document.querySelectorAll('.cat-filter-btn');
  const cards = document.querySelectorAll('.game-item-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results-msg')!;
  const resetBtn = document.getElementById('reset-search-btn');
  const favsCountEl = document.getElementById('favs-count');
  const catalogCountBadge = document.getElementById('catalog-count-badge');
  const jumpSearchBtn = document.getElementById('hero-search-jump-btn');

  let activeCategory = 'all';

  function updateFavsCount() {
    if (favsCountEl) {
      favsCountEl.textContent = player.getProfile().favorites.length.toString();
    }
  }
  updateFavsCount();
  player.subscribe(updateFavsCount);

  function applyFilter() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    if (searchClearBtn) {
      if (query.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }

    const favs = player.getProfile().favorites;
    let visibleCount = 0;

    cards.forEach(card => {
      const cat = card.getAttribute('data-game-category') || '';
      const title = card.getAttribute('data-game-title') || '';
      const slug = card.getAttribute('data-game-slug') || '';
      const keywords = card.getAttribute('data-game-keywords') || '';

      let matchCat = false;
      if (activeCategory === 'all') {
        matchCat = true;
      } else if (activeCategory === 'favorites') {
        matchCat = favs.includes(slug);
      } else {
        matchCat = cat === activeCategory;
      }

      const matchQuery = !query || title.includes(query) || cat.includes(query) || keywords.includes(query);

      if (matchCat && matchQuery) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (catalogCountBadge) {
      catalogCountBadge.textContent = `${visibleCount} Title${visibleCount === 1 ? '' : 's'}`;
    }

    if (visibleCount === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  // Active / inactive button styles
  const activeClass = 'cat-filter-btn rounded border border-zinc-500 bg-zinc-800 px-3 py-1 font-mono text-[11px] font-semibold text-zinc-100 transition-colors cursor-pointer';
  const inactiveClass = 'cat-filter-btn rounded border border-zinc-800 bg-[#0d0f17] px-3 py-1 font-mono text-[11px] font-medium text-zinc-400 transition-colors hover:border-zinc-700 hover:text-zinc-200 cursor-pointer';

  function selectCategory(cat: string) {
    activeCategory = cat;
    filterBtns.forEach(b => {
      if (b.getAttribute('data-category') === cat) {
        b.className = activeClass;
      } else {
        b.className = inactiveClass;
      }
    });
    applyFilter();
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category') || 'all';
      selectCategory(cat);
    });
  });

  // Top category navigation tiles & links
  document.querySelectorAll('[data-jump-cat]').forEach(tile => {
    tile.addEventListener('click', () => {
      const cat = tile.getAttribute('data-jump-cat');
      if (cat) {
        selectCategory(cat);
        const catalogEl = document.getElementById('catalog');
        catalogEl?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  searchInput?.addEventListener('input', applyFilter);

  function focusSearch() {
    const catalogEl = document.getElementById('catalog');
    catalogEl?.scrollIntoView({ behavior: 'smooth' });
    setTimeout(() => {
      searchInput?.focus();
    }, 300);
  }

  jumpSearchBtn?.addEventListener('click', focusSearch);

  // Keyboard shortcut '/' to focus search
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      focusSearch();
    }
  });

  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    applyFilter();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    selectCategory('all');
  });

  // Hero Surprise trigger
  document.getElementById('hero-surprise-btn')?.addEventListener('click', () => {
    const chosen = GAMES[Math.floor(Math.random() * GAMES.length)];
    if (chosen) {
      window.location.href = `/games/${chosen.slug}/`;
    }
  });
</script>