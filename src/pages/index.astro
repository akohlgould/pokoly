---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { GAMES, CATEGORIES } from '../data/games';

const siteUrl = (Astro.site?.toString() || 'https://pokoly.com').replace(/\/$/, '');
const featuredGame = GAMES.find(g => g.id === 'fruit-merge') || GAMES[0];

const portalSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pokoly - Free Browser Games & Arcade Portal',
  url: siteUrl,
  description: 'Play popular online games free with no download. Word puzzles, Suika physics drop, Solitaire, 2048, retro arcade, and minesweeper.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Pokoly.com - 100% Free Browser Games, Instant Play & Unblocked"
  description="Play popular online games free with no download or login. Suika fruit merge, Wordle unlimited, Klondike solitaire, 2048 neon, retro snake, and breakout. Fast 60 FPS on any device."
  canonical={siteUrl}
  schema={portalSchema}
>
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
    <!-- Hero Banner with High Visual Appeal -->
    <section class="relative overflow-hidden rounded-3xl border border-brand-border bg-gradient-to-br from-brand-card via-brand-dark to-brand-card/70 p-6 sm:p-10 shadow-2xl">
      <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-brand-neon/15 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 h-72 w-72 rounded-full bg-brand-accent/15 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <!-- Daily Habit & Streak Callout -->
          <button
            id="hero-streak-pill"
            class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1 text-xs text-amber-300 shadow-sm hover:bg-amber-500/20 transition-all cursor-pointer"
          >
            <span class="text-sm animate-pulse">🔥</span>
            <span class="font-bold">Daily Habit: Keep Your Streak Alive!</span>
            <span class="text-gray-400 font-normal ml-1">Claim XP →</span>
          </button>

          <h1 class="mt-4 font-display text-3xl font-black tracking-tight text-white sm:text-5xl lg:leading-tight">
            Play Addictive Free Games. <br />
            <span class="bg-gradient-to-r from-brand-neon via-indigo-400 to-brand-pink bg-clip-text text-transparent">
              No Downloads. No Login.
            </span>
          </h1>

          <p class="mt-4 max-w-xl text-sm sm:text-base text-gray-300 leading-relaxed">
            The instant-play web arcade for all ages. Experience buttery smooth 60 FPS physics, instant procedural retro audio, and earn trophies on every play.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              href={`/games/${featuredGame.slug}`}
              class="flex items-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-500 via-brand-accent to-pink-500 px-6 py-3.5 font-display font-bold text-white shadow-xl shadow-indigo-500/30 transition-all hover:scale-105 active:scale-95 text-sm"
            >
              <span>🎮 Play Featured: {featuredGame.title.split(':')[0]}</span>
              <span>→</span>
            </a>

            <button
              id="hero-surprise-btn"
              class="rounded-2xl border border-brand-border bg-brand-dark/80 px-5 py-3.5 text-sm font-semibold text-gray-200 transition-all hover:border-brand-neon hover:text-white active:scale-95 flex items-center gap-1.5"
            >
              <span>🎲</span>
              <span>Surprise Me</span>
            </button>
          </div>

          <!-- Social Proof Ticker Highlights -->
          <div class="mt-8 flex flex-wrap items-center gap-4 sm:gap-6 border-t border-brand-border/40 pt-4 text-xs text-gray-400 font-mono">
            <div>🔥 <span class="text-white font-bold">21.5M+</span> Plays This Month</div>
            <div>⚡ <span class="text-emerald-400 font-bold">&lt; 15ms</span> Load Time</div>
            <div>📱 Phone, Tablet &amp; Laptop Ready</div>
          </div>
        </div>

        <!-- Featured Spotlight Card -->
        <div class="lg:col-span-5">
          <a
            href={`/games/${featuredGame.slug}`}
            class="group block relative overflow-hidden rounded-3xl border-2 border-brand-accent/50 bg-brand-dark p-6 shadow-2xl transition-all duration-300 hover:border-brand-neon hover:shadow-brand-neon/20 hover:-translate-y-1"
          >
            <div class="flex items-center justify-between text-xs">
              <span class="rounded-full bg-brand-accent/20 px-2.5 py-0.5 font-mono text-[10px] text-brand-neon">
                {featuredGame.subdomain}.pokoly.com
              </span>
              <span class="rounded-full bg-amber-500/20 px-2.5 py-0.5 font-bold text-amber-400 border border-amber-500/30">
                ⭐ Viral Sensation
              </span>
            </div>

            <div class="my-6 flex h-32 w-full items-center justify-center rounded-2xl bg-gradient-to-br from-brand-card to-brand-dark text-6xl group-hover:scale-110 transition-transform shadow-inner">
              🍉
            </div>

            <h3 class="font-display text-xl font-bold text-white group-hover:text-brand-neon transition-colors">
              {featuredGame.title}
            </h3>
            <p class="mt-1 text-xs text-gray-400 line-clamp-2">
              {featuredGame.tagline}
            </p>

            <div class="mt-4 flex items-center justify-between border-t border-brand-border/40 pt-3 text-xs">
              <span class="font-mono text-gray-400">👥 {featuredGame.playCount} sessions</span>
              <span class="font-bold text-brand-accent group-hover:text-brand-neon transition-colors flex items-center gap-1">
                <span>Instant Launch</span>
                <span>🚀</span>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Top Leaderboard Ad Slot -->
    <div class="my-8 flex justify-center">
      <AdSlot slot="leaderboard" />
    </div>

    <!-- Catalog Header & Search Filter -->
    <section id="catalog" class="mt-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-brand-border/60 pb-5">
        <div>
          <h2 class="font-display text-2xl font-black text-white">
            Free Online Games
          </h2>
          <p class="mt-0.5 text-xs text-gray-400">
            Click any game to launch in full screen or on its standalone subdomain.
          </p>
        </div>

        <!-- Real-Time Search Bar -->
        <div class="relative w-full sm:w-72">
          <input
            id="game-search-input"
            type="text"
            placeholder="Search games, words, solitaire..."
            class="w-full rounded-2xl border border-brand-border bg-brand-card/90 px-4 py-2.5 pl-10 text-xs text-white placeholder-gray-500 focus:border-brand-neon focus:outline-none transition-colors"
          />
          <span class="absolute left-3.5 top-3 text-xs text-gray-400">🔍</span>
        </div>
      </div>

      <!-- Category Filter Pills with Favorites Tab -->
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          data-category="all"
          class="cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/15 px-3 py-1.5 text-xs font-semibold text-brand-neon transition-all"
        >
          🎮 All ({GAMES.length})
        </button>
        <button
          data-category="favorites"
          id="btn-filter-favs"
          class="cat-filter-btn rounded-xl border border-brand-border bg-brand-card px-3 py-1.5 text-xs font-medium text-gray-300 transition-all hover:border-pink-500 hover:text-pink-300"
        >
          <span>❤️</span>
          <span class="ml-1">Favorites (<span id="favs-count">0</span>)</span>
        </button>
        {CATEGORIES.slice(1).map(cat => (
          <button
            data-category={cat.id}
            class="cat-filter-btn rounded-xl border border-brand-border bg-brand-card px-3 py-1.5 text-xs font-medium text-gray-300 transition-all hover:border-brand-neon hover:text-white"
          >
            <span>{cat.icon}</span>
            <span class="ml-1">{cat.name}</span>
          </button>
        ))}
      </div>

      <!-- Games Grid -->
      <div id="games-grid" class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {GAMES.map(game => (
          <div data-game-category={game.category} data-game-title={game.title.toLowerCase()} data-game-slug={game.slug} class="game-item-card">
            <GameCard game={game} />
          </div>
        ))}
      </div>

      <div id="no-results-msg" class="hidden py-16 text-center text-gray-400">
        <span class="text-4xl">🔍</span>
        <p class="mt-2 text-sm font-semibold text-white">No games match this filter.</p>
        <button id="reset-search-btn" class="mt-3 text-xs text-brand-neon underline font-medium">Clear filter</button>
      </div>
    </section>

    <!-- Viral Challenge Friends Callout Banner -->
    <section class="mt-14 rounded-3xl border border-indigo-500/40 bg-gradient-to-r from-indigo-950/40 via-brand-card to-brand-dark p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="flex items-center gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-500/20 text-3xl border border-indigo-500/40">
          ⚔️
        </div>
        <div>
          <h3 class="font-display text-lg font-bold text-white">Got Friends or Classmates? Challenge Them!</h3>
          <p class="mt-1 text-xs text-gray-300 max-w-xl leading-relaxed">
            Generate custom challenge links with your high score as the target. Zero login required for your friends to jump straight in and play.
          </p>
        </div>
      </div>
      <button
        id="home-challenge-btn"
        class="shrink-0 rounded-2xl bg-gradient-to-r from-indigo-500 to-brand-accent px-6 py-3 text-xs font-bold text-white shadow-lg shadow-indigo-500/25 hover:scale-105 active:scale-95 transition-transform"
      >
        Create Challenge Link 🚀
      </button>
    </section>

    <!-- Subdomain Direct Access Directory -->
    <section class="mt-14 rounded-3xl border border-brand-border bg-brand-card/30 p-6 sm:p-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-md bg-brand-accent/20 px-2.5 py-1 font-mono text-[11px] font-semibold text-brand-accent">
          🌐 Direct Subdomain Hubs
        </div>
        <h2 class="mt-3 font-display text-2xl font-bold text-white">
          Individual Game Hubs on Subdomains
        </h2>
        <p class="mt-1.5 text-xs sm:text-sm text-gray-300 leading-relaxed">
          Each game runs as its own standalone web app on its dedicated subdomain with zero arcade chrome. Save your favorites directly to your homescreen or browser bookmarks:
        </p>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          {GAMES.map(game => (
            <a
              href={`https://${game.subdomain}.pokoly.com`}
              target="_blank"
              class="flex items-center justify-between rounded-2xl border border-brand-border/60 bg-brand-dark/70 px-4 py-3 text-xs transition-all hover:border-brand-neon hover:bg-brand-dark"
            >
              <span class="font-bold text-white">{game.title.split(':')[0]}</span>
              <span class="font-mono text-[11px] text-brand-neon">.{game.subdomain} ↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO & Unblocked Authority Copy -->
    <section class="mt-14 border-t border-brand-border/60 pt-10 text-xs text-gray-400 leading-relaxed space-y-4">
      <h2 class="font-display text-xl font-bold text-white">
        Why Millions Play Free Online Games at Pokoly
      </h2>
      <p>
        Pokoly is built for instant fun. Unlike traditional gaming sites crammed with full-page intrusive popups and sluggish loading bars, our entire library compiles directly to static HTML5 Canvas and WebGL modules. Every click launches in milliseconds.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div class="rounded-2xl border border-brand-border/40 bg-brand-card/20 p-4">
          <h3 class="font-semibold text-white text-sm">🔥 Daily Play Streaks</h3>
          <p class="mt-1.5 text-gray-400">Keep your flame burning every day. Unlock achievements, level up your player profile, and collect rewards.</p>
        </div>
        <div class="rounded-2xl border border-brand-border/40 bg-brand-card/20 p-4">
          <h3 class="font-semibold text-white text-sm">⚔️ Frictionless Friend Challenges</h3>
          <p class="mt-1.5 text-gray-400">One-click brag cards and deep challenge links allow you to duel friends on WhatsApp, Discord, TikTok, and X.</p>
        </div>
        <div class="rounded-2xl border border-brand-border/40 bg-brand-card/20 p-4">
          <h3 class="font-semibold text-white text-sm">⚡ 100% Client-Side Physics</h3>
          <p class="mt-1.5 text-gray-400">Instant response time with zero latency, low battery usage, and full touchscreen optimization.</p>
        </div>
      </div>
    </section>

    <!-- Footer Banner Ad Slot -->
    <div class="mt-14 flex justify-center">
      <AdSlot slot="footer-banner" />
    </div>
  </main>
</BaseLayout>

<script>
  import { player } from '../utils/player';

  const searchInput = document.getElementById('game-search-input') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.cat-filter-btn');
  const cards = document.querySelectorAll('.game-item-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results-msg')!;
  const resetBtn = document.getElementById('reset-search-btn');
  const favsCountEl = document.getElementById('favs-count');

  let activeCategory = 'all';

  function updateFavsCount() {
    if (favsCountEl) {
      favsCountEl.textContent = player.getProfile().favorites.length.toString();
    }
  }
  updateFavsCount();
  player.subscribe(updateFavsCount);

  function applyFilter() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const favs = player.getProfile().favorites;
    let visibleCount = 0;

    cards.forEach(card => {
      const cat = card.getAttribute('data-game-category') || '';
      const title = card.getAttribute('data-game-title') || '';
      const slug = card.getAttribute('data-game-slug') || '';

      let matchCat = false;
      if (activeCategory === 'all') {
        matchCat = true;
      } else if (activeCategory === 'favorites') {
        matchCat = favs.includes(slug);
      } else {
        matchCat = cat === activeCategory;
      }

      const matchQuery = !query || title.includes(query) || cat.includes(query);

      if (matchCat && matchQuery) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.className = 'cat-filter-btn rounded-xl border border-brand-border bg-brand-card px-3 py-1.5 text-xs font-medium text-gray-300 transition-all hover:border-brand-neon hover:text-white';
      });
      btn.className = 'cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/15 px-3 py-1.5 text-xs font-semibold text-brand-neon transition-all';

      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilter();
    });
  });

  searchInput?.addEventListener('input', applyFilter);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'all';
    filterBtns.forEach(b => {
      if (b.getAttribute('data-category') === 'all') {
        b.className = 'cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/15 px-3 py-1.5 text-xs font-semibold text-brand-neon transition-all';
      } else {
        b.className = 'cat-filter-btn rounded-xl border border-brand-border bg-brand-card px-3 py-1.5 text-xs font-medium text-gray-300 transition-all hover:border-brand-neon hover:text-white';
      }
    });
    applyFilter();
  });

  // Hero Quick Triggers
  document.getElementById('hero-streak-pill')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  document.getElementById('hero-surprise-btn')?.addEventListener('click', () => {
    const gameSlugs = ['word-guess', 'fruit-merge', 'neon-2048', 'solitaire', 'cyber-snake', 'minesweeper', 'breakout'];
    const chosen = gameSlugs[Math.floor(Math.random() * gameSlugs.length)];
    window.location.href = `/games/${chosen}`;
  });

  document.getElementById('home-challenge-btn')?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-marketing-modal', {
        detail: {
          gameTitle: 'Pokoly Game Studio',
          gameSlug: 'fruit-merge',
          subdomain: 'suika',
          score: 500,
        }
      })
    );
  });
</script>
