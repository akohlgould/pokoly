---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { GAMES, CATEGORIES } from '../data/games';

const siteUrl = (Astro.site?.toString() || 'https://pokoly.com').replace(/\/$/, '');
const featuredGame = GAMES.find(g => g.id === 'fruit-merge') || GAMES[0];
const trendingGames = [
  GAMES.find(g => g.id === 'fruit-merge') || GAMES[0],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[1],
  GAMES.find(g => g.id === 'nanojoker') || GAMES[2],
  GAMES.find(g => g.id === 'word-guess') || GAMES[3],
  GAMES.find(g => g.id === 'chronotrail') || GAMES[4],
  GAMES.find(g => g.id === 'solitaire') || GAMES[5],
];

const portalSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pokoly - Free Browser Games & Arcade Portal',
  url: siteUrl,
  description: 'Play popular online games free with no download. Word puzzles, fruit merge physics drop, Solitaire, 2048, retro arcade, and minesweeper.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Pokoly.com - 100% Free Browser Games, Instant Play & Unblocked"
  description="Play 33+ free browser games with no download or login. Cosmic fruit merge, 5-letter word guess, Klondike solitaire, 2048 neon, peg dungeon, and retro arcade. Fast 60 FPS on any device."
  canonical={siteUrl}
  schema={portalSchema}
>
  <!-- Ambient Cosmic Lighting Backdrops -->
  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="absolute -top-40 left-1/4 h-[500px] w-[500px] rounded-full bg-cyan-500/15 blur-[140px]"></div>
    <div class="absolute top-[400px] -right-40 h-[600px] w-[600px] rounded-full bg-indigo-600/15 blur-[160px]"></div>
    <div class="absolute bottom-20 left-10 h-[500px] w-[500px] rounded-full bg-pink-500/15 blur-[140px]"></div>
  </div>

  <main class="relative z-10 mx-auto max-w-7xl px-4 py-6 sm:px-6 space-y-12">
    <!-- Hero Section: Modern High-Impact Arcade Arena -->
    <section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-[#121626]/90 via-[#0a0d18]/95 to-[#151226]/90 p-6 sm:p-10 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.7)] backdrop-blur-2xl">
      <!-- Ambient Glow Accents -->
      <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-neon/15 blur-[100px] pointer-events-none"></div>
      <div class="absolute -left-24 -bottom-24 h-96 w-96 rounded-full bg-brand-pink/15 blur-[100px] pointer-events-none"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7 space-y-6">
          <!-- Top Badge / Streak Pill -->
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 font-mono text-[11px] font-bold text-cyan-300 shadow-sm backdrop-blur-md">
              <span class="h-2 w-2 rounded-full bg-cyan-400 animate-ping"></span>
              <span>33+ INSTANT WEB GAMES</span>
            </span>

            <button
              id="hero-streak-pill"
              class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1 text-xs text-amber-300 shadow-sm hover:bg-amber-500/20 hover:border-amber-500/50 transition-all cursor-pointer backdrop-blur-md"
            >
              <span class="text-sm">🔥</span>
              <span class="font-bold">Daily Streak Active</span>
              <span class="text-gray-400 font-normal ml-0.5">• Claim XP →</span>
            </button>
          </div>

          <!-- Main Hero Title -->
          <div class="space-y-3">
            <h1 class="font-display text-4xl font-black tracking-tight text-white sm:text-6xl lg:leading-[1.1]">
              Play Instantly. <br />
              <span class="bg-gradient-to-r from-brand-neon via-indigo-400 to-brand-pink bg-clip-text text-transparent drop-shadow-sm">
                No Downloads. Pure Fun.
              </span>
            </h1>

            <p class="max-w-xl text-sm sm:text-base text-gray-300 leading-relaxed">
              Experience buttery-smooth 60 FPS physics drops, word deduction puzzles, card roguelikes, and retro arcade classics. Zero installs, zero logins, and zero lag on any phone, tablet, or laptop.
            </p>
          </div>

          <!-- Primary CTAs -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={`/games/${featuredGame.slug}`}
              class="group relative inline-flex items-center gap-2.5 overflow-hidden rounded-2xl bg-gradient-to-r from-cyan-500 via-indigo-600 to-pink-500 px-6 py-3.5 font-display text-sm font-black text-white shadow-[0_10px_30px_-5px_rgba(6,182,212,0.4)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_35px_-5px_rgba(6,182,212,0.6)] active:scale-95"
            >
              <span>🎮 Play Featured: {featuredGame.title.split(':')[0]}</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>

            <button
              id="hero-surprise-btn"
              class="inline-flex items-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-5 py-3.5 text-sm font-semibold text-gray-200 backdrop-blur-md transition-all hover:bg-white/10 hover:border-white/30 hover:text-white active:scale-95 cursor-pointer"
            >
              <span class="text-base">🎲</span>
              <span>Surprise Me</span>
            </button>

            <a
              href="#catalog"
              class="inline-flex items-center gap-1.5 rounded-2xl border border-transparent px-4 py-3.5 text-xs font-semibold text-gray-400 hover:text-cyan-400 transition-colors"
            >
              <span>Browse All Games</span>
              <span>↓</span>
            </a>
          </div>

          <!-- Proof Metrics Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-white/10 pt-5 text-xs text-gray-400">
            <div class="flex items-center gap-2">
              <span class="text-base">🕹️</span>
              <div>
                <div class="font-bold text-white font-mono">33 Games</div>
                <div class="text-[10px] text-gray-400">Original &amp; Unblocked</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-base">⚡</span>
              <div>
                <div class="font-bold text-emerald-400 font-mono">&lt; 15ms</div>
                <div class="text-[10px] text-gray-400">Edge Cold Start</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-base">👥</span>
              <div>
                <div class="font-bold text-white font-mono">21.5M+</div>
                <div class="text-[10px] text-gray-400">Monthly Plays</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-base">📱</span>
              <div>
                <div class="font-bold text-brand-neon font-mono">100% Free</div>
                <div class="text-[10px] text-gray-400">Any Device</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Featured Spotlight Card -->
        <div class="lg:col-span-5">
          <a
            href={`/games/${featuredGame.slug}`}
            class="group relative block overflow-hidden rounded-3xl border border-white/15 bg-gradient-to-br from-brand-card/90 via-[#0e1222]/95 to-brand-card/80 p-6 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:border-brand-neon/80 hover:shadow-[0_20px_50px_-10px_rgba(6,182,212,0.3)] hover:-translate-y-1.5"
          >
            <!-- Background Glow corresponding to game color -->
            <div
              class="absolute -right-20 -bottom-20 h-64 w-64 rounded-full opacity-30 blur-3xl pointer-events-none transition-opacity group-hover:opacity-60"
              style={`background: ${featuredGame.color};`}
            ></div>

            <div class="flex items-center justify-between text-xs">
              <span class="flex items-center gap-1.5 rounded-full bg-cyan-400/10 px-3 py-1 font-mono text-[10px] font-bold text-brand-neon border border-brand-neon/30">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-neon animate-ping"></span>
                <span>FEATURED SPOTLIGHT</span>
              </span>
              <span class="rounded-full bg-amber-500/20 px-2.5 py-0.5 text-[11px] font-bold text-amber-300 border border-amber-500/40">
                ⭐ {featuredGame.badge || 'Viral Hit'}
              </span>
            </div>

            <!-- Spotlight Graphic Presentation -->
            <div
              class="my-6 relative flex h-40 sm:h-48 w-full items-center justify-center rounded-2xl overflow-hidden shadow-inner border border-white/5"
              style={`background: radial-gradient(circle at center, ${featuredGame.color}25 0%, #0a0d18 80%);`}
            >
              <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none"></div>

              <img
                src={`/logos/${featuredGame.slug}.svg`}
                alt={featuredGame.title}
                class="relative z-10 h-32 w-32 sm:h-36 sm:w-36 object-contain drop-shadow-[0_15px_30px_rgba(0,0,0,0.8)] transition-transform duration-500 group-hover:scale-110 group-hover:rotate-1"
              />

              <div class="absolute bottom-3 right-3 rounded-xl bg-black/70 backdrop-blur-md px-2.5 py-1 text-[10px] font-mono font-bold text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
                <span>●</span>
                <span>60 FPS</span>
              </div>
            </div>

            <h3 class="font-display text-xl sm:text-2xl font-black text-white group-hover:text-brand-neon transition-colors">
              {featuredGame.title}
            </h3>
            <p class="mt-1.5 text-xs text-gray-300 line-clamp-2 leading-relaxed">
              {featuredGame.tagline}
            </p>

            <div class="mt-5 flex items-center justify-between border-t border-white/10 pt-4 text-xs">
              <div class="flex items-center gap-3 font-mono text-gray-400">
                <span class="text-amber-400 font-bold">★ {featuredGame.rating}</span>
                <span>👥 {featuredGame.playCount}</span>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-xl bg-brand-neon px-3.5 py-1.5 font-display text-xs font-black text-brand-dark shadow-md shadow-cyan-500/30 group-hover:bg-white group-hover:text-brand-dark transition-all">
                <span>Play Now</span>
                <span>🚀</span>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Top Trending Highlights Strip -->
    <section>
      <div class="flex items-center justify-between pb-4">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500/20 to-rose-500/20 border border-amber-500/30 text-lg">
            🔥
          </span>
          <div>
            <h2 class="font-display text-lg sm:text-xl font-black text-white">Top Trending Games</h2>
            <p class="text-xs text-gray-400">Most played titles in the arcade right now</p>
          </div>
        </div>
        <span class="hidden sm:inline-flex rounded-full bg-white/5 px-3 py-1 font-mono text-[11px] text-gray-300 border border-white/10">
          Instant 60 FPS
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
        {trendingGames.map(g => (
          <a
            href={`/games/${g.slug}`}
            class="group relative flex flex-col items-center rounded-2xl border border-white/10 bg-gradient-to-b from-[#131728]/80 to-[#0c0f1d]/90 p-3 text-center transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-neon/70 hover:shadow-[0_10px_25px_-5px_rgba(6,182,212,0.25)]"
          >
            <div
              class="relative flex h-24 w-full items-center justify-center rounded-xl overflow-hidden p-2 transition-transform duration-300 group-hover:scale-105"
              style={`background: radial-gradient(circle at center, ${g.color}22 0%, #0a0d18 80%);`}
            >
              <img
                src={`/logos/${g.slug}.svg`}
                alt={`${g.title} icon`}
                class="h-16 w-16 object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-115"
                loading="lazy"
              />
              <span class="absolute bottom-1 right-1 rounded-md bg-black/80 backdrop-blur-sm px-1.5 py-0.5 font-mono text-[8px] font-bold text-emerald-400 border border-emerald-500/30">
                PLAY
              </span>
            </div>
            <div class="mt-2.5 truncate w-full text-xs font-bold text-white group-hover:text-brand-neon transition-colors">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-gray-400 px-1">
              <span class="text-amber-400">★ {g.rating}</span>
              <span>{g.playCount}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Gamification & Viral Challenge Strip -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Daily Quests Strip -->
      <div class="relative overflow-hidden rounded-3xl border border-amber-500/30 bg-gradient-to-r from-amber-950/20 via-brand-card/80 to-[#121626] p-5 sm:p-6 backdrop-blur-xl flex items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-500/20 text-2xl border border-amber-500/30 shadow-inner">
            🔥
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-display text-sm sm:text-base font-bold text-white">Keep Your Play Streak Burning</h3>
              <span class="rounded bg-amber-500/20 px-1.5 py-0.5 text-[9px] font-mono text-amber-300 font-bold">+50 XP</span>
            </div>
            <p class="mt-0.5 text-xs text-gray-300">Play any game today to maintain your streak and unlock trophies.</p>
          </div>
        </div>
        <button
          id="btn-open-quests"
          class="shrink-0 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 px-3.5 py-2 text-xs font-bold text-amber-300 transition-all active:scale-95 cursor-pointer"
        >
          View Quests 🏆
        </button>
      </div>

      <!-- Friend Challenge Strip -->
      <div class="relative overflow-hidden rounded-3xl border border-indigo-500/30 bg-gradient-to-r from-indigo-950/20 via-brand-card/80 to-[#121626] p-5 sm:p-6 backdrop-blur-xl flex items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-500/20 text-2xl border border-indigo-500/30 shadow-inner">
            ⚔️
          </div>
          <div>
            <h3 class="font-display text-sm sm:text-base font-bold text-white">Challenge Friends &amp; Classmates</h3>
            <p class="mt-0.5 text-xs text-gray-300">Generate 1-click duel links with your score. Zero login required for them.</p>
          </div>
        </div>
        <button
          id="home-challenge-btn"
          class="shrink-0 rounded-xl bg-gradient-to-r from-indigo-600 to-brand-accent hover:opacity-90 px-3.5 py-2 text-xs font-bold text-white shadow-md shadow-indigo-500/30 transition-all active:scale-95 cursor-pointer"
        >
          Duel Link 🚀
        </button>
      </div>
    </section>

    <!-- Arcade Catalog Section -->
    <section id="catalog" class="pt-2">
      <!-- Catalog Filter Toolbar -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-white/10 pb-5">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="font-display text-2xl sm:text-3xl font-black text-white">
              Arcade Library
            </h2>
            <span id="catalog-count-badge" class="rounded-full bg-cyan-400/10 px-2.5 py-0.5 font-mono text-xs font-bold text-cyan-300 border border-cyan-400/30">
              {GAMES.length} Games
            </span>
          </div>
          <p class="mt-1 text-xs text-gray-400">
            Click any card to play in browser or open its standalone distraction-free subdomain.
          </p>
        </div>

        <!-- Real-Time Search Bar with Clear Button -->
        <div class="relative w-full sm:w-80">
          <input
            id="game-search-input"
            type="text"
            placeholder="Search games (press / to focus)..."
            class="w-full rounded-2xl border border-white/15 bg-white/5 backdrop-blur-md px-4 py-2.5 pl-10 pr-9 text-xs text-white placeholder-gray-400 focus:border-brand-neon focus:bg-[#121626] focus:outline-none focus:ring-1 focus:ring-brand-neon transition-all"
          />
          <span class="absolute left-3.5 top-3 text-xs text-gray-400 pointer-events-none">🔍</span>
          <button
            id="search-clear-btn"
            class="hidden absolute right-3 top-2.5 text-xs text-gray-400 hover:text-white px-1 py-0.5 rounded cursor-pointer"
            title="Clear search"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <button
          data-category="all"
          class="cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/20 px-3.5 py-1.5 text-xs font-bold text-brand-neon shadow-sm transition-all cursor-pointer"
        >
          🎮 All ({GAMES.length})
        </button>

        <button
          data-category="favorites"
          id="btn-filter-favs"
          class="cat-filter-btn rounded-xl border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-gray-300 transition-all hover:border-pink-500/60 hover:text-pink-300 cursor-pointer"
        >
          <span>❤️</span>
          <span class="ml-1">Favorites (<span id="favs-count">0</span>)</span>
        </button>

        {CATEGORIES.slice(1).map(cat => {
          const count = GAMES.filter(g => g.category === cat.id).length;
          return (
            <button
              data-category={cat.id}
              class="cat-filter-btn rounded-xl border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-gray-300 transition-all hover:border-brand-neon/60 hover:text-white cursor-pointer"
            >
              <span>{cat.icon}</span>
              <span class="ml-1">{cat.name} ({count})</span>
            </button>
          );
        })}
      </div>

      <!-- Games Grid -->
      <div id="games-grid" class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 items-stretch">
        {GAMES.map(game => (
          <div
            data-game-category={game.category}
            data-game-title={game.title.toLowerCase()}
            data-game-slug={game.slug}
            data-game-keywords={game.keywords.join(' ').toLowerCase()}
            class="game-item-card h-full flex flex-col"
          >
            <GameCard game={game} />
          </div>
        ))}
      </div>

      <!-- Empty Results State -->
      <div id="no-results-msg" class="hidden py-16 text-center text-gray-400">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white/5 text-3xl border border-white/10 mb-3">
          🔍
        </div>
        <p class="text-base font-bold text-white">No games match your search</p>
        <p class="mt-1 text-xs text-gray-400">Try searching for words, solitaire, 2048, or physics.</p>
        <button
          id="reset-search-btn"
          class="mt-4 rounded-xl bg-brand-neon/15 px-4 py-2 text-xs font-bold text-brand-neon border border-brand-neon/30 hover:bg-brand-neon hover:text-brand-dark transition-all cursor-pointer"
        >
          Clear filters
        </button>
      </div>
    </section>

    <!-- Subdomain Direct Access Directory (Arcade Cartridges) -->
    <section class="rounded-3xl border border-white/10 bg-gradient-to-br from-[#121626]/80 to-[#0a0d18]/90 p-6 sm:p-8 backdrop-blur-xl">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-cyan-400/10 px-3 py-1 font-mono text-[11px] font-bold text-brand-neon border border-brand-neon/30">
          🌐 Standalone Subdomains
        </div>
        <h2 class="mt-3 font-display text-2xl font-black text-white">
          Dedicated Game Subdomains
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-gray-300 leading-relaxed">
          Each game is also hosted as its own independent web app on its dedicated subdomain with zero arcade chrome. Bookmark your favorites or add them directly to your phone homescreen:
        </p>
      </div>

      <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5">
        {GAMES.map(game => (
          <a
            href={`/games/${game.slug}`}
            class="group flex flex-col justify-between rounded-xl border border-white/10 bg-white/5 p-2.5 text-xs transition-all hover:border-brand-neon/60 hover:bg-white/10 hover:shadow-md"
            title={`Launch ${game.title} (standalone at ${game.subdomain}.pokoly.com)`}
          >
            <div class="flex items-center gap-1.5 truncate">
              <span class="text-sm">🎮</span>
              <span class="font-bold text-white group-hover:text-brand-neon transition-colors truncate">
                {game.title.split(':')[0]}
              </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between font-mono text-[10px] text-gray-400 group-hover:text-brand-neon">
              <span class="truncate">{game.subdomain}.pokoly.com</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Why Millions Play at Pokoly: High Performance & Trust -->
    <section class="border-t border-white/10 pt-10 text-xs text-gray-400 space-y-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-xl sm:text-2xl font-black text-white">
          Why Players Choose Pokoly Arcade
        </h2>
        <p class="mt-1 text-xs text-gray-300">
          Built from the ground up for frictionless, instant fun. Every game is written with pure HTML5 Canvas and WebGL for unmatched speed and battery efficiency.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">⚡</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Sub-15ms Load Times</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">Static compilation means zero backend delays, low battery drain, and instant startup on any connection.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">🔒</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">No Downloads or Logins</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">No forced registration, no app store downloads, and zero spam. Jump straight into the gameplay in 1 click.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">📱</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Full Touch &amp; Mobile Support</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">Designed natively for touchscreens and keyboards alike. Smooth 60 FPS on iPhones, iPads, Android, and laptops.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">🏆</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Daily Streaks &amp; Duels</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">Level up your player profile, collect trophies, and generate instant challenge links to duel friends.</p>
        </div>
      </div>
    </section>

    <!-- AdSlot (Only renders when ads enabled) -->
    <AdSlot slot="footer-banner" />
  </main>
</BaseLayout>

<script>
  import { player } from '../utils/player';
  import { GAMES } from '../data/games';

  const searchInput = document.getElementById('game-search-input') as HTMLInputElement;
  const searchClearBtn = document.getElementById('search-clear-btn');
  const filterBtns = document.querySelectorAll('.cat-filter-btn');
  const cards = document.querySelectorAll('.game-item-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results-msg')!;
  const resetBtn = document.getElementById('reset-search-btn');
  const favsCountEl = document.getElementById('favs-count');
  const catalogCountBadge = document.getElementById('catalog-count-badge');

  let activeCategory = 'all';

  function updateFavsCount() {
    if (favsCountEl) {
      favsCountEl.textContent = player.getProfile().favorites.length.toString();
    }
  }
  updateFavsCount();
  player.subscribe(updateFavsCount);

  function applyFilter() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    if (searchClearBtn) {
      if (query.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }

    const favs = player.getProfile().favorites;
    let visibleCount = 0;

    cards.forEach(card => {
      const cat = card.getAttribute('data-game-category') || '';
      const title = card.getAttribute('data-game-title') || '';
      const slug = card.getAttribute('data-game-slug') || '';
      const keywords = card.getAttribute('data-game-keywords') || '';

      let matchCat = false;
      if (activeCategory === 'all') {
        matchCat = true;
      } else if (activeCategory === 'favorites') {
        matchCat = favs.includes(slug);
      } else {
        matchCat = cat === activeCategory;
      }

      const matchQuery = !query || title.includes(query) || cat.includes(query) || keywords.includes(query);

      if (matchCat && matchQuery) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (catalogCountBadge) {
      catalogCountBadge.textContent = `${visibleCount} Game${visibleCount === 1 ? '' : 's'}`;
    }

    if (visibleCount === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  // Active / inactive button styles
  const activeClass = 'cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/20 px-3.5 py-1.5 text-xs font-bold text-brand-neon shadow-sm transition-all cursor-pointer';
  const inactiveClass = 'cat-filter-btn rounded-xl border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-gray-300 transition-all hover:border-brand-neon/60 hover:text-white cursor-pointer';

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.className = inactiveClass;
      });
      btn.className = activeClass;

      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilter();
    });
  });

  searchInput?.addEventListener('input', applyFilter);

  // Keyboard shortcut '/' to focus search
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    applyFilter();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'all';
    filterBtns.forEach(b => {
      if (b.getAttribute('data-category') === 'all') {
        b.className = activeClass;
      } else {
        b.className = inactiveClass;
      }
    });
    applyFilter();
  });

  // Hero Quick Triggers
  document.getElementById('hero-streak-pill')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  document.getElementById('btn-open-quests')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-quests-modal'));
  });

  document.getElementById('hero-surprise-btn')?.addEventListener('click', () => {
    const chosen = GAMES[Math.floor(Math.random() * GAMES.length)];
    if (chosen) {
      window.location.href = `/games/${chosen.slug}`;
    }
  });

  document.getElementById('home-challenge-btn')?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-marketing-modal', {
        detail: {
          gameTitle: 'Pokoly Game Studio',
          gameSlug: 'fruit-merge',
          subdomain: 'fruits',
          score: 500,
        }
      })
    );
  });
</script>
