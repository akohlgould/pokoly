---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { GAMES, CATEGORIES } from '../data/games';

const siteUrl = (Astro.site?.toString() || 'https://pokoly.com').replace(/\/$/, '');

// Featured Marquee Game
const featuredGame = GAMES.find(g => g.id === 'fruit-merge') || GAMES[0];

// Secondary Marquee Highlights
const secondarySpotlights = [
  GAMES.find(g => g.id === 'cymatica') || GAMES[1],
  GAMES.find(g => g.id === 'word-guess') || GAMES[2],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[3],
];

// Trending Hits
const trendingGames = [
  GAMES.find(g => g.id === 'fruit-merge') || GAMES[0],
  GAMES.find(g => g.id === 'cymatica') || GAMES[1],
  GAMES.find(g => g.id === 'word-guess') || GAMES[2],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[3],
  GAMES.find(g => g.id === 'chronotrail') || GAMES[4],
  GAMES.find(g => g.id === 'nanojoker') || GAMES[5],
];

// Curated Brain & Word Shelf
const brainPicks = [
  GAMES.find(g => g.id === 'word-guess') || GAMES[0],
  GAMES.find(g => g.id === 'synapse') || GAMES[1],
  GAMES.find(g => g.id === 'lexifall') || GAMES[2],
  GAMES.find(g => g.id === 'sudoku') || GAMES[3],
  GAMES.find(g => g.id === 'cipherpunk') || GAMES[4],
  GAMES.find(g => g.id === 'neon-2048') || GAMES[5],
];

// Curated Physics & Action Shelf
const physicsPicks = [
  GAMES.find(g => g.id === 'fruit-merge') || GAMES[0],
  GAMES.find(g => g.id === 'pegdungeon') || GAMES[1],
  GAMES.find(g => g.id === 'gravifold') || GAMES[2],
  GAMES.find(g => g.id === 'bouncygolf') || GAMES[3],
  GAMES.find(g => g.id === 'breakout-sandbox') || GAMES[4],
  GAMES.find(g => g.id === 'jellydrop') || GAMES[5],
];

const categoryCounts = {
  puzzle: GAMES.filter(g => g.category === 'puzzle').length,
  arcade: GAMES.filter(g => g.category === 'arcade').length,
  physics: GAMES.filter(g => g.category === 'physics').length,
  word: GAMES.filter(g => g.category === 'word').length,
  card: GAMES.filter(g => g.category === 'card').length,
};

const portalSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pokoly - Free Browser Games & Arcade Portal',
    url: `${siteUrl}/`,
    description: `Play ${GAMES.length}+ free browser games with no downloads or logins. Word puzzles, physics drops, Solitaire, retro arcade, and minesweeper.`,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteUrl}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Pokoly',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/logos/pokoly-icon.svg`
  }
];
---

<BaseLayout
  title="Pokoly - Free Browser Games, Instant Play & Unblocked"
  description={`Play ${GAMES.length}+ free browser games with no download or login. Cosmic fruit merge, Cymatica acoustic resonance, word puzzles, Klondike solitaire, and arcade classics. Fast 60 FPS on any device.`}
  canonical={`${siteUrl}/`}
  schema={portalSchema}
>
  <!-- Ambient Atmospheric Backdrop -->
  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 h-[520px] w-full max-w-7xl bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(99,102,241,0.14),transparent_75%)]"></div>
  </div>

  <main class="relative z-10 mx-auto max-w-7xl px-4 py-6 sm:px-6 space-y-12">
    <!-- Hero Section -->
    <section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-[#121626]/80 via-[#0e1220]/90 to-[#0a0d18]/95 p-6 sm:p-10 shadow-2xl backdrop-blur-md">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <!-- Hero Left Column -->
        <div class="lg:col-span-7 space-y-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 font-mono text-xs text-emerald-300">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              <span>{GAMES.length} Instant Web Games</span>
            </span>

            <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs text-gray-300">
              <span>⚡ 60 FPS • Zero Installs</span>
            </span>
          </div>

          <h1 class="font-display text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-[1.08]">
            Play Instantly. <br />
            <span class="bg-gradient-to-r from-brand-neon via-indigo-400 to-brand-pink bg-clip-text text-transparent">
              Pure Gameplay in Browser.
            </span>
          </h1>

          <p class="max-w-xl text-sm sm:text-base text-gray-300 leading-relaxed">
            Physics drops, acoustic puzzles, word deductions, and fast retro arcades built with pure HTML5 Canvas and WebGL. Play at 60 FPS on any phone, tablet, or laptop.
          </p>

          <!-- Primary Hero Actions -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href={`/games/${featuredGame.slug}/`}
              class="group inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-500 via-indigo-600 to-pink-500 px-6 py-3.5 font-display text-sm font-bold text-white shadow-lg shadow-indigo-500/25 transition-all hover:scale-105 active:scale-95"
            >
              <span>🎮 Play Featured: {featuredGame.title.split(':')[0]}</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>

            <button
              id="hero-surprise-btn"
              class="inline-flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-4 py-3.5 text-sm font-semibold text-gray-200 transition-all hover:bg-white/10 hover:border-white/20 hover:text-white active:scale-95 cursor-pointer"
            >
              <span>🎲</span>
              <span>Surprise Me</span>
            </button>

            <button
              id="hero-search-jump-btn"
              class="inline-flex items-center gap-1.5 rounded-2xl border border-white/5 bg-white/5 px-4 py-3.5 text-xs font-semibold text-gray-400 hover:text-brand-neon hover:border-brand-neon/40 transition-all cursor-pointer"
            >
              <span>🔍</span>
              <span>Search Library</span>
              <kbd class="ml-1 rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-gray-300">/</kbd>
            </button>
          </div>

          <!-- Feature Highlights Bar -->
          <div class="grid grid-cols-3 gap-3 border-t border-white/10 pt-4 text-xs text-gray-400">
            <div>
              <span class="font-mono font-bold text-white text-sm">{GAMES.length} Games</span>
              <div class="text-[11px] text-gray-400">Original &amp; Unblocked</div>
            </div>
            <div>
              <span class="font-mono font-bold text-emerald-400 text-sm">60 FPS</span>
              <div class="text-[11px] text-gray-400">Hardware Accelerated</div>
            </div>
            <div>
              <span class="font-mono font-bold text-brand-neon text-sm">100% Free</span>
              <div class="text-[11px] text-gray-400">All Devices</div>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: Curated Marquee Spotlight -->
        <div class="lg:col-span-5">
          <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-[#151928] to-[#0c0f1b] p-5 shadow-2xl">
            <div class="flex items-center justify-between text-xs pb-3 border-b border-white/10">
              <span class="font-mono font-bold text-brand-neon text-[11px] uppercase tracking-wider flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-neon"></span>
                Featured Spotlight
              </span>
              <span class="text-amber-400 font-semibold text-xs">
                ★ {featuredGame.rating}
              </span>
            </div>

            <!-- Spotlight Visual Presentation -->
            <a
              href={`/games/${featuredGame.slug}/`}
              class="group block relative my-4 flex h-44 w-full items-center justify-center rounded-2xl overflow-hidden p-4 transition-transform hover:scale-[1.01]"
              style={`background: radial-gradient(circle at center, ${featuredGame.color}22 0%, #0a0d18 80%);`}
            >
              <img
                src={`/logos/${featuredGame.slug}.svg`}
                alt={featuredGame.title}
                class="relative z-10 h-32 w-32 object-contain drop-shadow-xl transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute bottom-3 right-3 rounded-xl bg-black/70 backdrop-blur-md px-2.5 py-1 text-[10px] font-mono font-semibold text-emerald-400 border border-emerald-500/30">
                60 FPS
              </div>
            </a>

            <div>
              <a href={`/games/${featuredGame.slug}/`} class="group inline-block">
                <h2 class="font-display text-xl font-black text-white group-hover:text-brand-neon transition-colors">
                  {featuredGame.title}
                </h2>
              </a>
              <p class="mt-1 text-xs text-gray-400 line-clamp-2">
                {featuredGame.tagline}
              </p>
            </div>

            <!-- Also Trending Companion Mini Row -->
            <div class="mt-4 pt-3 border-t border-white/10">
              <div class="text-[10px] font-mono uppercase tracking-wider text-gray-400 mb-2">Also Trending:</div>
              <div class="grid grid-cols-3 gap-2">
                {secondarySpotlights.map(sec => (
                  <a
                    href={`/games/${sec.slug}/`}
                    class="group flex items-center gap-2 rounded-xl border border-white/5 bg-white/5 p-2 transition-all hover:bg-white/10 hover:border-brand-neon/40"
                  >
                    <img
                      src={`/logos/${sec.slug}.svg`}
                      alt={sec.title}
                      class="h-8 w-8 object-contain shrink-0 group-hover:scale-105 transition-transform"
                      loading="lazy"
                    />
                    <div class="truncate text-[11px] font-medium text-gray-200 group-hover:text-white">
                      {sec.title.split(':')[0]}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Quick Navigation Bar -->
    <section>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <button
          data-jump-cat="puzzle"
          class="cat-nav-tile group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-3.5 text-left transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-0.5 cursor-pointer"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-500/20 text-xl border border-purple-500/30">
            🧩
          </span>
          <div>
            <div class="text-xs font-bold text-white group-hover:text-brand-neon transition-colors">Puzzle &amp; Logic</div>
            <div class="text-[11px] font-mono text-gray-400">{categoryCounts.puzzle} games</div>
          </div>
        </button>

        <button
          data-jump-cat="arcade"
          class="cat-nav-tile group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-3.5 text-left transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-0.5 cursor-pointer"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/20 text-xl border border-amber-500/30">
            💥
          </span>
          <div>
            <div class="text-xs font-bold text-white group-hover:text-brand-neon transition-colors">Retro Arcade</div>
            <div class="text-[11px] font-mono text-gray-400">{categoryCounts.arcade} games</div>
          </div>
        </button>

        <button
          data-jump-cat="physics"
          class="cat-nav-tile group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-3.5 text-left transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-0.5 cursor-pointer"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-500/20 text-xl border border-cyan-500/30">
            ⚛️
          </span>
          <div>
            <div class="text-xs font-bold text-white group-hover:text-brand-neon transition-colors">Physics Sandbox</div>
            <div class="text-[11px] font-mono text-gray-400">{categoryCounts.physics} games</div>
          </div>
        </button>

        <button
          data-jump-cat="word"
          class="cat-nav-tile group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-3.5 text-left transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-0.5 cursor-pointer"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/20 text-xl border border-emerald-500/30">
            🔤
          </span>
          <div>
            <div class="text-xs font-bold text-white group-hover:text-brand-neon transition-colors">Word &amp; Brain</div>
            <div class="text-[11px] font-mono text-gray-400">{categoryCounts.word} games</div>
          </div>
        </button>

        <button
          data-jump-cat="card"
          class="cat-nav-tile col-span-2 sm:col-span-1 group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-3.5 text-left transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-0.5 cursor-pointer"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-500/20 text-xl border border-rose-500/30">
            🃏
          </span>
          <div>
            <div class="text-xs font-bold text-white group-hover:text-brand-neon transition-colors">Card Roguelikes</div>
            <div class="text-[11px] font-mono text-gray-400">{categoryCounts.card} games</div>
          </div>
        </button>
      </div>
    </section>

    <!-- Curated Shelf 1: Trending Now -->
    <section>
      <div class="flex items-center justify-between pb-3.5">
        <div class="flex items-center gap-2">
          <span class="text-lg">🔥</span>
          <h2 class="font-display text-lg sm:text-xl font-bold text-white">Top Trending Games</h2>
        </div>
        <a href="#catalog" class="text-xs text-gray-400 hover:text-brand-neon transition-colors font-medium">
          View All ({GAMES.length}) →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {trendingGames.map(g => (
          <a
            href={`/games/${g.slug}/`}
            class="group flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-3 text-center transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-1 hover:shadow-lg"
          >
            <div
              class="flex h-20 w-full items-center justify-center rounded-xl p-2 transition-transform duration-300 group-hover:scale-105"
              style={`background: radial-gradient(circle at center, ${g.color}18 0%, #0d111d 85%);`}
            >
              <img
                src={`/logos/${g.slug}.svg`}
                alt={g.title}
                class="h-14 w-14 object-contain drop-shadow transition-transform duration-300 group-hover:scale-110"
                loading="lazy"
              />
            </div>
            <div class="mt-2 truncate w-full text-xs font-bold text-white group-hover:text-brand-neon transition-colors">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-gray-400 px-1">
              <span class="text-amber-400">★ {g.rating}</span>
              <span class="capitalize text-gray-400">{g.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Curated Shelf 2: Brain & Word Puzzles -->
    <section>
      <div class="flex items-center justify-between pb-3.5">
        <div class="flex items-center gap-2">
          <span class="text-lg">🧠</span>
          <h2 class="font-display text-lg sm:text-xl font-bold text-white">Mind &amp; Deduction Puzzles</h2>
        </div>
        <button data-jump-cat="word" class="cat-nav-link text-xs text-gray-400 hover:text-brand-neon transition-colors font-medium cursor-pointer">
          More Word Games →
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {brainPicks.map(g => (
          <a
            href={`/games/${g.slug}/`}
            class="group flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-3 text-center transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-1 hover:shadow-lg"
          >
            <div
              class="flex h-20 w-full items-center justify-center rounded-xl p-2 transition-transform duration-300 group-hover:scale-105"
              style={`background: radial-gradient(circle at center, ${g.color}18 0%, #0d111d 85%);`}
            >
              <img
                src={`/logos/${g.slug}.svg`}
                alt={g.title}
                class="h-14 w-14 object-contain drop-shadow transition-transform duration-300 group-hover:scale-110"
                loading="lazy"
              />
            </div>
            <div class="mt-2 truncate w-full text-xs font-bold text-white group-hover:text-brand-neon transition-colors">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-gray-400 px-1">
              <span class="text-amber-400">★ {g.rating}</span>
              <span class="capitalize text-gray-400">{g.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Curated Shelf 3: Physics & Sandbox Classics -->
    <section>
      <div class="flex items-center justify-between pb-3.5">
        <div class="flex items-center gap-2">
          <span class="text-lg">⚛️</span>
          <h2 class="font-display text-lg sm:text-xl font-bold text-white">Physics &amp; Kinetic Drops</h2>
        </div>
        <button data-jump-cat="physics" class="cat-nav-link text-xs text-gray-400 hover:text-brand-neon transition-colors font-medium cursor-pointer">
          More Physics Games →
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {physicsPicks.map(g => (
          <a
            href={`/games/${g.slug}/`}
            class="group flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-3 text-center transition-all hover:bg-white/10 hover:border-brand-neon/60 hover:-translate-y-1 hover:shadow-lg"
          >
            <div
              class="flex h-20 w-full items-center justify-center rounded-xl p-2 transition-transform duration-300 group-hover:scale-105"
              style={`background: radial-gradient(circle at center, ${g.color}18 0%, #0d111d 85%);`}
            >
              <img
                src={`/logos/${g.slug}.svg`}
                alt={g.title}
                class="h-14 w-14 object-contain drop-shadow transition-transform duration-300 group-hover:scale-110"
                loading="lazy"
              />
            </div>
            <div class="mt-2 truncate w-full text-xs font-bold text-white group-hover:text-brand-neon transition-colors">
              {g.title.split(':')[0]}
            </div>
            <div class="mt-1 flex items-center justify-between w-full font-mono text-[10px] text-gray-400 px-1">
              <span class="text-amber-400">★ {g.rating}</span>
              <span class="capitalize text-gray-400">{g.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Main Arcade Library & Complete Catalog Section -->
    <section id="catalog" class="pt-4 border-t border-white/10">
      <!-- Toolbar: Title, Count & Instant Search -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-white/10 pb-4">
        <div>
          <div class="flex items-center gap-2.5">
            <h2 class="font-display text-2xl sm:text-3xl font-black text-white">
              All Arcade Games
            </h2>
            <span id="catalog-count-badge" class="rounded-full bg-white/10 px-2.5 py-0.5 font-mono text-xs font-bold text-gray-200 border border-white/10">
              {GAMES.length} Games
            </span>
          </div>
          <p class="mt-1 text-xs text-gray-400">
            Search by title, genre, or keywords. Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-[10px] font-mono text-gray-300 border border-white/10">/</kbd> to search anytime.
          </p>
        </div>

        <!-- Search Bar with Clear Button -->
        <div class="relative w-full sm:w-80">
          <input
            id="game-search-input"
            type="text"
            placeholder="Search all 82 games..."
            class="w-full rounded-2xl border border-white/15 bg-white/5 backdrop-blur-md px-4 py-2.5 pl-10 pr-9 text-xs text-white placeholder-gray-400 focus:border-brand-neon focus:bg-[#121626] focus:outline-none focus:ring-1 focus:ring-brand-neon transition-all"
          />
          <span class="absolute left-3.5 top-3 text-xs text-gray-400 pointer-events-none">🔍</span>
          <button
            id="search-clear-btn"
            class="hidden absolute right-3 top-2.5 text-xs text-gray-400 hover:text-white px-1 py-0.5 rounded cursor-pointer"
            title="Clear search"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          data-category="all"
          class="cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/15 px-3.5 py-1.5 text-xs font-bold text-brand-neon transition-all cursor-pointer"
        >
          🎮 All ({GAMES.length})
        </button>

        <button
          data-category="favorites"
          id="btn-filter-favs"
          class="cat-filter-btn rounded-xl border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-gray-300 transition-all hover:border-pink-500/60 hover:text-pink-300 cursor-pointer"
        >
          <span>❤️</span>
          <span class="ml-1">Favorites (<span id="favs-count">0</span>)</span>
        </button>

        {CATEGORIES.slice(1).map(cat => {
          const count = GAMES.filter(g => g.category === cat.id).length;
          return (
            <button
              data-category={cat.id}
              class="cat-filter-btn rounded-xl border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-gray-300 transition-all hover:border-brand-neon/60 hover:text-white cursor-pointer"
            >
              <span>{cat.icon}</span>
              <span class="ml-1">{cat.name} ({count})</span>
            </button>
          );
        })}
      </div>

      <!-- Games Grid -->
      <div id="games-grid" class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 items-stretch">
        {GAMES.map(game => (
          <div
            data-game-category={game.category}
            data-game-title={game.title.toLowerCase()}
            data-game-slug={game.slug}
            data-game-keywords={game.keywords.join(' ').toLowerCase()}
            class="game-item-card h-full flex flex-col"
          >
            <GameCard game={game} />
          </div>
        ))}
      </div>

      <!-- Empty Results State -->
      <div id="no-results-msg" class="hidden py-16 text-center text-gray-400">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white/5 text-3xl border border-white/10 mb-3">
          🔍
        </div>
        <p class="text-base font-bold text-white">No games match your search</p>
        <p class="mt-1 text-xs text-gray-400">Try searching for word, physics, 2048, or card.</p>
        <button
          id="reset-search-btn"
          class="mt-4 rounded-xl bg-brand-neon/15 px-4 py-2 text-xs font-bold text-brand-neon border border-brand-neon/30 hover:bg-brand-neon hover:text-brand-dark transition-all cursor-pointer"
        >
          Clear filters
        </button>
      </div>
    </section>

    <!-- Distraction-Free Subdomains Callout -->
    <section class="rounded-3xl border border-white/10 bg-gradient-to-r from-[#121626]/60 via-[#0e1220]/80 to-[#121626]/60 p-6 sm:p-8 backdrop-blur-md">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="max-w-2xl space-y-2">
          <div class="inline-flex items-center gap-1.5 rounded-full bg-cyan-400/10 px-3 py-1 font-mono text-[11px] font-bold text-brand-neon border border-brand-neon/30">
            <span>🌐</span>
            <span>Distraction-Free Direct Links</span>
          </div>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-white">
            Prefer Independent Standalone Web Apps?
          </h2>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            Every game is also accessible on its own dedicated subdomain with zero arcade navigation. Bookmark them directly on your phone or desktop for an app-like fullscreen experience.
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-3">
          <a
            href="/unblocked/"
            class="inline-flex items-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-5 py-3 text-xs font-bold text-white hover:bg-white/10 hover:border-brand-neon/50 transition-all"
          >
            <span>View Unblocked Directory</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Why Pokoly Arcade -->
    <section class="border-t border-white/10 pt-10 text-xs text-gray-400 space-y-6">
      <div class="max-w-2xl">
        <h2 class="font-display text-xl sm:text-2xl font-black text-white">
          Why Players Choose Pokoly
        </h2>
        <p class="mt-1 text-xs text-gray-300">
          Built from the ground up for frictionless instant play. Pure HTML5 Canvas and WebGL for speed, battery efficiency, and zero bloat.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">⚡</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Sub-15ms Startup</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">Static compilation means zero backend delays, low battery consumption, and instant play on any network.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">🔒</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Zero Logins or Downloads</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">No forced registration, no app store downloads, and no trackers. Jump straight into the action with 1 click.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">📱</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Touch &amp; Mobile Ready</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">Built natively for touchscreens, trackpads, and keyboards. Smooth 60 FPS on iPhones, iPads, and Android devices.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md">
          <div class="text-2xl">💾</div>
          <h3 class="mt-2 font-display text-sm font-bold text-white">Local Privacy &amp; Saves</h3>
          <p class="mt-1 text-gray-400 leading-relaxed">Your high scores, streak records, and favorite games stay safely stored in your browser's local storage.</p>
        </div>
      </div>
    </section>

    <!-- AdSlot (Only renders when ads enabled) -->
    <AdSlot slot="footer-banner" />
  </main>
</BaseLayout>

<script>
  import { player } from '../utils/player';
  import { GAMES } from '../data/games';

  const searchInput = document.getElementById('game-search-input') as HTMLInputElement;
  const searchClearBtn = document.getElementById('search-clear-btn');
  const filterBtns = document.querySelectorAll('.cat-filter-btn');
  const cards = document.querySelectorAll('.game-item-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results-msg')!;
  const resetBtn = document.getElementById('reset-search-btn');
  const favsCountEl = document.getElementById('favs-count');
  const catalogCountBadge = document.getElementById('catalog-count-badge');
  const jumpSearchBtn = document.getElementById('hero-search-jump-btn');

  let activeCategory = 'all';

  function updateFavsCount() {
    if (favsCountEl) {
      favsCountEl.textContent = player.getProfile().favorites.length.toString();
    }
  }
  updateFavsCount();
  player.subscribe(updateFavsCount);

  function applyFilter() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    if (searchClearBtn) {
      if (query.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }

    const favs = player.getProfile().favorites;
    let visibleCount = 0;

    cards.forEach(card => {
      const cat = card.getAttribute('data-game-category') || '';
      const title = card.getAttribute('data-game-title') || '';
      const slug = card.getAttribute('data-game-slug') || '';
      const keywords = card.getAttribute('data-game-keywords') || '';

      let matchCat = false;
      if (activeCategory === 'all') {
        matchCat = true;
      } else if (activeCategory === 'favorites') {
        matchCat = favs.includes(slug);
      } else {
        matchCat = cat === activeCategory;
      }

      const matchQuery = !query || title.includes(query) || cat.includes(query) || keywords.includes(query);

      if (matchCat && matchQuery) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (catalogCountBadge) {
      catalogCountBadge.textContent = `${visibleCount} Game${visibleCount === 1 ? '' : 's'}`;
    }

    if (visibleCount === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  // Active / inactive button styles
  const activeClass = 'cat-filter-btn rounded-xl border border-brand-neon bg-brand-neon/15 px-3.5 py-1.5 text-xs font-bold text-brand-neon shadow-sm transition-all cursor-pointer';
  const inactiveClass = 'cat-filter-btn rounded-xl border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-gray-300 transition-all hover:border-brand-neon/60 hover:text-white cursor-pointer';

  function selectCategory(cat: string) {
    activeCategory = cat;
    filterBtns.forEach(b => {
      if (b.getAttribute('data-category') === cat) {
        b.className = activeClass;
      } else {
        b.className = inactiveClass;
      }
    });
    applyFilter();
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category') || 'all';
      selectCategory(cat);
    });
  });

  // Top category navigation tiles & links
  document.querySelectorAll('[data-jump-cat]').forEach(tile => {
    tile.addEventListener('click', () => {
      const cat = tile.getAttribute('data-jump-cat');
      if (cat) {
        selectCategory(cat);
        const catalogEl = document.getElementById('catalog');
        catalogEl?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  searchInput?.addEventListener('input', applyFilter);

  function focusSearch() {
    const catalogEl = document.getElementById('catalog');
    catalogEl?.scrollIntoView({ behavior: 'smooth' });
    setTimeout(() => {
      searchInput?.focus();
    }, 300);
  }

  jumpSearchBtn?.addEventListener('click', focusSearch);

  // Keyboard shortcut '/' to focus search
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      focusSearch();
    }
  });

  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    applyFilter();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    selectCategory('all');
  });

  // Hero Surprise trigger
  document.getElementById('hero-surprise-btn')?.addEventListener('click', () => {
    const chosen = GAMES[Math.floor(Math.random() * GAMES.length)];
    if (chosen) {
      window.location.href = `/games/${chosen.slug}/`;
    }
  });
</script>
