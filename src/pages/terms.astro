---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service - Pokoly.com"
  description="Terms and conditions for playing browser games on Pokoly.com."
>
  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 text-gray-300 leading-relaxed text-sm space-y-6">
    <h1 class="font-display text-3xl font-black text-white">Terms of Service</h1>
    <p class="text-xs text-gray-400 font-mono">Last Updated: January 1, 2026</p>

    <div class="space-y-4">
      <h2 class="text-lg font-bold text-white">1. Use of Services</h2>
      <p>
        By accessing Pokoly.com, you agree to access our browser games for personal, non-commercial entertainment. You agree not to attempt to reverse engineer, disrupt server integrity, or scrape content maliciously.
      </p>

      <h2 class="text-lg font-bold text-white">2. Free Access & Availability</h2>
      <p>
        All games are provided "as-is" free of charge. We strive for 99.99% uptime via global edge CDNs, but do not guarantee uninterrupted availability.
      </p>

      <h2 class="text-lg font-bold text-white">3. Intellectual Property</h2>
      <p>
        The game designs, visual assets, procedural audio engines, and layout styling are proprietary to Pokoly Studio.
      </p>
    </div>
  </main>
</BaseLayout>
